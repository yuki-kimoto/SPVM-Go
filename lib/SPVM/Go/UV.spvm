class Go::UV {
  version_from Go;
  
  allow Go::Schedule;
  allow Go::Channel;
  
  # Fields
  has schedule : Go::Schedule;
  
  has timer_wait_goroutines_h : Hash of Go::Goroutine;
  
  has io_wait_goroutines_h : Hash of Go::Goroutine;
  
  has channel_read_waits_length : int;
  
  has channel_write_waits_length : int;
  
  # Class Methods
  static method new : Go::UV () {
    
    my $self = new Go::UV;
    
    $self->{timer_wait_goroutines_h} = Hash->new;
    
    $self->{io_wait_goroutines_h} = Hash->new;
    
    return $self;
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{schedule}{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{timer_wait_goroutines_h}->keys_length
      + $self->{io_wait_goroutines_h}->keys_length;
      + $self->{channel_read_waits_length}
      + $self->{channel_write_waits_length};
      
    return $all_goroutines_length ? 1 : 0;
  }
}
