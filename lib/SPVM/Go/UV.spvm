class Go::UV {
  version_from Go;
  
  use Go::UV::Loop;
  
  our $DEFAULT_LOOP : Go::UV::Loop;
  INIT {
    $DEFAULT_LOOP = Go::UV::Loop->default_loop;
    $DEFAULT_LOOP->init;
  }
  
  # Class Methods
  static method default_loop : Go::UV::Loop () {
    
    return $DEFAULT_LOOP;
  }
  
  static method strerror : string ($status : int) {
    
    my $uv_strerro = Go::UV::Loop->strerror($status);
    
    return $uv_strerro;
  }
  
}
