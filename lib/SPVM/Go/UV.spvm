class Go::UV {
  version_from Go;
  
  allow Go::Schedule;
  allow Go::Channel;
  
  use Sys::Poll::PollfdArray;
  use Sys::Poll::Constant as POLL;
  use Sys::Poll;
  
  # Fields
  has schedule : Go::Schedule;
  
  has disabled_goroutines_h : Hash of Go::Goroutine;
  
  # Class Methods
  static method new : Go::UV () {
    
    my $self = new Go::UV;
    
    $self->{disabled_goroutines_h} = Hash->new;
    
    return $self;
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{schedule}{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{disabled_goroutines_h}->keys_length;
      
    return $all_goroutines_length ? 1 : 0;
  }
  
  private method check_timer : void () {
    
    my $schedule = $self->{schedule};
    
    my $disabled_goroutines_h = $self->{disabled_goroutines_h};
    
    my $addreses = $disabled_goroutines_h->keys;
    for my $address (@$addreses) {
      my $goroutine = $disabled_goroutines_h->{$address};
      unless ($goroutine->{schedule_type} == Go::Schedule->TYPE_SLEEP) {
        next;
      }
      
      my $deadline = $goroutine->{deadline};
      
      if ($deadline) {
        my $is_over_deadline = 1;
        
        if ($deadline) {
          $is_over_deadline = Go::Time->now->after($deadline);
        }
        
        if ($is_over_deadline) {
          $self->enable_goroutine($goroutine);
        }
      }
    }
  }
  
  private method check_io : void () {
    
    my $schedule = $self->{schedule};
    
    my $disabled_goroutines_h = $self->{disabled_goroutines_h};
    
    my $addreses = $disabled_goroutines_h->keys;
    for my $address (@$addreses) {
      
      my $goroutine = (Go::Goroutine)$disabled_goroutines_h->get($address);
      
      unless ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_READ || $goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
        next;
      }
      
      my $poll_index = 0;
      
      my $poll_fd_array = Sys::Poll::PollfdArray->new(1);
      
      my $fd = $goroutine->{fd};
      
      $poll_fd_array->set_fd($poll_index, $fd);
      
      my $schedule_type = $goroutine->{schedule_type};
      
      if ($schedule_type == Go::Schedule->TYPE_IO_WRITE) {
        $poll_fd_array->set_events($poll_index, POLL->POLLOUT);
      }
      else {
        $poll_fd_array->set_events($poll_index, POLL->POLLIN);
      }
      
      $goroutine->{poll_index} = $poll_index;
      
      Sys::Poll->poll($poll_fd_array, 1, 0);
      
      my $revent = $poll_fd_array->revents($poll_index);
      
      my $io_ready = 0;
      if ($revent & (POLL->POLLHUP | POLL->POLLNVAL | POLL->POLLERR)) {
        $io_ready = 1;
      }
      else {
        if ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
          if ($revent & POLL->POLLOUT) {
            $io_ready = 1;
          }
        }
        else {
          if ($revent & POLL->POLLIN) {
            $io_ready = 1;
          }
        }
      }
      
      my $is_over_deadline = 0;
      unless ($io_ready) {
        my $deadline = $goroutine->{deadline};
        
        if ($deadline) {
          $is_over_deadline = Go::Time->now->after($deadline);
          $goroutine->{io_wait_over_deadline} = (byte)$is_over_deadline;
        }
      }
      
      if ($io_ready || $is_over_deadline) {
        $self->enable_goroutine($goroutine);
      }
    }
  }
  
  private method enable_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{fd} = -1;
    $goroutine->{deadline} = undef;
    $goroutine->{disabled} = 0;
    $goroutine->{schedule_type} = Go::Schedule->TYPE_NONE;
    $self->{disabled_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{schedule}{goroutines}->push($goroutine);
  }
  
  private method run : void () {
    
    my $shcedule_cb = [$self : Go::Schedule = $self->{schedule}] method : void () {
      
      my $schedule_task = Go::Schedule::Task->new;
      $schedule_task->{schedule} = $self;
      
      my $start_goroutine = Go::Goroutine->new;
      
      my $schedule_task_goroutine = Go::Goroutine->new($schedule_task);
      
      $schedule_task_goroutine->{return_back} = $start_goroutine;
      
      $self->{schedule_task_goroutine} = $schedule_task_goroutine;
      
      Go::Goroutine->transfer($start_goroutine, $schedule_task_goroutine);
    };
    
    while (1) {
      
      $self->check_timer;
      
      $self->check_io;
      
      $shcedule_cb->();
      
      unless ($self->loop_alive) {
        last;
      }
    }
  }
  
}
