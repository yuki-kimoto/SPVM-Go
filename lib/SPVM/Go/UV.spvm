class Go::UV {
  version_from Go;
  
  allow Go::Schedule;
  
  use Go::UV::Task;
  
  # Fields
  has schedule : Go::Schedule;
  
  # Class Methods
  static method new : Go::UV () {
    
    my $self = new Go::UV;
    
    return $self;
  }
  
  native method timer : void ($uv_task : Go::UV::Task);
  
  native method idle_start : void ();
  
  native method poll : void ($uv_task : Go::UV::Task);
  
  native method async : void ($uv_task : Go::UV::Task);
  
  native method async_send : void ($uv_task : Go::UV::Task);
  
  native method run : void ();
  
}
