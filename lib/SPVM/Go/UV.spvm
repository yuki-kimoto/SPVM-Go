class Go::UV {
  version_from Go;
  
  allow Go::Schedule;
  allow Go::Channel;
  
  use Sys::Poll::PollfdArray;
  use Sys::Poll::Constant as POLL;
  use Sys::Poll;
  
  # Fields
  has schedule : Go::Schedule;
  
  has timer_wait_goroutines_h : Hash of Go::Goroutine;
  
  has io_wait_goroutines_h : Hash of Go::Goroutine;
  
  has channel_read_waits_length : int;
  
  has channel_write_waits_length : int;
  
  # Class Methods
  static method new : Go::UV () {
    
    my $self = new Go::UV;
    
    $self->{timer_wait_goroutines_h} = Hash->new;
    
    $self->{io_wait_goroutines_h} = Hash->new;
    
    return $self;
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{schedule}{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{timer_wait_goroutines_h}->keys_length
      + $self->{io_wait_goroutines_h}->keys_length;
      + $self->{channel_read_waits_length}
      + $self->{channel_write_waits_length};
      
    return $all_goroutines_length ? 1 : 0;
  }
  
  private method check_timer : void () {
    
    my $schedule = $self->{schedule};
    
    my $timer_wait_goroutines_h = $self->{timer_wait_goroutines_h};
    
    my $addreses = $timer_wait_goroutines_h->keys;
    for my $address (@$addreses) {
      my $goroutine = $timer_wait_goroutines_h->{$address};
      unless ($goroutine->{schedule_type} == Go::Schedule->TYPE_SLEEP) {
        die "[Unexpected Error]\$goroutine->{schedule_type} must be TYPE_SLEEP.";
      }
      
      my $deadline = $goroutine->{deadline};
      
      if ($deadline) {
        my $is_over_deadline = 1;
        
        if ($deadline) {
          $is_over_deadline = Go::Time->now->after($deadline);
        }
        
        if ($is_over_deadline) {
          $self->awake_goroutine($goroutine);
        }
      }
    }
  }
  
  private method check_io : void () {
    
    my $schedule = $self->{schedule};
    
    my $io_wait_goroutines_h = $self->{io_wait_goroutines_h};
    
    my $goroutines_length = $io_wait_goroutines_h->keys_length;
    
    if ($goroutines_length > 0) {
      my $poll_fd_array = Sys::Poll::PollfdArray->new($goroutines_length);
      
      my $goroutine_addresses = $io_wait_goroutines_h->keys;
      
      my $poll_index = 0;
      for my $address (@$goroutine_addresses) {
        
        my $goroutine = (Go::Goroutine)$io_wait_goroutines_h->get($address);
        
        unless ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_READ || $goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
          die "[Unexpected Error]\$goroutine->{schedule_type} must be TYPE_IO_READ or TYPE_IO_WRITE.";
        }
        
        my $fd = $goroutine->{fd};
        
        $poll_fd_array->set_fd($poll_index, $fd);
        
        my $schedule_type = $goroutine->{schedule_type};
        
        if ($schedule_type == Go::Schedule->TYPE_IO_WRITE) {
          $poll_fd_array->set_events($poll_index, POLL->POLLOUT);
        }
        else {
          $poll_fd_array->set_events($poll_index, POLL->POLLIN);
        }
        
        $goroutine->{poll_index} = $poll_index;
        
        $poll_index++;
      }
      
      my $status = Sys::Poll->poll($poll_fd_array, $goroutines_length, 0);
      
      for my $address (@$goroutine_addresses) {
        my $goroutine = (Go::Goroutine)$io_wait_goroutines_h->get($address);
        
        unless ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_READ || $goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
          die "[Unexpected Error]\$goroutine->{schedule_type} must be TYPE_IO_READ or TYPE_IO_WRITE.";
        }
        
        my $poll_index = $goroutine->{poll_index};
        
        my $revent = $poll_fd_array->revents($poll_index);
        
        my $io_ready = 0;
        if ($revent & (POLL->POLLHUP | POLL->POLLNVAL | POLL->POLLERR)) {
          $io_ready = 1;
        }
        else {
          if ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
            if ($revent & POLL->POLLOUT) {
              $io_ready = 1;
            }
          }
          else {
            if ($revent & POLL->POLLIN) {
              $io_ready = 1;
            }
          }
        }
        
        my $is_over_deadline = 0;
        unless ($io_ready) {
          my $deadline = $goroutine->{deadline};
          
          if ($deadline) {
            $is_over_deadline = Go::Time->now->after($deadline);
            $goroutine->{io_wait_over_deadline} = (byte)$is_over_deadline;
          }
        }
        
        if ($io_ready || $is_over_deadline) {
          $io_wait_goroutines_h->delete($address);
          $goroutine->{disabled} = 0;
          $goroutine->{schedule_type} = Go::Schedule->TYPE_NONE;
          $goroutine->{fd} = -1;
          $goroutine->{deadline} = undef;
          $schedule->{goroutines}->push($goroutine);
        }
      }
    }
  }
  
  private method awake_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{fd} = -1;
    $goroutine->{deadline} = undef;
    $goroutine->{disabled} = 0;
    $goroutine->{schedule_type} = Go::Schedule->TYPE_NONE;
    $self->{timer_wait_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{schedule}{goroutines}->push($goroutine);
  }
}
