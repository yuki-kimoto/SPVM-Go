class Go::UV {
  version_from Go;
  
  allow Go::Schedule;
  allow Go::Channel;
  
  use Sys::Poll::PollfdArray;
  use Sys::Poll::Constant as POLL;
  use Sys::Poll;
  use Callback;
  
  # Fields
  has schedule : Go::Schedule;
  
  # Class Methods
  static method new : Go::UV () {
    
    my $self = new Go::UV;
    
    return $self;
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{schedule}{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{schedule}{disabled_goroutines_h}->keys_length;
      
    return $all_goroutines_length ? 1 : 0;
  }
  
  private native method timer : void ($goroutine : Go::Goroutine);
  
  private native method idle_start : void ();
  
  private native method poll : void ($goroutine : Go::Goroutine);
  
  private native method async : void ($goroutine : Go::Goroutine);
  
  private native method async_send : void ($goroutine : Go::Goroutine);
  
  private native method run : void ();
}
