class Go::Schedule::Task {
  version_from Go;
  allow Go::Schedule;
  
  use Go::Schedule;
  use Format;
  
  has schedule : Go::Schedule;
  
  private static method new : Go::Schedule::Task () {
    
    my $self = new Go::Schedule::Task;
    
    return $self;
  }
  
  private method : void () {
    
    my $schedule = $self->{schedule};
    
    my $goroutines = $schedule->{goroutines};
    
    unless (@$goroutines > 0) {
      return;
    }
    
    my $goroutine = $goroutines->shift;
    
    if ($goroutine->{finished}) {
      if (Go->ENV_DEBUG) {
        diag Fn->sprintf("[Go Debug]Finish goroutine. \$task=%p.", $goroutine->{task});
      }
    }
    else {
      if ($goroutine->{disable}) {
        if (Go->ENV_DEBUG) {
         diag Fn->sprintf("[Go Debug]Skip disabled goroutine. \$task=%p.", $goroutine->{task});
        }
        
        if ($goroutine->{schedule_type} == Go::Schedule->TYPE_SLEEP) {
          
        }
        elsif ($goroutine->{schedule_type} == Go::Schedule->TYPE_IO_READ || $goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
          
        }
        elsif ($goroutine->{schedule_type} == Go::Schedule->TYPE_CHANNEL_READ || $goroutine->{schedule_type} == Go::Schedule->TYPE_CHANNEL_WRITE) {
          $goroutines->push($goroutine);
        }
        else {
          die "[Unexpected Error]Invalid schedule_type.";
        }
      }
      else {
        if (Go->ENV_DEBUG) {
          diag Fn->sprintf("[Go Debug]Restart goroutine. \$task=%p.", $goroutine->{task});
        }
        
        $goroutines->push($goroutine);
        
        my $schedule_task_goroutine = $schedule->{schedule_task_goroutine};
        
        $goroutine->{return_back} = $schedule_task_goroutine;
        
        $schedule->{current_goroutine} = $goroutine;
        
        Go::Goroutine->transfer($schedule_task_goroutine, $goroutine);
      }
    }
  }
  
}
