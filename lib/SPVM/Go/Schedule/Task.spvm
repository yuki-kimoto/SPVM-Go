class Go::Schedule::Task {
  version_from Go;
  allow Go::Schedule;
  
  use Go::Schedule;
  use Format;
  
  has schedule : Go::Schedule;
  
  private static method new : Go::Schedule::Task () {
    
    my $self = new Go::Schedule::Task;
    
    return $self;
  }
  
  private method : void () {
    
    my $schedule = $self->{schedule};
    my $goroutines = $schedule->{goroutines};
    
    my $goroutines_length = @$goroutines;
    unless ($goroutines_length > 0) {
      die "[Unexpected Error]\$schedule->{goroutines} must has at-least one element.";
    }
    
    for (my $i = 0; $i < $goroutines_length; $i++) {
      my $goroutine = $goroutines->shift;
      
      if ($goroutine->{finished}) {
        $schedule->{current_goroutine} = undef;
        next;
      }
      
      if ($goroutine->{disable}) {
        $goroutines->push($goroutine);
        next;
      }
      
      my $schedule_task_goroutine = $schedule->{schedule_task_goroutine};
      
      $goroutine->{return_back} = $schedule_task_goroutine;
      
      $schedule->{current_goroutine} = $goroutine;
      
      $goroutines->push($goroutine);
      
      Go::Goroutine->transfer($schedule_task_goroutine, $goroutine);
      
      return;
    }
  }
  
}
