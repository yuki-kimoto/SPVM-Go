class Go::Schedule::Info {
  
  allow Go;
  allow Go::Channel;
  allow Go::Schedule;
  allow Go::Select;
  allow Go::OS::Exec::Cmd;
  
  use Go::Channel::Wait;
  use UV::ProcessOptions;
  use Go::OS::Exec::Cmd;
  use Go::Context;
  
  private enum {
    TYPE_NONE,
    TYPE_SLEEP,
    TYPE_CHANNEL_READ,
    TYPE_CHANNEL_WRITE,
    TYPE_POLL_READ,
    TYPE_POLL_WRITE,
    TYPE_POLL_CANCEL,
    TYPE_PIPE_READ,
    TYPE_PIPE_WRITE,
    TYPE_PIPE_CANCEL,
    TYPE_PROCESS,
  }
  
  # Fields
  has type : int;
  
  has fd : int;
  
  has context : Go::Context;
  
  has wait : Go::Channel::Wait;
  
  has buffer : string;
  
  has buffer_length : int;
  
  has buffer_offset : int;
  
  has ret_length : int;
  
  has error_id : int;
  
  has exception : string;
  
  has process_exec_cmd : Go::OS::Exec::Cmd;
  
  has process_exit_status : long;
  
  has process_term_signal : int;
  
  # Class Methods
  static method new : Go::Schedule::Info () {
    
    my $self = new Go::Schedule::Info;
    
    return $self;
  }
  
}
