class Go::Goroutine : pointer {
  version_from Go;
  allow Go::Schedule;
  allow Go::Channel;
  allow Go::UV;
  
  use Callback;
  use Go::Channel;
  use Go::Time;
  use Resource::Coro;
  use Go::UV::Handle;
  use Go::UV::Request::Write;
  
  # Fields
  has schedule_goroutine : Go::Goroutine;
  
  has task : Callback;
  
  has finished : byte;
  
  has disabled : byte;
  
  has uv_handle : Go::UV::Handle;
  
  has timeout_uv_timer : Go::UV::Handle::Timer;
  
  has io_timeout_occurred : byte;
  
  has io_error_occurred : byte;
  
  has io_error_message : string;
  
  has error_id : int;
  
  has exception : string;
  
  has uv_write : Go::UV::Request::Write;
  
  # Class Methods
  static method new : Go::Goroutine ($task :  Callback = undef, $schedule_goroutine : Go::Goroutine = undef) {
    
    my $self = new Go::Goroutine;
    
    $self->{task} = $task;
    
    $self->{schedule_goroutine} = $schedule_goroutine;
    
    $self->init_goroutine;
    
    return $self;
  }
  
  native static method transfer : void ($from : Go::Goroutine, $to : Go::Goroutine);
  
  # Instance Methods
  native private method init_goroutine : void ();
  
  native method DESTROY : void ();
  
  # For Sys#pipepair
  native static method _pipepair : void ($read_fd_ref : int*, $write_fd_ref : int*, $non_bloking : int = 0);
  
}
