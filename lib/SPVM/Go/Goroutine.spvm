class Go::Goroutine : pointer {
  version_from Go;
  allow Go::Schedule;
  allow Go::Schedule::Task;
  allow Go::Channel;
  allow Go::UV;
  
  use Callback;
  use Go::Channel;
  use Go::Time;
  use Resource::Coro;
  
  # Fields
  has return_back : Go::Goroutine;
  
  has task : Callback;
  
  has finished : byte;
  
  has deadline : Go::Time;
  
  has io_wait_over_deadline : byte;
  
  has fd : int;
  
  has schedule_type : int;
  
  has poll_index : int;
  
  has disabled : byte;
  
  # Class Methods
  static method new : Go::Goroutine ($task :  Callback = undef, $return_back : Go::Goroutine = undef) {
    
    my $self = new Go::Goroutine;
    
    $self->{task} = $task;
    
    $self->{return_back} = $return_back;
    
    $self->init_goroutine;
    
    $self->{fd} = -1;
    
    return $self;
  }
  
  native static method transfer : void ($from : Go::Goroutine, $to : Go::Goroutine);
  
  # Instance Methods
  native private method init_goroutine : void ();
  
  native method DESTROY : void ();
}
