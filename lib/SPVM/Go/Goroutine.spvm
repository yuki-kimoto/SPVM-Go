class Go::Goroutine extends Go::UV::Handle: pointer {
  version_from Go;
  allow Go::Schedule;
  allow Go::Channel;
  allow Go::UV;
  
  use Callback;
  use Go::Channel;
  use Go::Time;
  use Resource::Coro;
  use Go::UV::Handle;
  use Go::UV::Handle::Write;
  
  # Fields
  has return_back : Go::Goroutine;
  
  has task : Callback;
  
  has finished : byte;
  
  has disabled : byte;
  
  has uv_handle : Go::UV::Handle;
  
  has timeout_uv_timer : Go::UV::Handle::Timer;
  
  has io_timeout_occurred : byte;
  
  has uv_write : Go::UV::Handle::Write;
  
  # Class Methods
  static method new : Go::Goroutine ($task :  Callback = undef, $return_back : Go::Goroutine = undef) {
    
    my $self = new Go::Goroutine;
    
    $self->{task} = $task;
    
    $self->{return_back} = $return_back;
    
    $self->init_goroutine;
    
    return $self;
  }
  
  native static method transfer : void ($from : Go::Goroutine, $to : Go::Goroutine);
  
  # Instance Methods
  native private method init_goroutine : void ();
  
  native method DESTROY : void ();
  
}
