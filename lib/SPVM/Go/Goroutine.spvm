class Go::Goroutine : pointer {
  version_from Go;
  allow Go::Schedule;
  allow Go::Channel;
  
  use Callback;
  use Resource::Coro;
  
  # Fields
  has task : Callback;
  
  has return_back_goroutine : Go::Goroutine;
  
  has finished : byte;
  
  has disabled : byte;
  
  has caller_info : CallerInfo;
  
  # Class Methods
  static method new : Go::Goroutine ($task :  Callback = undef, $return_back_goroutine : Go::Goroutine = undef, $caller_info : CallerInfo = undef) {
    
    my $self = new Go::Goroutine;
    
    $self->{task} = $task;
    
    $self->{return_back_goroutine} = $return_back_goroutine;
    
    $self->{caller_info} = $caller_info // caller;
    
    $self->init_goroutine;
    
    return $self;
  }
  
  native static method transfer : void ($from : Go::Goroutine, $to : Go::Goroutine);
  
  # Instance Methods
  native private method init_goroutine : void ();
  
  native method DESTROY : void ();
  
}
