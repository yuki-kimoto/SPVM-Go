class Go::Context {
  version_from Go;
  
  use Go::Channel;
  use Go::Time;
  use Go::Context::Derived;
  use Go::Context::Value;
  use Go::Context::Error::Canceled;
  use Go::Context::Error::DeadlineExceeded;
  use UV::Handle::Timer;
  use UV::Callback::Timer;
  
  use Fn;
  
  # Fields
  has deadline : ro Go::Time;
  
  has done : ro Go::Channel;
  
  has err : ro int;
  
  has cause : ro string;
  
  has key : object;
  
  has value : object;
  
  has parent : Go::Context;
  
  has children : Go::Context[];
  
  has stop_ch : Go::Channel;
  
  has uv_timer : UV::Handle::Timer;
  
  our $BACKGROUND_CONTEXT : Go::Context;

  INIT {
    $BACKGROUND_CONTEXT = new Go::Context;
  }

  # Class Methods
  static method background : Go::Context () {
    return $BACKGROUND_CONTEXT;
  }
  
  static method todo : Go::Context () {
    return $BACKGROUND_CONTEXT;
  }
  
  static method without_cancel : Go::Context ($parent_context : Go::Context) {
    
    unless ($parent_context) {
      die "Go::Context \$parent_context must be defined.";
    }
    
    my $self = new Go::Context;
    
    $self->init;
    
    $self->{parent} = $parent_context;
    
    return $self;
  }
  
  static method with_cancel : Go::Context::Derived ($parent_context : Go::Context) {
    
    return &with_cancel_common($parent_context, basic_type_id Go::Context::Error::Canceled, undef, undef);
  }
  
  static method with_cancel_cause : Go::Context::Derived ($parent_context : Go::Context, $cause : string) {
    
    return &with_cancel_common($parent_context, basic_type_id Go::Context::Error::Canceled, $cause, undef);
  }
  
  static method with_deadline : Go::Context::Derived ($parent_context : Go::Context, $deadline : Go::Time) {
    
    return &with_cancel_common($parent_context, basic_type_id Go::Context::Error::DeadlineExceeded, undef, $deadline);
  }
  
  static method with_deadline_cause : Go::Context::Derived ($parent_context : Go::Context, $deadline : Go::Time, $cause : string) {
    
    return &with_cancel_common($parent_context, basic_type_id Go::Context::Error::DeadlineExceeded, $cause, $deadline);
  }
  
  static method with_timeout : Go::Context::Derived ($parent_context : Go::Context, $timeout : Go::Duration_1l) {
    
    return &with_deadline($parent_context, Go::Time->now->add($timeout));
  }
  
  static method with_timeout_sec : Go::Context::Derived ($parent_context : Go::Context, $timeout_sec : double) {
    
    my $timeout = Go::Duration_1l->new_from_sec($timeout_sec);
    
    return &with_timeout($parent_context, $timeout);
  }
  
  static method with_value : Go::Context ($parent_context : Go::Context, $key : object, $value : object) {
    return Go::Context::Value->new_with_value($parent_context, $key, $value);
  }
  
  private static method with_cancel_common : Go::Context::Derived ($parent_context : Go::Context, $err : int = 0, $cause : string = undef, $deadline : Go::Time = undef) {
    
    unless ($parent_context) {
      die "Go::Context \$parent_context must be defined.";
    }
    
    unless ($err > 0) {
      die "[Unexpected Error]\$err must be a positive value.";
    }
    
    unless ($cause) {
      if ($err == basic_type_id Go::Context::Error::Canceled) {
        $cause = "context canceled";
      }
      elsif ($err == basic_type_id Go::Context::Error::DeadlineExceeded) {
        $cause = "context deadline exceeded";
      }
    }
    
    my $self = new Go::Context;
    
    $self->init;
    
    $self->{parent} = $parent_context;
    if (my $parent_children = $parent_context->{children}) {
      List->new_ref($parent_children)->push($self);
    }
    weaken $self->{parent};
    
    $self->{done} = Go->make;
    
    my $stop_ch = Go->make;
    $self->{stop_ch} = $stop_ch;
    
    my $uv_timer_ref = [(UV::Handle::Timer)undef];
    my $timer_cb_ref = [(UV::Callback::Timer)undef];
    
    my $default_err = $err;
    my $default_cause = $cause;
    
    # Cancel context, close timer handle, and propagate to children
    my $cancel_with_err = [$self : , $stop_ch : , $uv_timer_ref : , $timer_cb_ref : ] method : void ($cancel_err : int, $cancel_cause : string) {
      
      if ($stop_ch) {
        $stop_ch->close;
      }
      
      if (my $t = $uv_timer_ref->[0]) {
        $t->set_timer_cb(undef);
        $t->stop;
        $t->close_safe;
        $uv_timer_ref->[0] = undef;
      }
      $timer_cb_ref->[0] = undef;
      
      if ($self->err > 0) {
        return;
      }
      
      $self->{err} = $cancel_err;
      $self->{cause} = $cancel_cause;
      
      if ($self->done) {
        $self->done->close;
      }
      
      my $all_children = (List of Go::Context)List->new($self->{children});
      $self->{children} = new Go::Context[0];
      
      while (1) {
        unless ($all_children->length) {
          last;
        }
        
        my $child = $all_children->shift;
        
        unweaken $child->{parent};
        
        unless ($child isa Go::Context::Value) {
          if ($child->done) {
            $child->done->close;
            $child->{err} = $cancel_err;
            $child->{cause} = $cancel_cause;
          }
        }
        
        $all_children->push_($child->{children});
        $child->{children} = new Go::Context[0];
      }
    };
    weaken $cancel_with_err->{self};
    
    my $cancel = [$cancel_with_err : , $default_err : int, $default_cause : string] method : void ($override_cause : string = undef) {
      
      my $use_cause = $override_cause ? $override_cause : $default_cause;
      $cancel_with_err->($default_err, $use_cause);
    };
    
    if ($deadline) {
      if ($parent_context->{deadline}) {
        if ($deadline->after($parent_context->{deadline})) {
          $deadline = $parent_context->{deadline}->clone;
        }
      }
      
      $self->{deadline} = $deadline;
      
      my $now = Go::Time->now;
      my $duration = $deadline->sub($now);
      my $duration_nsec = $duration->{nsec};
      if ($duration_nsec < 0L) {
        $duration_nsec = 0L;
      }
      my $timeout_msec = (long)($duration_nsec / 1_000_000L);
      
      my $uv_loop = Go->uv_loop;
      my $uv_timer = UV::Handle::Timer->new;
      $uv_loop->timer_init($uv_timer);
      $self->{uv_timer} = $uv_timer;
      $uv_timer_ref->[0] = $uv_timer;
      
      # Trigger deadline error and clean up timer handle on expiration
      my $timer_cb = [$cancel_with_err : , $uv_timer_ref : , $timer_cb_ref : ] method : void ($timer : UV::Handle::Timer) {
        if (my $t = $uv_timer_ref->[0]) {
          $t->set_timer_cb(undef);
          $t->stop;
          $t->close_safe;
          $uv_timer_ref->[0] = undef;
        }
        $timer_cb_ref->[0] = undef;
        $cancel_with_err->(basic_type_id Go::Context::Error::DeadlineExceeded, "context deadline exceeded");
      };
      weaken $timer_cb->{uv_timer_ref};
      weaken $timer_cb->{cancel_with_err};
      weaken $timer_cb->{timer_cb_ref};
      $timer_cb_ref->[0] = $timer_cb;
      
      $uv_timer->start($timer_cb, $timeout_msec);
    }
    
    my $derived = my $_ = Go::Context::Derived->new;
    $_->set_context($self);
    $_->set_cancel_cb($cancel);
    
    return $derived;
  }
  
  # Instance Methods
  protected method init : void () {
    
    $self->{children} = new Go::Context[0];
  }
  
  method value : object ($key : object) {
    
    unless ($key) {
      die "The key \$key must be defined";
    }
    
    my $value = (object)undef;
    if ($self->{key} && Fn->to_address($key) eq Fn->to_address($self->{key})) {
      $value = $self->{value};
    }
    else {
      if ($self->{parent}) {
        $value = $self->{parent}->value($key);
      }
    }
    
    return $value;
  }
  
  method DESTROY : void () {
    
    if (my $uv_timer = $self->{uv_timer}) {
      $uv_timer->set_timer_cb(undef);
      $uv_timer->stop;
      $uv_timer->close_safe;
      $self->{uv_timer} = undef;
    }
    
    if (my $stop_ch = $self->{stop_ch}) {
      $stop_ch->close;
    }
  }
}
