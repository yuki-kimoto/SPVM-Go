class Go::UV::Request::Write extends Go::UV::Request {
  
  use Go::UV::Loop;
  use Go::UV::Request::Write;
  use Go::UV::Callback::Write;
  
  # Fields
  has write_cb : rw Go::UV::Callback::Write;
  
  has write_buffer : rw string;
  
  # Class Mehtods
  native static method new : Go::UV::Request::Write ();
  
  # Instance Methods
  method write : void ($uv_stream : Go::UV::Handle::Stream, $buffer : string, $buffer_length : int, $cb : Go::UV::Callback::Write, $buffer_offset : int = 0) {
    
    Go::UV::Loop->_req_write($self, $uv_stream, $buffer, $buffer_length, $cb, $buffer_offset);
  }
  
  native method DESTROY : void ();
}
