class Go::UV::Request::Write extends Go::UV::Request {
  
  use Go::UV::Loop;
  use Go::UV::Request::Write;
  use Go::UV::Callback::Write;
  
  # Fields
  has write_cb : ro Go::UV::Callback::Write;
  
  has write_buffer : ro string;
  
  # Class Mehtods
  static method new : Go::UV::Request::Write () {
    
    my $self = Go::UV::Loop->new_write;
    
    return $self;
  }
  
  # Instance Methods
  method write : void ($uv_stream : Go::UV::Handle::Stream, $buffer : string, $buffer_length : int, $cb : Go::UV::Callback::Write, $buffer_offset : int = 0) {
    
    Go::UV::Loop->req_write($self, $uv_stream, $buffer, $buffer_length, $cb, $buffer_offset);
  }
  
  method DESTROY : void () {
    
    Go::UV::Loop->destroy_write($self);
  }
  
}
