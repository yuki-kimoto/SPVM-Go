class Go::UV::Request::Write extends Go::UV::Request {
  
  use Go::UV::Loop;
  
  # Class Mehtods
  static method new : Go::UV::Request::Write () {
    
    my $self = Go::UV::Loop->new_write;
    
    return $self;
  }
  
  # Instance Methods
  method DESTROY : void () {
    
    Go::UV::Loop->destroy_write($self);
  }
  
}
