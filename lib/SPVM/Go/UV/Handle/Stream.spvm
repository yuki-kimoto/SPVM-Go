class Go::UV::Handle::Stream extends Go::UV::Handle {
  
  use Go::UV::Loop;
  use Go::UV::Request::Write;
  use Go::UV::Callback::Read;
  use Go::UV::Callback::Write;
  
  # Instance Methods
  method read_start : void ($buffer : mutable string, $buffer_length : int, $cb : Go::UV::Callback::Read) {
    
    Go::UV::Loop->handle_read_start($self, $buffer, $buffer_length, $cb);
  }
  
  method write : void ($uv_req : Go::UV::Request::Write, $buffer : string, $buffer_length : int, $cb : Go::UV::Callback::Write) {
    
    Go::UV::Loop->handle_write($uv_req, $self, $buffer, $buffer_length, $cb);
  }
  
}
