class Go::UV::Handle::Poll extends Go::UV::Handle {
  
  use Go::UV::Callback::Poll;
  
  # Fields
  has poll_cb : ro Go::UV::Callback::Poll;
  
  # Class Mehtods
  static method new : Go::UV::Handle::Poll () {
    
    my $self = Go::UV::Loop->new_poll;
    
    return $self;
  }
  
  # Instance Methods
  method start : void ($cb : Go::UV::Callback::Poll, $events : int) {
    
    Go::UV::Loop->handle_poll_start($self, $cb, $events);
  }
  
}
