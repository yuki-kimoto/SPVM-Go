class Go::UV::Handle::Async extends Go::UV::Handle {
  
  # Fields
  has async_cb : ro Go::UV::Callback::Async;
  
  # Class Mehtods
  static method new : Go::UV::Handle::Async () {
    
    my $self = Go::UV::Loop->new_async;
    
    return $self;
  }
  
  # Instance Methods
  method send : void () {
    
    Go::UV::Loop->handle_async_send($self);
  }
}
