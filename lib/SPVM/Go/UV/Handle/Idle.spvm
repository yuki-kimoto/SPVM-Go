class Go::UV::Handle::Idle extends Go::UV::Handle {
  
  # Class Mehtods
  static method new : Go::UV::Handle::Idle () {
    
    my $self = Go::UV::Loop->new_idle;
    
    return $self;
  }
  
  # Instance Methods
  method start : void ($cb : Go::UV::Callback::Handle) {
    
    Go::UV::Loop->handle_idle_start($self, $cb);
  }
  
}
