class Go::UV::Handle::Timer extends Go::UV::Handle {
  
  use Go::UV::Callback::Timer;
  use Resource::UV;
  use Go::Resource::UV;
  
  
  # Fields
  has timer_cb : rw Go::UV::Callback::Timer;
  
  # Class Mehtods
  native static method new : Go::UV::Handle::Timer ();
  
  # Instance Methods
  native method start : void ($cb : Go::UV::Callback::Timer, $timeout_msec : long, $interval_msec : long = 0);
  
}
