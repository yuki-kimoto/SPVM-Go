class Go::UV::Handle::Timer extends Go::UV::Handle {
  
  use Go::UV::Callback::Timer;
  
  # Fields
  has timer_cb : ro Go::UV::Callback::Timer;
  
  # Class Mehtods
  static method new : Go::UV::Handle::Timer () {
    
    my $self = Go::UV::Loop->new_timer;
    
    return $self;
  }
  
  # Instance Methods
  method start : void ($cb : Go::UV::Callback::Timer, $timeout_msec : long, $interval_msec : long = 0) {
    
    Go::UV::Loop->handle_timer_start($self, $cb, $timeout_msec, $interval_msec);
  }
  
}
