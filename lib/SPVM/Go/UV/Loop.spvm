class Go::UV::Loop : pointer {
  
  allow Go::UV::Handle;
  allow Go::UV::Handle::Idle;
  
  use Go::UV;
  use Go::UV::Handle;
  use Go::UV::Handle::Idle;
  use Go::UV::Handle::Async;
  use Go::UV::Handle::Timer;
  use Go::UV::Handle::Poll;
  use Go::UV::Handle::Pipe;
  use Go::UV::Constant;
  use Go::UV::Request::Write;
  use Go::UV::Callback::Idle;
  use Go::UV::Callback::Timer;
  use Go::UV::Callback::Async;
  use Go::UV::Callback::Poll;
  use Go::UV::Callback::Read;
  use Go::UV::Callback::Write;
  use Go::UV::Callback::Close;
  
  # Class Variables
  our $DEFAULT_LOOP : Go::UV::Loop;
  
  INIT {
    &default_loop;
  }
  
  # Fields
  has uv_handles_h : Hash of Go::UV::Handle;
  
  # Class Mehtods
  native static method new : Go::UV::Loop ();
  
  native private static method default_loop : Go::UV::Loop ();
  
  # Instance Methods
  protected method init : void () {
    $self->{uv_handles_h} = Hash->new;
  }
  
  native method run : void ($uv_run_mode : int);
  
  native method idle_init : void ($uv_idle : Go::UV::Handle::Idle);
  
  native method timer_init : void ($uv_timer : Go::UV::Handle::Timer);
  
  native method poll_init : void ($uv_poll : Go::UV::Handle::Poll, $fd : int);
  
  native method async_init : void ($uv_async : Go::UV::Handle::Async, $cb : Go::UV::Callback::Async);
  
  native method pipe_init : void ($uv_pipe : Go::UV::Handle::Pipe, $ipc : int);
  
  private method set_uv_handle : void ($uv_handle  : Go::UV::Handle) {
    
    my $uv_handle_address = Fn->to_address($uv_handle);
    
    $self->{uv_handles_h}{$uv_handle_address} = $uv_handle;
    
    $uv_handle->{loop} = $self;
  }
  
  private method exists_uv_handle : int ($uv_handle  : Go::UV::Handle) {
    
    my $uv_handle_address = Fn->to_address($uv_handle);
    
    return $self->{uv_handles_h}{$uv_handle_address}->(Go::UV::Handle) ? 1 : 0;
  }
  
  private method delete_uv_handle : void ($uv_handle  : Go::UV::Handle) {
    
    if ($self->exists_uv_handle($uv_handle)) {
      my $uv_handle_address = Fn->to_address($uv_handle);
      
      $self->{uv_handles_h}->delete($uv_handle_address);
      
      $uv_handle->{loop} = undef;
    }
  }
  
  native method DESTROY : void ();
  
  # For Go::UV
  native static method _strerror : string ($status : int);
  
  # For Go::UV::Handle
  
  native static method _handle_async_send : void ($uv_handle : Go::UV::Handle);
  
  native static method _handle_timer_start : void ($uv_handle : Go::UV::Handle::Timer, $cb : Go::UV::Callback::Timer, $timeout_msec : long, $interval_msec : long = 0);
  
  native static method _handle_poll_start : void ($uv_handle : Go::UV::Handle::Poll, $cb : Go::UV::Callback::Poll, $events : int);
  
  native static method _handle_idle_start : void ($uv_handle : Go::UV::Handle::Idle, $cb : Go::UV::Callback::Idle);
  
  native static method _handle_pipe_open : void ($uv_pipe : Go::UV::Handle::Pipe, $fd : int);
  
  native static method _handle_read_start : void ($uv_handle : Go::UV::Handle::Stream, $buffer : mutable string, $buffer_length : int, $cb : Go::UV::Callback::Read, $buffer_offset : int = 0);
  
  native static method _handle_destroy : void ($uv_handle : Go::UV::Handle);
  
  native static method _handle_close : void ($uv_handle : Go::UV::Handle, $close_cb : Go::UV::Callback::Close = undef);
  
  native static method _handle_get_type : int ($uv_handle : Go::UV::Handle);
  
  # For Go::UV::Handle::Idle
  native static method _new_idle : Go::UV::Handle::Idle ();
  
  # For Go::UV::Handle::Timer
  native static method _new_timer : Go::UV::Handle::Timer ();
  
  # For Go::UV::Handle::Poll
  native static method _new_poll : Go::UV::Handle::Poll ();
  
  # For Go::UV::Handle::Async
  native static method _new_async : Go::UV::Handle::Async ();
  
  # For Go::UV::Handle::Pipe
  native static method _new_pipe : Go::UV::Handle::Pipe ();
  
  # For Go::UV::Request
  
  native static method _req_write : void ($uv_req_write : Go::UV::Request::Write, $uv_handle : Go::UV::Handle::Stream, $buffer : string, $buffer_length : int, $cb : Go::UV::Callback::Write, $buffer_offset : int = 0);
  
  # For Go::UV::Request::Write
  native static method _new_write : Go::UV::Request::Write ();
  
  native static method _destroy_write : void ($uv_write : Go::UV::Request::Write);
  
}
