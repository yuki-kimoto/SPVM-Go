class Go::UV::Loop : pointer {
  
  allow Go::UV;
  allow Go::UV::Handle;
  allow Go::UV::Handle::Idle;
  
  use Go::UV::Handle;
  use Go::UV::Handle::Idle;
  use Go::UV::Handle::Async;
  use Go::UV::Handle::Timer;
  use Go::UV::Handle::Poll;
  use Go::UV::Handle::Pipe;
  use Go::UV::Callback::LoopAlive;
  use Go::UV::Constant;
  use Go::UV::Callback::Handle;
  use Go::UV::Handle::Write;
  
  # Fields
  has uv_handles_h : ro Hash of Go::UV::Handle;
  
  # Instance Methods
  native method run : void ($uv_run_mode : int);
  
  native method idle_init : void ($uv_idle : Go::UV::Handle::Idle);
  
  native method timer_init : void ($uv_timer : Go::UV::Handle::Timer);
  
  native method poll_init : void ($uv_poll : Go::UV::Handle::Poll, $fd : int);
  
  native method async_init : void ($uv_async : Go::UV::Handle::Async, $cb : Go::UV::Callback::Handle);
  
  native method pipe_init : void ($uv_pipe : Go::UV::Handle::Pipe, $ipc : int);
  
  # For Go::UV::Handle::Idle
  native static method new_idle : Go::UV::Handle::Idle ();
  
  # For Go::UV::Handle::Timer
  native static method new_timer : Go::UV::Handle::Timer ();
  
  # For Go::UV::Handle::Poll
  native static method new_poll : Go::UV::Handle::Poll ();
  
  # For Go::UV::Handle::Async
  native static method new_async : Go::UV::Handle::Async ();
  
  # For Go::UV::Handle::Write
  native static method new_write : Go::UV::Handle::Write ();
  
  # For Go::UV::Handle::Pipe
  native static method new_pipe : Go::UV::Handle::Pipe ();
  
  native static method destroy_write : void ($uv_write : Go::UV::Handle::Write);
  
  # For Go::UV
  native static method default_loop : Go::UV::Loop ();
  
  # For Go::UV::Handle
  
  native static method handle_async_send : void ($uv_handle : Go::UV::Handle);
  
  native static method handle_timer_start : void ($uv_handle : Go::UV::Handle::Timer, $cb : Go::UV::Callback::Handle, $timeout_msec : long, $interval_msec : long = 0);
  
  native static method handle_poll_start : void ($uv_handle : Go::UV::Handle::Poll, $cb : Go::UV::Callback::Handle, $events : int);
  
  private native static method handle_idle_start : void ($uv_handle : Go::UV::Handle::Idle, $cb : Go::UV::Callback::Handle);
  
  private native static method handle_read_start : void ($uv_handle : Go::UV::Handle::Stream, $buffer : mutable string, $buffer_length : int, $cb : Go::UV::Callback::Handle);
  
  private native static method handle_free : void ($uv_handle : Go::UV::Handle);
  
  private native static method handle_close : void ($uv_handle : Go::UV::Handle, $close_cb : Go::UV::Callback::Handle = undef);
  
  private native static method handle_get_type : int ($uv_handle : Go::UV::Handle);
  
  # Utilities
  private method set_uv_handle : void ($uv_handle  : Go::UV::Handle) {
    
    my $uv_handle_address = Fn->to_address($uv_handle);
    
    $self->{uv_handles_h}{$uv_handle_address} = $uv_handle;
    
    $uv_handle->{loop} = $self;
  }
  
  private method exists_uv_handle : int ($uv_handle  : Go::UV::Handle) {
    
    my $uv_handle_address = Fn->to_address($uv_handle);
    
    return $self->{uv_handles_h}{$uv_handle_address}->(Go::UV::Handle) ? 1 : 0;
  }
  
  private method delete_uv_handle : void ($uv_handle  : Go::UV::Handle) {
    
    if ($self->exists_uv_handle($uv_handle)) {
      my $uv_handle_address = Fn->to_address($uv_handle);
      
      $self->{uv_handles_h}->delete($uv_handle_address);
      
      $uv_handle->{loop} = undef;
    }
  }
  
}
