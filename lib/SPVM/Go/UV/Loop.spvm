class Go::UV::Loop : pointer {
  
  allow Go::UV;
  allow Go::UV::Handle;
  allow Go::UV::Handle::Idle;
  
  use Go::UV::Handle;
  use Go::UV::Handle::Idle;
  use Go::UV::Handle::Async;
  use Go::UV::Handle::Timer;
  use Go::UV::Callback::LoopAlive;
  use Go::UV::Constant;
  use Go::UV::Callback::Handle;
  
  # Instance Methods
  native method DESTROY : void ();
  
  # Instance Methods
  native method timer : void ($uv_handle : Go::UV::Handle, $cb : Go::UV::Callback::Handle, $timeout : long, $repeat : long);
  
  native method poll : void ($uv_handle : Go::UV::Handle, $cb : Go::UV::Callback::Handle);
  
  native method async : void ($uv_handle : Go::UV::Handle, $cb : Go::UV::Callback::Handle);
  
  native method run : void ($uv_run_mode : int);
  
  native method new_idle : Go::UV::Handle::Idle ();
  
  native method new_timer : Go::UV::Handle::Timer ();
  
  native method new_async : Go::UV::Handle::Async ($cb : Go::UV::Callback::Handle);
  
  # For Go::UV
  native static method default_loop : Go::UV::Loop ();
  
  # For Go::UV::Handle
  
  native method handle_async_send : void ($uv_handle : Go::UV::Handle);
  
  native method handle_async_send_v2 : void ($uv_handle : Go::UV::Handle);
  
  native method handle_timer_start : void ($uv_handle : Go::UV::Handle::Timer, $timeout : long, $repeat : long);
  
  native method handle_timer_stop : void ($uv_handle : Go::UV::Handle::Timer);
  
  private native method handle_idle_start : void ($uv_handle : Go::UV::Handle::Idle, $cb : Go::UV::Callback::Handle);
  
  private native method handle_idle_stop : void ($uv_handle : Go::UV::Handle::Idle);
  
  private native method handle_destroy : void ($uv_handle : Go::UV::Handle);
  
  private native method handle_close : void ($uv_handle : Go::UV::Handle);
  
}
