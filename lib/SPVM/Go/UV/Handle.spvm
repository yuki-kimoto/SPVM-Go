class Go::UV::Handle : pointer {
  
  use Callback;
  use Go::UV::Loop;
  
  # Enumerations
  enum {
    UV_UNKNOWN_HANDLE,
    UV_ASYNC,
    UV_CHECK,
    UV_FS_EVENT,
    UV_FS_POLL,
    UV_HANDLE,
    UV_IDLE,
    UV_NAMED_PIPE,
    UV_POLL,
    UV_PREPARE,
    UV_PROCESS,
    UV_STREAM,
    UV_TCP,
    UV_TIMER,
    UV_TTY,
    UV_UDP,
    UV_SIGNAL,
    UV_FILE,
    UV_HANDLE_TYPE_MAX
  }
  
  enum {
    UV_READABLE = 1,
    UV_WRITABLE = 2,
  }
  
  # Fields
  has handle_type : int;
  
  has event_type : int;
  
  has timeout_msec : long;
  
  has fd : int;
  
  has io_timeout_occurred : byte;
  
  has address : Address;
  
  has cb : rw Go::UV::Callback::Handle;
  
  has close_cb : rw Go::UV::Callback::Handle;
  
  has loop : ro Go::UV::Loop;
  
  # Instance Methods
  method close : void () {
    $self->loop->handle_close($self);
  }
  
  method DESTROY : void () {
    $self->{loop}->handle_destroy($self);
  }
}
