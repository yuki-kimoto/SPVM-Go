class Go::UV::Handle : pointer {
  
  allow Go::UV::Loop;
  
  use Go::UV::Loop;
  
  # Fields
  has close_cb : rw Go::UV::Callback::Close;
  
  has loop : ro Go::UV::Loop;
  
  # Instance Methods
  method close : void ($close_cb : Go::UV::Callback::Close = undef) {
    Go::UV::Loop->handle_close($self, $close_cb);
  }
  
  method get_type : int () {
    return Go::UV::Loop->handle_get_type($self);
  }
  
  method DESTROY : void () {
    Go::UV::Loop->handle_free($self);
  }
}
