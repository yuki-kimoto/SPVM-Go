class Go::UV::Handle : pointer {
  
  allow Go::UV::Loop;
  
  use Go::UV::Callback::Close;
  use Go::UV::Loop;
  
  use Go::Resource::UV;
  
  # Fields
  has close_cb : rw Go::UV::Callback::Close;
  
  has loop : ro Go::UV::Loop;
  
  # Instance Methods
  native method close_safe : void ($close_cb : Go::UV::Callback::Close = undef);
  
  native method get_type : int ();
  
  native method DESTROY : void ();
}
