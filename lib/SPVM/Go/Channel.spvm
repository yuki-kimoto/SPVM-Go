class Go::Channel {
  version_from Go;
  allow Go::Schedule;
  allow Go;
  allow Go::Select;
  
  use Hash;
  use Go::Channel::Wait;
  use Fn;
  use QList;
  use UV::Handle::Async;
  
  # Fields
  has capacity : int;
  
  has length : int;
  
  has closed : int;
  
  has read_waits : List of Go::Channel::Wait;
  
  has write_waits : List of Go::Channel::Wait;
  
  has schedule : Go::Schedule;
  
  # Class Methods
  private static method new : Go::Channel ($options : object[] = undef) {
    
    Fn->check_option_names($options, ["capacity", "schedule"]);
    
    my $options_h = Hash->new($options);
    
    my $self = new Go::Channel;
    
    my $capacity = $options_h->get_or_default("capacity", 0)->(int);
    $self->{capacity} = $capacity;
    
    unless ($capacity >= 0) {
      die "The \"capacity\" option must be greater than or equal to 0.";
    }
    
    my $schedule = (Go::Schedule)$options_h->get_or_default("schedule", undef);
    $self->{schedule} = $schedule;
    
    unless ($schedule) {
      die "The \"schedule\" option must be defined.";
    }
    
    $self->{read_waits} = QList->new(new Go::Channel::Wait[0]);
    
    $self->{write_waits} = QList->new(new Go::Channel::Wait[0]);
    
    return $self;
  }
  
  # Instance Methods
  method read : object ($ok_ref : int* = undef) {
    
    if ($ok_ref) {
      $$ok_ref = 1;
    }
    
    my $closed = $self->{closed};
    
    if ($closed && $self->{write_waits}->length == 0) {
      if ($ok_ref) {
        $$ok_ref = 0;
      }
      return undef;
    }
    
    if ($self->{write_waits}->length) {
      my $write_wait = (Go::Channel::Wait)$self->{write_waits}->shift;
      
      my $ok = 1;
      
      $self->finish_wait($write_wait, $ok);
      
      my $write_wait_is_wait = $write_wait->{is_wait};
      
      unless ($write_wait_is_wait) {
        $self->{length}--;
      }
      
      my $value = $write_wait->{value};
      
      return $value;
    }
    else {
      my $read_wait = Go::Channel::Wait->new;
      
      my $schedule = $self->{schedule};
      
      $read_wait->{is_wait} = 1;
      
      $self->{read_waits}->push($read_wait);
      
      while (1) {
        
        my $finish = $read_wait->{finish};
        
        if ($finish) {
          my $value = $read_wait->{value};
          
          if ($ok_ref) {
            $$ok_ref = $read_wait->{ok};
          }
          
          return $value;
        }
        
        if ($self->{write_waits}->length) {
          if ($read_wait == $self->{read_waits}->[0]) {
            my $write_wait = (Go::Channel::Wait)$self->{write_waits}->shift;
            
            my $ok = 1;
            
            $self->finish_wait($write_wait, $ok);
            
            my $value = $write_wait->{value};
            
            my $write_wait_is_wait = $write_wait->{is_wait};
            
            unless ($write_wait_is_wait) {
              $self->{length}--;
            }
            
            $self->{read_waits}->shift;
            
            return $value;
          }
        }
        
        $self->channel_wait($read_wait);
      }
    }
    
    return undef;
  }
  
  method write : void ($value : object) {
    my $closed = $self->{closed};
    
    if ($closed) {
      die "This channel is closed.";
    }
    
    my $length = $self->{length};
    
    my $capacity = $self->{capacity};
    
    if ($length < $capacity) {
      if ($self->{read_waits}->length) {
        my $read_wait = (Go::Channel::Wait)$self->{read_waits}->shift;
        
        my $ok = 1;
        $self->finish_wait($read_wait, $ok);
        
        $read_wait->{value} = $value;
        
        return;
      }
      else {
        my $write_wait = Go::Channel::Wait->new;
        
        $write_wait->{value} = $value;
        
        $self->{write_waits}->push($write_wait);
        
        $self->{length}++;
      }
    }
    else {
      if ($self->{read_waits}->length) {
        my $read_wait = (Go::Channel::Wait)$self->{read_waits}->shift;
        
        my $ok = 1;
        
        $self->finish_wait($read_wait, $ok);
        
        $read_wait->{value} = $value;
        
        return;
      }
      else {
        my $write_wait = Go::Channel::Wait->new;
        
        $write_wait->{value} = $value;
        
        my $schedule = $self->{schedule};
        
        $write_wait->{is_wait} = 1;
        
        $self->{write_waits}->push($write_wait);
        
        while (1) {
          
          my $finish = $write_wait->{finish};
          
          if ($finish) {
            return;
          }
          
          $self->channel_wait($write_wait);
        }
      }
    }
  }
  
  method close : void () {
    my $closed = $self->{closed};
    
    if ($closed) {
      return;
    }
    
    my $read_waits = $self->{read_waits};
    
    while ($read_waits->length > 0) {
      my $read_wait = (Go::Channel::Wait)$read_waits->shift;
      
      my $ok = 0;
      
      $self->finish_wait($read_wait, $ok);
    }
    
    $self->{closed} = 1;
  }
  
  method cap : int () {
    return $self->{capacity};
  }
  
  method len : int () {
    return $self->{length};
  }
  
  private method finish_wait : void ($wait : Go::Channel::Wait, $ok : int) {
    
    $wait->{finish} = 1;
    
    $wait->{ok} = (byte)$ok;
    
    if ($wait->{uv_async}) {
      my $uv_async = (UV::Handle::Async)$wait->{uv_async};
      $uv_async->send;
    }
  }
  
  method channel_wait : void ($wait : Go::Channel::Wait) {
    
    my $uv_loop = Go->uv_loop;
    
    my $schedule = $self->{schedule};
    
    my $uv_async = UV::Handle::Async->new;
    $wait->{uv_async} = $uv_async;
    
    my $goroutine_ref = [(Go::Goroutine)undef];
    
    my $async_cb = [$schedule : , $goroutine_ref : , $wait : ,] method : void () {
      
      my $goroutine = $goroutine_ref->[0];
      
      my $uv_async = $wait->{uv_async};
      $wait->{uv_async} = undef;
      
      $uv_async->close_safe;
      
      $schedule->enable_goroutine($goroutine);
    };
    
    $uv_loop->async_init($uv_async, $async_cb);
    
    if (my $goroutine = $schedule->{current_goroutine}) {
      $goroutine_ref->[0] = $goroutine;
      my $goroutine_address = Fn->to_address($goroutine);
      $schedule->{disabled_goroutines_h}->{$goroutine_address} = $goroutine;
      $goroutine->{disabled} = 1;
      Go->gosched;
    }
    else {
      my $caller_info = caller;
      my $goroutine = $schedule->{current_goroutine} = $goroutine_ref->[0] = Go::Goroutine->new(method : void () {
        Go->gosched;
      }, undef, $caller_info);
      $schedule->{goroutines}->push($goroutine);
      
      $schedule->run;
      
      $schedule->{schedule_goroutine} = undef;
      
      $schedule->{current_goroutine} = undef;
    }
  }
  
}
