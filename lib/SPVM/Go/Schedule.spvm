class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Channel;
  allow Go::Select;
  allow Go::UV;
  
  use Go::Goroutine;
  use Go::Error::IOTimeout;
  use Go::Time;
  use Go::UV;
  use Go::UV::Loop;
  use Go::UV::Constant as UV_CONST;
  use Go::Schedule::Info;
  
  use Format;
  use List;
  use QList;
  use Thread::ID;
  use Thread::ThisThread;
  
  has goroutines : List of Go::Goroutine;
  
  has current_goroutine : Go::Goroutine;
  
  has disabled_goroutines_h : Hash of Go::Goroutine;
  
  has return_back_goroutine : Go::Goroutine;
  
  has thread_id : Thread::ID;
  
  has uv_loop : Go::UV::Loop;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $goroutines = QList->new(new Go::Goroutine[0]);
    
    $self->{goroutines} = $goroutines;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    $self->{disabled_goroutines_h} = Hash->new;
    
    $self->{uv_loop} = Go::UV::Loop->new;
    
    return $self;
  }
  
  # Instance Methods
  private method schedule : int ($schedule_info : Go::Schedule::Info = undef) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $current_goroutine = $self->{current_goroutine};
    
    if ($current_goroutine) {
      if ($schedule_info) {
        $self->disable_goroutine($current_goroutine, $schedule_info);
      }
      
      my $return_back_goroutine = $self->{return_back_goroutine};
      
      Go::Goroutine->transfer($current_goroutine, $return_back_goroutine);
      
      if ($current_goroutine->{io_timeout_occurred}) {
        $current_goroutine->{io_timeout_occurred} = 0;
        die Go::Error::IOTimeout "IO timeout occur";
      }
      elsif ($current_goroutine->{io_error_occurred}) {
        $current_goroutine->{io_error_occurred} = 0;
        my $io_error_message = $current_goroutine->{io_error_message};
        $current_goroutine->{io_error_message} = undef;
        die $io_error_message;
      }
    }
    else {
      if ($schedule_info) {
        $self->add_task([$self : Go::Schedule, $schedule_info : Go::Schedule::Info] method : void () {
          $self->schedule($schedule_info);
        });
      }
      
      $self->run;
      
      $self->{return_back_goroutine} = undef;
      
      $self->{current_goroutine} = undef;
    }
  }
  
  private method add_task : void ($task : Callback) {
    
    my $goroutine = Go::Goroutine->new($task);
    
    $self->{goroutines}->push($goroutine);
    
    if (Go->ENV_DEBUG) {
      Fn->say_stderr(Format->sprintf("[Go Debug]Push new goroutine with the callback %p.", [(object)$task]));
    }
    
  }
  
  private method awake : void ($goroutine : Go::Goroutine, $uv_handle : Go::UV::Handle) {
    my $goroutine_uv_handle = $goroutine->{uv_handle};
    my $goroutine_timout_uv_timer = $goroutine->{timeout_uv_timer};
    
    if ($goroutine_timout_uv_timer) {
      unless ($uv_handle == $goroutine_uv_handle) {
        # IO timeout
        $goroutine->{io_timeout_occurred} = 1;
      }
      $goroutine_uv_handle->close;
    }
    
    $uv_handle->close;
    
    $self->enable_goroutine($goroutine);
  }
  
  private method disable_goroutine : void ($goroutine : Go::Goroutine, $schedule_info : Go::Schedule::Info) {
    
    my $schedule_type = $schedule_info->{type};
    my $timeout_duration_nsec = $schedule_info->{timeout_duration_nsec};
    my $fd = $schedule_info->{fd};
    my $wait = $schedule_info->{wait};
    my $buffer = $schedule_info->{buffer};
    my $buffer_length = exists $schedule_info->{buffer_length} ? $schedule_info->{buffer_length} : -1;
    my $buffer_offset = $schedule_info->{buffer_offset};
    
    if ($schedule_type == Go::Schedule::Info->TYPE_IO_READ ||$schedule_type == Go::Schedule::Info->TYPE_IO_WRITE) {
      unless ($fd >= 0) {
        die "The file descriptor \$fd in schedule type TYPE_IO_READ or TYPE_IO_WRITE must be a non-negative value.";
      }
      
      my $deadline = (Go::Time)undef;
      if ($timeout_duration_nsec > 0) {
        $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
      }
      my $timeout_msec = $timeout_duration_nsec / 1000000;
      my $events = $schedule_type == Go::Schedule::Info->TYPE_IO_READ ? UV_CONST->UV_READABLE : UV_CONST->UV_WRITABLE;
      
      my $uv_loop = $self->{uv_loop};
      
      my $uv_poll = Go::UV::Handle::Poll->new;
      $uv_loop->poll_init($uv_poll, $fd);
      $goroutine->{uv_handle} = $uv_poll;
      my $poll_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self] method : void ($uv_poll : Go::UV::Handle::Poll, $status : int, $events : int) {
        if ($status < 0) {
          $goroutine->{io_error_occurred} = 1;
          my $io_error_message = Go::UV->strerror($status);
          $goroutine->{io_error_message} = $io_error_message;
        }
        $schedule->awake($goroutine, $uv_poll);
      };
      
      $uv_poll->start($poll_cb, $events);
      
      if ($timeout_msec > 0) {
        my $uv_timer = Go::UV::Handle::Timer->new;
        $uv_loop->timer_init($uv_timer);
        $goroutine->{timeout_uv_timer} = $uv_timer;
        my $timer_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self] method : void ($uv_timer : Go::UV::Handle::Timer) {
          $schedule->awake($goroutine, $uv_timer);
        };
        $uv_timer->start($timer_cb, $timeout_msec);
      }
      
      if (Go->ENV_DEBUG) {
        Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for IO (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
      }
    }
    elsif ($schedule_type == Go::Schedule::Info->TYPE_PIPE_READ ||$schedule_type == Go::Schedule::Info->TYPE_PIPE_WRITE) {
      
      unless ($goroutine->{uv_write}) {
        $goroutine->{uv_write} = Go::UV::Request::Write->new;
      }
      
      unless ($fd >= 0) {
        die "The file descriptor \$fd in schedule type TYPE_PIPE_READ or TYPE_PIPE_WRITE must be a non-negative value.";
      }
      
      my $deadline = (Go::Time)undef;
      if ($timeout_duration_nsec > 0) {
        $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
      }
      my $timeout_msec = $timeout_duration_nsec / 1000000;
      
      my $uv_loop = $self->{uv_loop};
      
      my $uv_pipe = Go::UV::Handle::Pipe->new;
      my $ipc = 0;
      $uv_loop->pipe_init($uv_pipe, $ipc);
      $uv_pipe->open($fd);
      $goroutine->{uv_handle} = $uv_pipe;
      
      if ($schedule_type == Go::Schedule::Info->TYPE_PIPE_READ) {
        my $read_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self, $schedule_info : Go::Schedule::Info] method : void ($uv_stream : Go::UV::Handle::Stream, $nread : int, $buffer : string) {
          if ($nread < 0) {
            $goroutine->{io_error_occurred} = 1;
            my $io_error_message = Go::UV->strerror($nread);
            $goroutine->{io_error_message} = $io_error_message;
          }
          $schedule_info->{ret_length} = $nread;
          $schedule->awake($goroutine, $uv_stream);
        };
        
        $uv_pipe->read_start((mutable string)$buffer, $buffer_length, $read_cb);
      }
      else {
        my $write_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self, $schedule_info : Go::Schedule::Info, $buffer_length : int, $uv_pipe : Go::UV::Handle::Pipe] method : void ($uv_req : Go::UV::Request::Write, $status : int) {
          if ($status < 0) {
            $goroutine->{io_error_occurred} = 1;
            my $io_error_message = Go::UV->strerror($status);
            $goroutine->{io_error_message} = $io_error_message;
          }
          $schedule_info->{ret_length} = $buffer_length;
          $schedule->awake($goroutine, $uv_pipe);
        };
        
        $uv_pipe->write($goroutine->{uv_write}, $buffer, $buffer_length, $write_cb);
      }
      
      if ($timeout_msec > 0) {
        my $uv_timer = Go::UV::Handle::Timer->new;
        $uv_loop->timer_init($uv_timer);
        $goroutine->{timeout_uv_timer} = $uv_timer;
        my $timer_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self] method : void ($uv_timer : Go::UV::Handle::Timer) {
          $schedule->awake($goroutine, $uv_timer);
        };
        $uv_timer->start($timer_cb, $timeout_msec);
      }
      
      if (Go->ENV_DEBUG) {
        Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for pipe (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
      }
    }
    elsif ($schedule_type == Go::Schedule::Info->TYPE_TIMER) {
      my $deadline = (Go::Time)undef;
      if ($timeout_duration_nsec > 0) {
        $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
      }
      
      my $timeout_msec = $timeout_duration_nsec / 1000000;
      my $uv_loop = $self->{uv_loop};
      my $uv_timer = Go::UV::Handle::Timer->new;
      $uv_loop->timer_init($uv_timer);
      $goroutine->{uv_handle} = $uv_timer;
      my $timer_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self] method : void ($uv_timer : Go::UV::Handle::Timer) {
        $schedule->awake($goroutine, $uv_timer);
      };
      $uv_timer->start($timer_cb, $timeout_msec);
      
      unless ($deadline) {
        die "The deadline \$deadline in schedule type TYPE_TIMER must be defined.";
      }
      
      if (Go->ENV_DEBUG) {
        Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for timer (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
      }
    }
    elsif ($schedule_type == Go::Schedule::Info->TYPE_CHANNEL_READ ||$schedule_type == Go::Schedule::Info->TYPE_CHANNEL_WRITE) {
      my $uv_loop = $self->{uv_loop};
      my $uv_async = Go::UV::Handle::Async->new;
      $goroutine->{uv_handle} = $uv_async;
      my $async_cb = [$goroutine : Go::Goroutine, $schedule : Go::Schedule = $self] method : void ($uv_timer : Go::UV::Handle::Async) {
        $schedule->awake($goroutine, $uv_timer);
      };
      $uv_loop->async_init($uv_async, $async_cb);
    }
    
    my $goroutine_address = Fn->to_address($goroutine);
    if ($self->{disabled_goroutines_h}->{$goroutine_address}) {
      die "[Unexpected Error]Disabled goroutine already exists.";
    }
    $self->{disabled_goroutines_h}->{$goroutine_address} = $goroutine;
    $goroutine->{disabled} = 1;
  }
  
  private method enable_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{disabled} = 0;
    $goroutine->{uv_handle} = undef;
    $goroutine->{timeout_uv_timer} = undef;
    $self->{disabled_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{goroutines}->push($goroutine);
  }
  
  private method process_next_goroutine : void () {
    
    my $goroutines = $self->{goroutines};
    
    unless (@$goroutines > 0) {
      return;
    }
    
    my $goroutine = $goroutines->shift;
    
    if ($goroutine->{finished}) {
      if (Go->ENV_DEBUG) {
        diag Fn->sprintf("[Go Debug]Finish goroutine. \$task=%p.", $goroutine->{task});
      }
    }
    else {
      if ($goroutine->{disabled}) {
        if (Go->ENV_DEBUG) {
         diag Fn->sprintf("[Go Debug]Skip disabled goroutine. \$task=%p.", $goroutine->{task});
        }
      }
      else {
        if (Go->ENV_DEBUG) {
          diag Fn->sprintf("[Go Debug]Restart goroutine. \$task=%p.", $goroutine->{task});
        }
        
        $goroutines->push($goroutine);
        
        my $return_back_goroutine = $self->{return_back_goroutine};
        
        $goroutine->{return_back} = $return_back_goroutine;
        
        $self->{current_goroutine} = $goroutine;
        
        Go::Goroutine->transfer($return_back_goroutine, $goroutine);
      }
    }
  }
  
  private method run : void () {
    
    my $return_back_goroutine = Go::Goroutine->new;
    
    $self->{return_back_goroutine} = $return_back_goroutine;
    
    my $uv_loop = $self->{uv_loop};
    
    my $process_next_goroutine_cb = [$schedule : Go::Schedule = $self] method : void ($uv_idle : Go::UV::Handle::Idle) {
      $schedule->process_next_goroutine;
      
      unless ($schedule->loop_alive) {
        $uv_idle->close;
      }
    };
    
    my $uv_idle = Go::UV::Handle::Idle->new;
    $uv_loop->idle_init($uv_idle);
    $uv_idle->start($process_next_goroutine_cb);
    
    $uv_loop->run(UV_CONST->UV_RUN_DEFAULT);
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{disabled_goroutines_h}->keys_length;
      
    return $all_goroutines_length ? 1 : 0;
  }

}
