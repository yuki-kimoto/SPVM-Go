class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Channel;
  allow Go::Select;
  allow Go::OS::Exec;
  allow Go::OS::Exec::Cmd;
  
  use Go::Goroutine;
  use Go::Error::IOTimeout;
  use Go::Time;
  use Go::Schedule::Info;
  use UV;
  use UV::Loop;
  use UV::Constant as UV_C;
  
  use Format;
  use List;
  use QList;
  use Thread::ID;
  use Thread::ThisThread;
  use Sys::IO;
  use Sys::Signal::Constant as SIGNAL_C;
  
  has goroutines : List of Go::Goroutine;
  
  has current_goroutine : Go::Goroutine;
  
  has disabled_goroutines_h : Hash of Go::Goroutine;
  
  has schedule_goroutine : Go::Goroutine;
  
  has thread_id : Thread::ID;
  
  has uv_loop : UV::Loop;
  
  has uv_poll_goroutines_h : Hash of Go::Goroutine;
  
  has uv_pipe_goroutines_h : Hash of Go::Goroutine;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $goroutines = QList->new(new Go::Goroutine[0]);
    
    $self->{goroutines} = $goroutines;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    $self->{disabled_goroutines_h} = Hash->new;
    
    $self->{uv_loop} = UV::Loop->new;
    
    $self->{uv_poll_goroutines_h} = Hash->new;
    
    $self->{uv_pipe_goroutines_h} = Hash->new;
    
    return $self;
  }
  
  # Instance Methods
  private method schedule : int ($schedule_info : Go::Schedule::Info, $caller_info : CallerInfo = undef) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $current_goroutine = $self->{current_goroutine};
    
    if ($current_goroutine) {
      unless ($schedule_info->{type} == Go::Schedule::Info->TYPE_NONE) {
        $self->disable_goroutine($current_goroutine, $schedule_info);
      }
      
      my $schedule_goroutine = $self->{schedule_goroutine};
      
      Go::Goroutine->transfer($current_goroutine, $schedule_goroutine);
    }
    else {
      unless ($schedule_info->{type} == Go::Schedule::Info->TYPE_NONE) {
        $self->add_task([$self : , $schedule_info : , $caller_info : ] method : void () {
          $self->schedule($schedule_info, $caller_info);
        }, $caller_info);
      }
      
      $self->run;
      
      $self->{schedule_goroutine} = undef;
      
      $self->{current_goroutine} = undef;
    }
    
    if ($schedule_info->{error_id}) {
      my $error_id = $schedule_info->{error_id};
      my $exception = $schedule_info->{exception};
      die $error_id, $exception;
    }
  }
  
  private method add_task : void ($task : Callback, $caller_info : CallerInfo) {
    
    my $goroutine = Go::Goroutine->new($task, undef, $caller_info);
    
    $self->{goroutines}->push($goroutine);
    
    if (Go->ENV_DEBUG) {
      Fn->say_stderr(Format->sprintf("[Go Debug]Push new goroutine with the callback %p.", [(object)$task]));
    }
    
  }
  
  private method awake : void ($goroutine : Go::Goroutine, $uv_handle : UV::Handle, $schedule_info : Go::Schedule::Info = undef) {
    my $goroutine_uv_handle = $goroutine->{uv_handle};
    my $goroutine_timout_uv_timer = $goroutine->{timeout_uv_timer};
    
    if ($goroutine_timout_uv_timer) {
      unless ($uv_handle == $goroutine_uv_handle) {
        # IO timeout
        $schedule_info->{error_id} = basic_type_id Go::Error::IOTimeout;
        $schedule_info->{exception} = "IO timeout occur";
      }
      $goroutine_timout_uv_timer->stop;
      $goroutine_uv_handle->close_safe;
    }
    
    $uv_handle->close_safe;
    
    $self->enable_goroutine($goroutine);
  }
  
  private method disable_goroutine : void ($goroutine : Go::Goroutine, $schedule_info : Go::Schedule::Info) {
    
    my $schedule_type = $schedule_info->{type};
    switch ($schedule_type) {
      case Go::Schedule::Info->TYPE_IO_READ:
      case Go::Schedule::Info->TYPE_IO_WRITE:
      {
        my $timeout_duration_nsec = $schedule_info->{timeout_duration_nsec};
        my $fd = $schedule_info->{fd};
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_IO_READ or TYPE_IO_WRITE must be a non-negative value.";
        }
        
        my $deadline = (Go::Time)undef;
        if ($timeout_duration_nsec > 0) {
          $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
        }
        my $timeout_msec = $timeout_duration_nsec / 1000000;
        my $events = $schedule_type == Go::Schedule::Info->TYPE_IO_READ ? UV_C->UV_READABLE : UV_C->UV_WRITABLE;
        
        my $uv_loop = $self->{uv_loop};
        
        my $uv_poll = UV::Handle::Poll->new;
        $uv_loop->poll_init($uv_poll, $fd);
        $goroutine->{uv_handle} = $uv_poll;
        my $poll_cb = [$goroutine : , $self : , $schedule_info : , $fd : ] method : void ($uv_poll : UV::Handle::Poll, $status : int, $events : int) {
          if ($status < 0) {
            $schedule_info->{error_id} = basic_type_id Error;
            $schedule_info->{exception} = UV->strerror($status);
          }
          
          $self->{uv_poll_goroutines_h}->delete("$fd");
          $uv_poll->stop;
          $self->awake($goroutine, $uv_poll, $schedule_info);
        };
        
        $uv_poll->start($poll_cb, $events);
        $self->{uv_poll_goroutines_h}{"$fd"} = $goroutine;
        
        if ($timeout_msec > 0) {
          my $uv_timer = UV::Handle::Timer->new;
          $uv_loop->timer_init($uv_timer);
          $goroutine->{timeout_uv_timer} = $uv_timer;
          my $timer_cb = [$goroutine : , $self : , $schedule_info : , $fd : ] method : void ($uv_timer : UV::Handle::Timer) {
            $self->{uv_poll_goroutines_h}->delete("$fd");
            $uv_timer->stop;
            $self->awake($goroutine, $uv_timer, $schedule_info);
          };
          $uv_timer->start($timer_cb, $timeout_msec);
        }
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for IO (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
        }
      }
      case Go::Schedule::Info->TYPE_IO_CANCEL:
      {
        my $fd = $schedule_info->{fd};
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_IO_CANCEL must be a non-negative value.";
        }
        
        my $uv_poll_goroutine = $self->{uv_poll_goroutines_h}{"$fd"};
        
        if ($uv_poll_goroutine) {
          if ($uv_poll_goroutine->{uv_handle}) {
            $uv_poll_goroutine->{uv_handle}->close_safe;
          }
          if ($uv_poll_goroutine->{timeout_uv_timer}) {
            $uv_poll_goroutine->{timeout_uv_timer}->close_safe;
          }
          
          $self->{uv_poll_goroutines_h}->delete("$fd");
          $self->enable_goroutine($uv_poll_goroutine);
        }
        
        return;
      }
      case Go::Schedule::Info->TYPE_PIPE_READ:
      case Go::Schedule::Info->TYPE_PIPE_WRITE:
      {
        my $timeout_duration_nsec = $schedule_info->{timeout_duration_nsec};
        my $fd = $schedule_info->{fd};
        my $buffer = $schedule_info->{buffer};
        my $buffer_length = $schedule_info->{buffer_length};
        if ($buffer_length < 0) {
          $buffer_length = length $buffer;
        }
        my $buffer_offset = $schedule_info->{buffer_offset};
        
        unless ($goroutine->{uv_write}) {
          $goroutine->{uv_write} = UV::Request::Write->new;
        }
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_PIPE_READ or TYPE_PIPE_WRITE must be a non-negative value.";
        }
        
        my $deadline = (Go::Time)undef;
        if ($timeout_duration_nsec > 0) {
          $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
        }
        my $timeout_msec = $timeout_duration_nsec / 1000000;
        
        my $uv_loop = $self->{uv_loop};
        
        my $uv_pipe = UV::Handle::Pipe->new;
        my $ipc = 0;
        $uv_loop->pipe_init($uv_pipe, $ipc);
        my $fd_dup = Sys::IO->dup($fd);
        $uv_pipe->open($fd_dup);
        $goroutine->{uv_handle} = $uv_pipe;
        
        if ($schedule_type == Go::Schedule::Info->TYPE_PIPE_READ) {
          my $read_cb = [$goroutine : , $self : , $schedule_info : , $fd : ] method : void ($uv_stream : UV::Handle::Stream, $nread : int, $buffer : string) {
            if ($nread < 0) {
              $schedule_info->{error_id} = basic_type_id Error;
              $schedule_info->{exception} = UV->strerror($nread);
            }
            $schedule_info->{ret_length} = $nread;
            $self->{uv_pipe_goroutines_h}->delete("$fd");
            $uv_stream->read_stop;
            $self->awake($goroutine, $uv_stream, $schedule_info);
          };
          
          $uv_pipe->read_start((mutable string)$buffer, $buffer_length, $read_cb, $buffer_offset);
        }
        else {
          my $write_cb = [$goroutine : , $self : , $schedule_info : , $buffer_length : , $uv_pipe : , $fd : ] method : void ($uv_req_write : UV::Request::Write, $status : int) {
            if ($status < 0) {
              $schedule_info->{error_id} = basic_type_id Error;
              $schedule_info->{exception} = UV->strerror($status);
            }
            $schedule_info->{ret_length} = $buffer_length;
            $self->{uv_pipe_goroutines_h}->delete("$fd");
            $self->awake($goroutine, $uv_pipe, $schedule_info);
            $uv_req_write->set_write_cb(undef);
          };
          
          $goroutine->{uv_write}->write($uv_pipe, $buffer, $buffer_length, $write_cb, $buffer_offset);
        }
        $self->{uv_pipe_goroutines_h}{"$fd"} = $goroutine;
        
        if ($timeout_msec > 0) {
          my $uv_timer = UV::Handle::Timer->new;
          $uv_loop->timer_init($uv_timer);
          $goroutine->{timeout_uv_timer} = $uv_timer;
          my $timer_cb = [$goroutine : , $self : , $schedule_info : , $fd : ] method : void ($uv_timer : UV::Handle::Timer) {
            $self->{uv_pipe_goroutines_h}->delete("$fd");
            $uv_timer->stop;
            $self->awake($goroutine, $uv_timer, $schedule_info);
          };
          $uv_timer->start($timer_cb, $timeout_msec);
        }
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for pipe (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
        }
      }
      case Go::Schedule::Info->TYPE_PIPE_CANCEL:
      {
        my $fd = $schedule_info->{fd};
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_PIPE_CANCEL must be a non-negative value.";
        }
        
        my $uv_pipe_goroutine = $self->{uv_pipe_goroutines_h}{"$fd"};
        
        if ($uv_pipe_goroutine) {
          if ($uv_pipe_goroutine->{uv_handle}) {
            $uv_pipe_goroutine->{uv_handle}->close_safe;
          }
          if ($uv_pipe_goroutine->{timeout_uv_timer}) {
            $uv_pipe_goroutine->{timeout_uv_timer}->close_safe;
          }
          
          $self->{uv_pipe_goroutines_h}->delete("$fd");
          $self->enable_goroutine($uv_pipe_goroutine);
        }
        
        return;
      }
      case Go::Schedule::Info->TYPE_TIMER:
      {
        my $timeout_duration_nsec = $schedule_info->{timeout_duration_nsec};
        my $fd = $schedule_info->{fd};
        
        my $deadline = (Go::Time)undef;
        if ($timeout_duration_nsec > 0) {
          $deadline = Go::Time->now->add(Go::Duration_1l->new($timeout_duration_nsec));
        }
        
        my $timeout_msec = $timeout_duration_nsec / 1000000;
        my $uv_loop = $self->{uv_loop};
        my $uv_timer = UV::Handle::Timer->new;
        $uv_loop->timer_init($uv_timer);
        $goroutine->{uv_handle} = $uv_timer;
        my $timer_cb = [$goroutine : , $self : , $schedule_info : ] method : void ($uv_timer : UV::Handle::Timer) {
          $uv_timer->stop;
          $self->awake($goroutine, $uv_timer, $schedule_info);
        };
        $uv_timer->start($timer_cb, $timeout_msec);
        
        unless ($deadline) {
          die "The deadline \$deadline in schedule type TYPE_TIMER must be defined.";
        }
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for timer (Callback:%p, QueueNum:%d.)", [(object)$goroutine->{task}, $self->{goroutines}->length]));
        }
      }
      case Go::Schedule::Info->TYPE_CHANNEL_READ:
      case Go::Schedule::Info->TYPE_CHANNEL_WRITE:
      {
        my $wait = $schedule_info->{wait};
        
        my $uv_loop = $self->{uv_loop};
        my $uv_async = UV::Handle::Async->new;
        $goroutine->{uv_handle} = $uv_async;
        my $async_cb = [$goroutine : , $self : , $schedule_info : ] method : void ($uv_async : UV::Handle::Async) {
          $self->awake($goroutine, $uv_async, $schedule_info);
        };
        $uv_loop->async_init($uv_async, $async_cb);
      }
      case Go::Schedule::Info->TYPE_PROCESS_WAIT:
      {
        my $exec_cmd = $schedule_info->{process_exec_cmd};
        
        unless ($exec_cmd) {
          die "The exec_cmd in schedule type TYPE_PROCESS_WAIT must be defined.";
        }
        
        if ($schedule_info->{timeout_duration_nsec} != 0) {
          die "The timeout_duration_nsec in schedule type TYPE_PROCESS_WAIT must be zero.";
        }
        
        my $finished_ref = [0];
        
        my $uv_loop = $self->{uv_loop};
        
        my $options = $exec_cmd->to_uv_process_options;
        
        my $uv_process = UV::Handle::Process->new;
        $goroutine->{uv_handle} = $uv_process;
        
        my $exit_cb = [$goroutine : , $self : , $schedule_info : , $finished_ref : ] method : void ($uv_proc : UV::Handle::Process, $exit_status : long, $term_signal : int) {
          $schedule_info->{process_exit_status} = $exit_status;
          $schedule_info->{process_term_signal} = $term_signal;
          $self->awake($goroutine, $uv_proc, $schedule_info);
        };
        
        $options->set_exit_cb($exit_cb);
        
        $uv_loop->spawn($uv_process, $options);
        
        my $context = $exec_cmd->{context};
        if ($context) {
          my $deadline = $context->deadline;
          if ($deadline) {
            my $now = Go::Time->now;
            my $duration = $deadline->sub($now);
            my $duration_nsec = $duration->{nsec};
            if ($duration_nsec < 0) {
              $duration_nsec = 0L;
            }
            my $timeout_msec = $duration_nsec / 1_000_000;
            
            my $uv_timer = UV::Handle::Timer->new;
            $uv_loop->timer_init($uv_timer);
            $goroutine->{timeout_uv_timer} = $uv_timer;
            my $timer_cb = [$goroutine : , $self : , $schedule_info : , $uv_process : , $finished_ref : ] method : void ($uv_timer : UV::Handle::Timer) {
              if (!$finished_ref->[0]) {
                $finished_ref->[0] = 1;
                $uv_process->kill(SIGNAL_C->SIGKILL);
                $uv_timer->close_safe;
                $goroutine->{timeout_uv_timer} = undef;
              }
            };
            $uv_timer->start($timer_cb, (long)$timeout_msec);
          }

          my $done = $context->done;
          if ($done) {
            Go->go([$done : , $uv_process : , $self : , $schedule_info : , $goroutine : , $finished_ref : ] method : void () {
              $done->read;
              if (!$finished_ref->[0]) {
                $finished_ref->[0] = 1;
                $uv_process->kill(SIGNAL_C->SIGKILL);
              }
            });
          }
        }
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr("[Go Debug]Register goroutine wait for process.");
        }
      }
    }
    
    my $goroutine_address = Fn->to_address($goroutine);
    $self->{disabled_goroutines_h}->{$goroutine_address} = $goroutine;
    $goroutine->{disabled} = 1;
  }
  
  private method enable_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{disabled} = 0;
    $goroutine->{uv_handle} = undef;
    $goroutine->{timeout_uv_timer} = undef;
    $self->{disabled_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{goroutines}->push($goroutine);
  }
  
  private method process_next_goroutine : void () {
    
    my $goroutines = $self->{goroutines};
    
    unless (@$goroutines > 0) {
      return;
    }
    
    my $goroutine = $goroutines->shift;
    
    if ($goroutine->{finished}) {
      if (Go->ENV_DEBUG) {
        diag Fn->sprintf("[Go Debug]Finish goroutine. \$task=%p.", $goroutine->{task});
      }
    }
    else {
      if ($goroutine->{disabled}) {
        if (Go->ENV_DEBUG) {
         diag Fn->sprintf("[Go Debug]Skip disabled goroutine. \$task=%p.", $goroutine->{task});
        }
      }
      else {
        if (Go->ENV_DEBUG) {
          diag Fn->sprintf("[Go Debug]Restart goroutine. \$task=%p.", $goroutine->{task});
        }
        
        $goroutines->push($goroutine);
        
        my $schedule_goroutine = $self->{schedule_goroutine};
        
        $goroutine->{schedule_goroutine} = $schedule_goroutine;
        
        $self->{current_goroutine} = $goroutine;
        
        Go::Goroutine->transfer($schedule_goroutine, $goroutine);
      }
    }
  }
  
  private method run : void () {
    
    my $process_next_goroutine_cb = [$self : ] method : void ($uv_idle : UV::Handle::Idle) {
      $self->process_next_goroutine;
      
      unless ($self->loop_alive) {
        $uv_idle->close_safe;
      }
    };
    
    my $schedule_goroutine = Go::Goroutine->new;
    
    $self->{schedule_goroutine} = $schedule_goroutine;
    
    my $uv_loop = $self->{uv_loop};
    my $uv_idle = UV::Handle::Idle->new;
    $uv_loop->idle_init($uv_idle);
    $uv_idle->start($process_next_goroutine_cb);
    
    $uv_loop->run(UV_C->UV_RUN_DEFAULT);
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{disabled_goroutines_h}->keys_length;
      
    return $all_goroutines_length ? 1 : 0;
  }

}
