class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Schedule::Task;
  allow Go::Channel;
  allow Go::Select;
  allow Go::UV;
  
  use Go::Goroutine;
  use Go::Schedule::Task;
  use Go::Error::IOTimeout;
  use Go::Time;
  use Go::UV;
  
  use Format;
  use List;
  use QList;
  use Thread::ID;
  use Thread::ThisThread;
  
  private enum {
    TYPE_NONE,
    TYPE_IO_READ,
    TYPE_IO_WRITE,
    TYPE_TIMER,
    TYPE_CHANNEL_READ,
    TYPE_CHANNEL_WRITE,
  }
  
  has goroutines : List of Go::Goroutine;
  
  has current_goroutine : Go::Goroutine;
  
  has schedule_task_goroutine : Go::Goroutine;
  
  has thread_id : Thread::ID;
  
  has uv : Go::UV;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $goroutines = QList->new(new Go::Goroutine[0]);
    
    $self->{goroutines} = $goroutines;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    my $uv = Go::UV->new;
    
    $self->{uv} = $uv;
    
    $uv->{schedule} = $self;
    weaken $uv->{schedule};
    
    return $self;
  }
  
  # Instance Methods
  private method schedule_io_read : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_READ;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_io_write : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_WRITE;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_sleep : int ($io_timeout_duration_nsec : long) {
    
    my $schedule_type = &TYPE_TIMER;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec);
  }
  
  private method schedule_channel_read : void ($read_wait : Go::Channel::Wait) {
    
    my $schedule_type = &TYPE_CHANNEL_READ;
    
    $self->schedule($schedule_type, 0, -1, $read_wait);
  }
  
  private method schedule_channel_write : void ($write_wait : Go::Channel::Wait) {
    
    my $schedule_type = &TYPE_CHANNEL_WRITE;
    
    $self->schedule($schedule_type, 0, -1, $write_wait);
  }
  
  private method schedule : int ($schedule_type : int = 0, $io_timeout_duration_nsec : long = 0, $fd : int = -1, $wait : Go::Channel::Wait = undef) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $deadline = (Go::Time)undef;
    if ($io_timeout_duration_nsec > 0) {
      $deadline = Go::Time->now->add(Go::Duration_1l->new($io_timeout_duration_nsec));
    }
    
    my $current_goroutine = $self->{current_goroutine};
    
    if ($current_goroutine) {
      my $schedule_task_goroutine = $self->{schedule_task_goroutine};
      
      $current_goroutine->{fd} = $fd;
      $current_goroutine->{schedule_type} = (byte)$schedule_type;
      $current_goroutine->{deadline} = $deadline;
      
      my $current_goroutine_address = Fn->to_address($current_goroutine);
      if ($schedule_type == &TYPE_IO_READ ||$schedule_type == &TYPE_IO_WRITE) {
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_IO_READ or TYPE_IO_WRITE must be a non-negative value.";
        }
        
        $current_goroutine->{disabled} = 1;
        if ($self->{uv}{disabled_goroutines_h}->{$current_goroutine_address}) {
          die "[Unexpected Error]Disabled IO wait goroutine already exists.";
        }
        if ($self->{uv}{disabled_goroutines_h}->{$current_goroutine_address}) {
          die "[Unexpected Error]Disabled Timer wait goroutine already exists.";
        }
        $self->{uv}{disabled_goroutines_h}->{$current_goroutine_address} = $current_goroutine;
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for IO (Callback:%p, QueueNum:%d.)", [(object)$current_goroutine->{task}, $self->{goroutines}->length]));
        }
      }
      elsif ($schedule_type == &TYPE_TIMER) {
        unless ($deadline) {
          die "The deadline \$deadline in schedule type TYPE_TIMER must be defined.";
        }
        
        $current_goroutine->{disabled} = 1;
        
        if ($self->{uv}{disabled_goroutines_h}->{$current_goroutine_address}) {
          die "[Unexpected Error]Disabled IO wait goroutine already exists.";
        }
        if ($self->{uv}{disabled_goroutines_h}->{$current_goroutine_address}) {
          die "[Unexpected Error]Disabled Timer wait goroutine already exists.";
        }
        
        $self->{uv}{disabled_goroutines_h}->{$current_goroutine_address} = $current_goroutine;
      }
      elsif ($schedule_type == &TYPE_CHANNEL_READ) {
        $current_goroutine->{disabled} = 1;
      }
      elsif ($schedule_type == &TYPE_CHANNEL_WRITE) {
        $current_goroutine->{disabled} = 1;
      }
      
      Go::Goroutine->transfer($current_goroutine, $schedule_task_goroutine);
      
      if ($current_goroutine->{io_wait_over_deadline}) {
        $current_goroutine->{io_wait_over_deadline} = 0;
        die Go::Error::IOTimeout "IO timeout occur";
      }
    }
    else {
      unless ($schedule_type == &TYPE_NONE) {
        $self->add_task([$self : Go::Schedule, $schedule_type : int, $io_timeout_duration_nsec : long, $fd : int] method : void () {
          $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
        });
      }
      
      $self->run;
      
      $self->{schedule_task_goroutine} = undef;
      
      $self->{current_goroutine} = undef;
    }
  }
  
  private method add_task : void ($task : Callback) {
    
    my $goroutine = Go::Goroutine->new($task);
    
    $self->{goroutines}->push($goroutine);
    
    if (Go->ENV_DEBUG) {
      Fn->say_stderr(Format->sprintf("[Go Debug]Push new goroutine with the callback %p.", [(object)$task]));
    }
    
  }
  
  private method enable_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{fd} = -1;
    $goroutine->{deadline} = undef;
    $goroutine->{disabled} = 0;
    $goroutine->{schedule_type} = Go::Schedule->TYPE_NONE;
    $self->{uv}{disabled_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{goroutines}->push($goroutine);
  }
  
  private method run : void () {
    
    my $shcedule_cb = [$self : Go::Schedule] method : void () {
      
      my $schedule_task = Go::Schedule::Task->new;
      $schedule_task->{schedule} = $self;
      
      my $start_goroutine = Go::Goroutine->new;
      
      my $schedule_task_goroutine = Go::Goroutine->new($schedule_task);
      
      $schedule_task_goroutine->{return_back} = $start_goroutine;
      
      $self->{schedule_task_goroutine} = $schedule_task_goroutine;
      
      Go::Goroutine->transfer($start_goroutine, $schedule_task_goroutine);
    };
    
    my $enable_goroutine_cb = [$self : Go::Schedule] method : void ($goroutine : Go::Goroutine) {
      
      $self->enable_goroutine($goroutine);
    };
    
    $self->{uv}->run($shcedule_cb, $enable_goroutine_cb);
  }
  
}
