class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Schedule::Task;
  allow Go::Channel;
  allow Go::Select;
  allow Go::Poll;
  
  use Go::Coroutine;
  use List;
  use QList;
  use Go::Schedule::Task;
  use Sys::Time;
  use Go::Poll;
  use Thread::ID;
  use Thread::ThisThread;
  use Go::Error::IOTimeout;
  use Error::System;
  use Time::HiRes;
  use Sys::Time::Util;
  use Sys::Time::Constant as TIME;
  use Format;
  
  private enum {
    TYPE_NONE,
    TYPE_IO_READ,
    TYPE_IO_WRITE,
    TYPE_SLEEP,
  }
  
  has coroutines : List of Go::Coroutine;
  
  has current_coroutine : Go::Coroutine;
  
  has schedule_task_coroutine : Go::Coroutine;
  
  has poll : Go::Poll;
  
  has thread_id : Thread::ID;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $coroutines = QList->new(new Go::Coroutine[0]);
    
    $self->{coroutines} = $coroutines;
    
    $self->{poll} = Go::Poll->new;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    return $self;
  }
  
  # Instance Methods
  private method schedule_io_read : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_READ;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_io_write : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_WRITE;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_sleep : int ($io_timeout_duration_nsec : long) {
    
    my $schedule_type = &TYPE_SLEEP;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec);
  }
  
  private method schedule : int ($schedule_type : int = 0, $io_timeout_duration_nsec : long = 0, $fd : int = -1) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $deadline = (Go::Time)undef;
    if ($io_timeout_duration_nsec > 0) {
      $deadline = Go::Time->now->add(Go::Duration_1l->new($io_timeout_duration_nsec));
    }
    
    my $current_coroutine = $self->{current_coroutine};
    
    if ($current_coroutine) {
      my $schedule_task_coroutine = $self->{schedule_task_coroutine};
      
      $current_coroutine->{fd} = $fd;
      $current_coroutine->{schedule_type} = (byte)$schedule_type;
      $current_coroutine->{deadline} = $deadline;
      
      Go::Coroutine->transfer($current_coroutine, $schedule_task_coroutine);
      
      if ($current_coroutine->{is_over_deadline}) {
        $current_coroutine->{is_over_deadline} = 0;
        die Go::Error::IOTimeout "IO timeout occur";
      }
    }
    else {
      unless ($schedule_type == &TYPE_NONE) {
        $self->add_task([$self : Go::Schedule, $schedule_type : int, $io_timeout_duration_nsec : long, $fd : int] method : void () {
          $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
        });
      }
      
      my $idle_cb = [$self : Go::Schedule] method : void () {
        my $schedule_task = Go::Schedule::Task->new;
        
        my $return_back = Go::Coroutine->new;
        
        $schedule_task->{schedule} = $self;
        
        my $schedule_task_coroutine = Go::Coroutine->new($schedule_task);
        
        $schedule_task_coroutine->{return_back} = $return_back;
        
        $self->{schedule_task_coroutine} = $schedule_task_coroutine;
        
        Go::Coroutine->transfer($return_back, $schedule_task_coroutine);
      };
      
      my $poll = $self->{poll};
      
      while (1) {
        
        $poll->check;
        
        $idle_cb->();
        
        my $coroutines = $self->{coroutines};
        
        if ($coroutines->length == 0) {
          last;
        }
      }
      
      $self->{schedule_task_coroutine} = undef;
      
      $self->{current_coroutine} = undef;
    }
  }
  
  private method add_task : void ($task : Callback) {
    
    my $coroutine = Go::Coroutine->new($task);
    
    $self->{coroutines}->push($coroutine);
    
    if (Go->ENV_DEBUG) {
      Fn->say_stderr(Format->sprintf("[Go Debug]Push new goroutine with the callback %p.", [(object)$task]));
    }
    
  }
  
}
