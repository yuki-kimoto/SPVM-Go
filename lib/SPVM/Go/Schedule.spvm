class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Channel;
  allow Go::Select;
  allow Go::OS::Exec;
  allow Go::OS::Exec::Cmd;
  
  use Go::Goroutine;
  use Go::Error::IOTimeout;
  use Go::Time;
  use Go::Schedule::Info;
  use UV;
  use UV::Loop;
  use UV::Constant as UV_C;
  
  use Format;
  use List;
  use QList;
  use Thread::ID;
  use Thread::ThisThread;
  use Sys::IO;
  use Sys::Signal::Constant as SIGNAL_C;
  use Go::Schedule::Callback::Finish;
  
  has goroutines : List of Go::Goroutine;
  
  has current_goroutine : Go::Goroutine;
  
  has disabled_goroutines_h : Hash of Go::Goroutine;
  
  has schedule_goroutine : Go::Goroutine;
  
  has thread_id : Thread::ID;
  
  has uv_loop : UV::Loop;
  
  has uv_poll_finish_cbs_h : Hash of Go::Schedule::Callback::Finish;
  
  has uv_pipe_finish_cbs_h : Hash of Go::Schedule::Callback::Finish;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $goroutines = QList->new(new Go::Goroutine[0]);
    
    $self->{goroutines} = $goroutines;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    $self->{disabled_goroutines_h} = Hash->new;
    
    $self->{uv_loop} = UV::Loop->new;
    
    $self->{uv_poll_finish_cbs_h} = Hash->new;
    
    $self->{uv_pipe_finish_cbs_h} = Hash->new;
    
    return $self;
  }
  
  # Instance Methods
  private method schedule : int ($schedule_info : Go::Schedule::Info, $caller_info : CallerInfo = undef) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $current_goroutine = $self->{current_goroutine};
    
    if ($current_goroutine) {
      unless ($schedule_info->{type} == Go::Schedule::Info->TYPE_NONE) {
        $self->disable_goroutine($current_goroutine, $schedule_info);
      }
      
      my $schedule_goroutine = $self->{schedule_goroutine};
      
      Go::Goroutine->transfer($current_goroutine, $schedule_goroutine);
    }
    else {
      unless ($schedule_info->{type} == Go::Schedule::Info->TYPE_NONE) {
        $self->add_task([$self : , $schedule_info : , $caller_info : ] method : void () {
          $self->schedule($schedule_info, $caller_info);
        }, $caller_info);
      }
      
      $self->run;
      
      $self->{schedule_goroutine} = undef;
      
      $self->{current_goroutine} = undef;
    }
    
    if ($schedule_info->{error_id}) {
      my $error_id = $schedule_info->{error_id};
      my $exception = $schedule_info->{exception};
      die $error_id, $exception;
    }
  }
  
  private method add_task : void ($task : Callback, $caller_info : CallerInfo) {
    
    my $goroutine = Go::Goroutine->new($task, undef, $caller_info);
    
    $self->{goroutines}->push($goroutine);
  }
  
  private method disable_goroutine : void ($goroutine : Go::Goroutine, $schedule_info : Go::Schedule::Info) {
    
    my $finished_ref = [0];
    my $finish_cb_args_ref = [(object)undef];
    my $finish_ch = (Go::Channel)undef;
    my $cancel_ch = (Go::Channel)undef;
    my $deadline_uv_timer_ref = [(UV::Handle::Timer)undef];
    my $uv_loop = $self->{uv_loop};
    my $finish_cb = (Go::Schedule::Callback::Finish)undef;
    my $timeout_timer_cb = (UV::Callback::Timer)undef;
    my $timeout_uv_timer_ref = [(UV::Handle::Timer)undef];
    
    my $schedule_type = $schedule_info->{type};
    switch ($schedule_type) {
      case Go::Schedule::Info->TYPE_SLEEP:
      {
        my $finish_cb = [$self : , $goroutine : , $timeout_uv_timer_ref : ] method : void ($args : object...) {
          my $timeout_uv_timer = $timeout_uv_timer_ref->[0];
          if ($timeout_uv_timer) {
            $timeout_uv_timer->set_timer_cb(undef);
            $timeout_uv_timer->close_safe;
            $timeout_uv_timer_ref->[0] = undef;
          }
          
          $self->enable_goroutine($goroutine);
        };
        
        $timeout_timer_cb = [$finish_cb : ] method : void ($timeout_uv_timer : UV::Handle::Timer) {
          $finish_cb->();
        };
      }
      case Go::Schedule::Info->TYPE_CHANNEL_READ:
      case Go::Schedule::Info->TYPE_CHANNEL_WRITE:
      {
        my $wait = $schedule_info->{wait};
        my $uv_async_ref = [(UV::Handle::Async)undef];
        my $uv_async = UV::Handle::Async->new;
        $uv_async_ref->[0] = $uv_async;
        $wait->{uv_async} = $uv_async;
        
        my $finish_cb = [$self : , $goroutine : , $wait : , $uv_async_ref : ] method : void ($args : object...) {
          $wait->{uv_async} = undef;
          
          my $async = $uv_async_ref->[0];
          if ($async) {
            $async->close_safe;
            $uv_async_ref->[0] = undef;
          }
          
          $self->enable_goroutine($goroutine);
        };
        
        my $async_cb = [$finish_cb : ] method : void ($uv_async : UV::Handle::Async) {
          $finish_cb->();
        };
        
        $uv_loop->async_init($uv_async, $async_cb);
      }
      case Go::Schedule::Info->TYPE_POLL_READ:
      case Go::Schedule::Info->TYPE_POLL_WRITE:
      {
        my $fd = $schedule_info->{fd};
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_POLL_READ or TYPE_POLL_WRITE must be a non-negative value.";
        }
        
        my $events = $schedule_type == Go::Schedule::Info->TYPE_POLL_READ ? UV_C->UV_READABLE : UV_C->UV_WRITABLE;
        
        my $uv_poll_ref = [(UV::Handle::Poll)undef];
        my $uv_poll = UV::Handle::Poll->new;
        $uv_poll_ref->[0] = $uv_poll;
        $uv_loop->poll_init($uv_poll, $fd);
        
        my $finish_cb = [$self : , $goroutine : , $fd : , $uv_poll_ref : , $timeout_uv_timer_ref : ] method : void ($args : object...) {
          $self->{uv_poll_finish_cbs_h}->delete("$fd");
          
          my $timeout_uv_timer = $timeout_uv_timer_ref->[0];
          if ($timeout_uv_timer) {
            $timeout_uv_timer->set_timer_cb(undef);
            $timeout_uv_timer->close_safe;
            $timeout_uv_timer_ref->[0] = undef;
          }
          
          my $uv_poll = $uv_poll_ref->[0];
          if ($uv_poll) {
            $uv_poll->set_poll_cb(undef);
            $uv_poll->close_safe;
            $uv_poll_ref->[0] = undef;
          }
          
          $self->enable_goroutine($goroutine);
        };
        
        $self->{uv_poll_finish_cbs_h}{"$fd"} = $finish_cb;
        
        my $poll_cb = [$schedule_info : , $finish_cb : ] method : void ($uv_poll : UV::Handle::Poll, $status : int, $events : int) {
          if ($status < 0) {
            $schedule_info->{error_id} = basic_type_id Error;
            $schedule_info->{exception} = UV->strerror($status);
          }
          
          $finish_cb->();
        };
        
        $uv_poll->start($poll_cb, $events);
        
        $timeout_timer_cb = [$schedule_info : , $finish_cb : ] method : void ($timeout_uv_timer : UV::Handle::Timer) {
          $schedule_info->{error_id} = basic_type_id Go::Error::IOTimeout;
          $schedule_info->{exception} = "IO timeout occur";
          
          $finish_cb->();
        };
      }
      case Go::Schedule::Info->TYPE_POLL_CANCEL:
      {
        my $fd = $schedule_info->{fd};
        
        my $uv_poll_finish_cb = $self->{uv_poll_finish_cbs_h}{"$fd"};
        
        if ($uv_poll_finish_cb) {
          $uv_poll_finish_cb->();
        }
        
        return;
      }
      case Go::Schedule::Info->TYPE_PIPE_READ:
      case Go::Schedule::Info->TYPE_PIPE_WRITE:
      {
        my $fd = $schedule_info->{fd};
        my $buffer = $schedule_info->{buffer};
        my $buffer_length = $schedule_info->{buffer_length};
        if ($buffer_length < 0) {
          $buffer_length = length $buffer;
        }
        my $buffer_offset = $schedule_info->{buffer_offset};
        
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_PIPE_READ or TYPE_PIPE_WRITE must be a non-negative value.";
        }
        
        my $uv_pipe_ref = [(UV::Handle::Pipe)undef];
        my $uv_pipe = UV::Handle::Pipe->new;
        my $ipc = 0;
        $uv_loop->pipe_init($uv_pipe, $ipc);
        my $fd_dup = Sys::IO->dup($fd);
        $uv_pipe->open($fd_dup);
        $uv_pipe_ref->[0] = $uv_pipe;
        
        my $finish_cb = [$self : , $goroutine : , $fd : , $uv_pipe_ref : , $timeout_uv_timer_ref : ] method : void ($args : object...) {
          $self->{uv_pipe_finish_cbs_h}->delete("$fd");
          
          my $timeout_uv_timer = $timeout_uv_timer_ref->[0];
          if ($timeout_uv_timer) {
            $timeout_uv_timer->set_timer_cb(undef);
            $timeout_uv_timer->close_safe;
            $timeout_uv_timer_ref->[0] = undef;
          }
          
          my $uv_pipe = $uv_pipe_ref->[0];
          if ($uv_pipe) {
            $uv_pipe->close_safe;
            $uv_pipe_ref->[0] = undef;
          }
          
          $self->enable_goroutine($goroutine);
        };
        
        $self->{uv_pipe_finish_cbs_h}{"$fd"} = $finish_cb;
        
        if ($schedule_type == Go::Schedule::Info->TYPE_PIPE_READ) {
          my $read_cb = [$schedule_info : , $finish_cb : ] method : void ($uv_stream : UV::Handle::Stream, $nread : int, $buffer : string) {
            if ($nread < 0) {
              $schedule_info->{error_id} = basic_type_id Error;
              $schedule_info->{exception} = UV->strerror($nread);
            }
            $schedule_info->{ret_length} = $nread;
            
            $uv_stream->read_stop;
            
            $finish_cb->();
          };
          
          $uv_pipe->read_start((mutable string)$buffer, $buffer_length, $read_cb, $buffer_offset);
        }
        else {
          my $uv_req_write = UV::Request::Write->new;
          
          my $write_cb = [$schedule_info : , $buffer_length : , $finish_cb : , $uv_req_write : ] method : void ($uv_req_write : UV::Request::Write, $status : int) {
            if ($status < 0) {
              $schedule_info->{error_id} = basic_type_id Error;
              $schedule_info->{exception} = UV->strerror($status);
            }
            $schedule_info->{ret_length} = $buffer_length;
            
            $finish_cb->();
            $uv_req_write->set_write_cb(undef);
          };
          
          $uv_req_write->write($uv_pipe, $buffer, $buffer_length, $write_cb, $buffer_offset);
        }
        
        $timeout_timer_cb = [$schedule_info : , $finish_cb : ] method : void ($timeout_uv_timer : UV::Handle::Timer) {
          $schedule_info->{error_id} = basic_type_id Go::Error::IOTimeout;
          $schedule_info->{exception} = "IO timeout occur";
          
          $finish_cb->();
        };
      }
      case Go::Schedule::Info->TYPE_PIPE_CANCEL:
      {
        my $fd = $schedule_info->{fd};
        
        my $uv_pipe_finish_cb = $self->{uv_pipe_finish_cbs_h}{"$fd"};
        
        if ($uv_pipe_finish_cb) {
          $uv_pipe_finish_cb->();
        }
        
        return;
      }
      case Go::Schedule::Info->TYPE_PROCESS:
      {
        my $exec_cmd = $schedule_info->{process_exec_cmd};
        
        unless ($exec_cmd) {
          die "the exec_cmd in schedule type TYPE_PROCESS must be defined.";
        }
        
        if ($schedule_info->{timeout_duration_nsec} != 0) {
          die "the timeout_duration_nsec in schedule type TYPE_PROCESS must be zero.";
        }
        
        my $options = $exec_cmd->to_uv_process_options;
        
        my $uv_process_ref = [(UV::Handle::Process)undef];
        my $uv_process = UV::Handle::Process->new;
        $uv_process_ref->[0] = $uv_process;
        
        $finish_ch = Go->make;
        my $sigkill = 9;
        
        $finish_cb = [$self : , $goroutine : , $finish_ch : , $uv_process_ref : , $deadline_uv_timer_ref : , $finished_ref : , $sigkill : ] method : void ($args : object...) {
          my $is_exit = (int)$args->[0];
          
          if ($is_exit) {
            $finish_ch->close;
          }
          else {
            unless ($finished_ref->[0]) {
              $finished_ref->[0] = 1;
              my $uv_proc = $uv_process_ref->[0];
              if ($uv_proc) {
                $uv_proc->kill($sigkill);
              }
            }
          }
          
          my $deadline_uv_timer = $deadline_uv_timer_ref->[0];
          if ($deadline_uv_timer) {
            $deadline_uv_timer->set_timer_cb(undef);
            $deadline_uv_timer->close_safe;
            $deadline_uv_timer_ref->[0] = undef;
          }
          
          if ($is_exit) {
            my $uv_proc = $uv_process_ref->[0];
            if ($uv_proc) {
              $uv_proc->close_safe;
              $uv_process_ref->[0] = undef;
            }
            
            $self->enable_goroutine($goroutine);
          }
        };
        
        my $exit_cb = [$schedule_info : , $finish_cb : , $finish_cb_args_ref : ,] method : void ($uv_proc : UV::Handle::Process, $exit_status : long, $term_signal : int) {
          $schedule_info->{process_exit_status} = $exit_status;
          $schedule_info->{process_term_signal} = $term_signal;
          
          my $is_exit = 1;
          $finish_cb_args_ref->[0] = [(object)$is_exit];
          $finish_cb->($is_exit);
        };
        
        $options->set_exit_cb($exit_cb);
        
        $uv_loop->spawn($uv_process, $options);
        
        my $is_exit = 0;
        $finish_cb_args_ref->[0] = [(object)$is_exit];
      }
    }
    
    my $timeout_duration_nsec = $schedule_info->{timeout_duration_nsec};
    my $timeout_msec = $timeout_duration_nsec / 1000000;
    if ($timeout_msec > 0) {
      my $timeout_uv_timer = UV::Handle::Timer->new;
      $timeout_uv_timer_ref->[0] = $timeout_uv_timer;
      $uv_loop->timer_init($timeout_uv_timer);
      $timeout_uv_timer->start($timeout_timer_cb, $timeout_msec);
    }
    
    my $context = $schedule_info->{context};
    if ($context) {
      my $deadline = $context->deadline;
      if ($deadline) {
        my $now = Go::Time->now;
        my $duration = $deadline->sub($now);
        my $duration_nsec = $duration->{nsec};
        if ($duration_nsec < 0) {
          $duration_nsec = 0L;
        }
        my $timeout_msec = $duration_nsec / 1_000_000;
        
        my $deadline_uv_timer = UV::Handle::Timer->new;
        $deadline_uv_timer_ref->[0] = $deadline_uv_timer;
        $uv_loop->timer_init($deadline_uv_timer);
        
        my $deadline_timer_cb = [$finish_cb : , $finish_cb_args_ref : ,] method : void ($deadline_uv_timer : UV::Handle::Timer) {
          $finish_cb->((object...)$finish_cb_args_ref->[0]);
        };
        
        $deadline_uv_timer->start($deadline_timer_cb, (long)$timeout_msec);
      }
      
      $cancel_ch = $context->done;
      if ($cancel_ch) {
        my $finish_or_cancel_select = Go->new_select;
        if ($finish_ch) {
          $finish_or_cancel_select->add_read($finish_ch);
        }
        if ($cancel_ch) {
          $finish_or_cancel_select->add_read($cancel_ch);
        }
        Go->go([$finish_or_cancel_select : , $finish_cb : , $finish_cb_args_ref : ,] method : void () {
          $finish_or_cancel_select->select;
          $finish_cb->((object...)$finish_cb_args_ref->[0]);
        });
      }
    }
    

    my $goroutine_address = Fn->to_address($goroutine);
    $self->{disabled_goroutines_h}->{$goroutine_address} = $goroutine;
    $goroutine->{disabled} = 1;
  }
  
  private method enable_goroutine : void ($goroutine : Go::Goroutine) {
    $goroutine->{disabled} = 0;
    $self->{disabled_goroutines_h}->delete(Fn->to_address($goroutine));
    $self->{goroutines}->push($goroutine);
  }
  
  private method process_next_goroutine : void () {
    
    my $goroutines = $self->{goroutines};
    
    unless (@$goroutines > 0) {
      return;
    }
    
    my $goroutine = $goroutines->shift;
    
    if ($goroutine->{finished}) {
    }
    else {
      if ($goroutine->{disabled}) {
      }
      else {
        $goroutines->push($goroutine);
        
        my $schedule_goroutine = $self->{schedule_goroutine};
        
        $goroutine->{return_back_goroutine} = $schedule_goroutine;
        
        $self->{current_goroutine} = $goroutine;
        
        Go::Goroutine->transfer($schedule_goroutine, $goroutine);
      }
    }
  }
  
  private method run : void () {
    
    my $process_next_goroutine_cb = [$self : ] method : void ($uv_idle : UV::Handle::Idle) {
      $self->process_next_goroutine;
      
      unless ($self->loop_alive) {
        $uv_idle->close_safe;
      }
    };
    
    my $schedule_goroutine = Go::Goroutine->new;
    
    $self->{schedule_goroutine} = $schedule_goroutine;
    
    my $uv_loop = $self->{uv_loop};
    my $uv_idle = UV::Handle::Idle->new;
    $uv_loop->idle_init($uv_idle);
    $uv_idle->start($process_next_goroutine_cb);
    
    $uv_loop->run(UV_C->UV_RUN_DEFAULT);
  }
  
  private method loop_alive : int () {
    my $goroutines = $self->{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{disabled_goroutines_h}->keys_length;
      
    return $all_goroutines_length ? 1 : 0;
  }

}
