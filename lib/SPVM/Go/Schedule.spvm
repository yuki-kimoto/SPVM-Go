class Go::Schedule {
  version_from Go;
  allow Go;
  allow Go::Schedule::Task;
  allow Go::Channel;
  allow Go::Select;
  
  use Go::Goroutine;
  use List;
  use QList;
  use Go::Schedule::Task;
  use Sys::Time;
  use Thread::ID;
  use Thread::ThisThread;
  use Go::Error::IOTimeout;
  use Error::System;
  use Time::HiRes;
  use Sys::Time::Util;
  use Sys::Time::Constant as TIME;
  use Format;
  use Sys::Poll::PollfdArray;
  use Sys::Poll::Constant as POLL;
  use Sys::Poll;
  use Go::Time;
  use Go::UV;
  
  private enum {
    TYPE_NONE,
    TYPE_IO_READ,
    TYPE_IO_WRITE,
    TYPE_SLEEP,
    TYPE_CHANNEL_READ,
    TYPE_CHANNEL_WRITE,
  }
  
  has goroutines : List of Go::Goroutine;
  
  has current_goroutine : Go::Goroutine;
  
  has schedule_task_goroutine : Go::Goroutine;
  
  has thread_id : Thread::ID;
  
  has io_wait_goroutines_h : Hash of Go::Goroutine;
  
  has timer_wait_goroutines_h : Hash of Go::Goroutine;
  
  has channel_read_waits_length : int;
  
  has channel_write_waits_length : int;
  
  has uv : Go::UV;
  
  # Class Methods
  private static method new : Go::Schedule () {
    
    my $self = new Go::Schedule;
    
    my $goroutines = QList->new(new Go::Goroutine[0]);
    
    $self->{goroutines} = $goroutines;
    
    $self->{thread_id} = Thread::ThisThread->get_id;
    
    $self->{io_wait_goroutines_h} = Hash->new;
    
    $self->{timer_wait_goroutines_h} = Hash->new;
    
    $self->{uv} = Go::UV->new;
    
    return $self;
  }
  
  # Instance Methods
  private method schedule_io_read : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_READ;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_io_write : void ($fd : int, $io_timeout_duration_nsec : long = 0) {
    
    my $schedule_type = &TYPE_IO_WRITE;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
  }
  
  private method schedule_sleep : int ($io_timeout_duration_nsec : long) {
    
    my $schedule_type = &TYPE_SLEEP;
    
    $self->schedule($schedule_type, $io_timeout_duration_nsec);
  }
  
  private method schedule : int ($schedule_type : int = 0, $io_timeout_duration_nsec : long = 0, $fd : int = -1) {
    
    my $called_from_main_thread = Thread::ID->eq(Thread::ThisThread->get_id, $self->{thread_id});
    
    unless ($called_from_main_thread) {
      die "The schedule method in the Go::Schedule class must be called from the main thread.";
    }
    
    my $deadline = (Go::Time)undef;
    if ($io_timeout_duration_nsec > 0) {
      $deadline = Go::Time->now->add(Go::Duration_1l->new($io_timeout_duration_nsec));
    }
    
    my $current_goroutine = $self->{current_goroutine};
    
    if ($current_goroutine) {
      my $schedule_task_goroutine = $self->{schedule_task_goroutine};
      
      $current_goroutine->{fd} = $fd;
      $current_goroutine->{schedule_type} = (byte)$schedule_type;
      $current_goroutine->{deadline} = $deadline;
      
      if ($schedule_type == &TYPE_IO_READ ||$schedule_type == &TYPE_IO_WRITE) {
        unless ($fd >= 0) {
          die "The file descriptor \$fd in schedule type TYPE_IO_READ or TYPE_IO_WRITE must be a non-negative value.";
        }
        
        $current_goroutine->{disabled} = 1;
        my $current_goroutine_address = Fn->to_address($current_goroutine);
        $self->{io_wait_goroutines_h}->{$current_goroutine_address} = $current_goroutine;
        
        if (Go->ENV_DEBUG) {
          Fn->say_stderr(Format->sprintf("[Go Debug]Register goroutine wait for IO (Callback:%p, QueueNum:%d.)", [(object)$current_goroutine->{task}, $self->{goroutines}->length]));
        }
      }
      elsif ($schedule_type == &TYPE_SLEEP) {
        unless ($deadline) {
          die "The deadline \$deadline in schedule type TYPE_SLEEP must be defined.";
        }
        
        $self->{timer_wait_goroutines_h}->{Fn->to_address($current_goroutine)} = $current_goroutine;
        $current_goroutine->{disabled} = 1;
      }
      elsif ($schedule_type == &TYPE_CHANNEL_READ) {
        $current_goroutine->{disabled} = 1;
        $self->{channel_read_waits_length}++;
      }
      elsif ($schedule_type == &TYPE_CHANNEL_WRITE) {
        $current_goroutine->{disabled} = 1;
        $self->{channel_write_waits_length}++;
      }
      
      Go::Goroutine->transfer($current_goroutine, $schedule_task_goroutine);
      
      if ($current_goroutine->{io_wait_over_deadline}) {
        $current_goroutine->{io_wait_over_deadline} = 0;
        die Go::Error::IOTimeout "IO timeout occur";
      }
    }
    else {
      unless ($schedule_type == &TYPE_NONE) {
        $self->add_task([$self : Go::Schedule, $schedule_type : int, $io_timeout_duration_nsec : long, $fd : int] method : void () {
          $self->schedule($schedule_type, $io_timeout_duration_nsec, $fd);
        });
      }
      
      my $shcedule_cb = [$self : Go::Schedule] method : void () {
        
        my $schedule_task = Go::Schedule::Task->new;
        $schedule_task->{schedule} = $self;
        
        my $start_goroutine = Go::Goroutine->new;
        
        my $schedule_task_goroutine = Go::Goroutine->new($schedule_task);
        
        $schedule_task_goroutine->{return_back} = $start_goroutine;
        
        $self->{schedule_task_goroutine} = $schedule_task_goroutine;
        
        Go::Goroutine->transfer($start_goroutine, $schedule_task_goroutine);
      };
      
      while (1) {
        
        $self->check_timer;
        
        $self->check_io;
        
        $shcedule_cb->();
        
        my $goroutines = $self->{goroutines};
        
        if ($self->get_all_goroutines_length == 0) {
          last;
        }
      }
      
      $self->{schedule_task_goroutine} = undef;
      
      $self->{current_goroutine} = undef;
    }
  }
  
  private method check_timer : void () {
    
    my $timer_wait_goroutines_h = $self->{timer_wait_goroutines_h};
    
    my $addreses = $timer_wait_goroutines_h->keys;
    for my $address (@$addreses) {
      my $goroutine = $timer_wait_goroutines_h->{$address};
      
      my $deadline = $goroutine->{deadline};
      
      if ($deadline) {
        my $is_over_deadline = 1;
        
        if ($deadline) {
          $is_over_deadline = Go::Time->now->after($deadline);
        }
        
        if ($is_over_deadline) {
          $goroutine->{deadline} = undef;
          $goroutine->{disabled} = 0;
          $self->{timer_wait_goroutines_h}->delete(Fn->to_address($goroutine));
          $self->{goroutines}->push($goroutine);
        }
      }
    }
  }
  
  private method check_io : void () {
    my $io_wait_goroutines_h = $self->{io_wait_goroutines_h};
    
    my $poll_goroutines_length = $io_wait_goroutines_h->keys_length;
    
    if ($poll_goroutines_length > 0) {
      my $poll_fd_array = Sys::Poll::PollfdArray->new($poll_goroutines_length);
      
      my $poll_goroutine_addresses = $io_wait_goroutines_h->keys;
      
      my $poll_index = 0;
      for my $address (@$poll_goroutine_addresses) {
        
        my $poll_goroutine = (Go::Goroutine)$io_wait_goroutines_h->get($address);
        
        my $fd = $poll_goroutine->{fd};
        
        $poll_fd_array->set_fd($poll_index, $fd);
        
        my $schedule_type = $poll_goroutine->{schedule_type};
        
        if ($schedule_type == Go::Schedule->TYPE_IO_WRITE) {
          $poll_fd_array->set_events($poll_index, POLL->POLLOUT);
        }
        else {
          $poll_fd_array->set_events($poll_index, POLL->POLLIN);
        }
        
        $poll_goroutine->{poll_index} = $poll_index;
        
        $poll_index++;
      }
      
      my $status = Sys::Poll->poll($poll_fd_array, $poll_goroutines_length, 0);
      
      for my $address (@$poll_goroutine_addresses) {
        my $poll_goroutine = (Go::Goroutine)$io_wait_goroutines_h->get($address);
        
        my $poll_index = $poll_goroutine->{poll_index};
        
        my $revent = $poll_fd_array->revents($poll_index);
        
        my $io_ready = 0;
        if ($revent & (POLL->POLLHUP | POLL->POLLNVAL | POLL->POLLERR)) {
          $io_ready = 1;
        }
        else {
          if ($poll_goroutine->{schedule_type} == Go::Schedule->TYPE_IO_WRITE) {
            if ($revent & POLL->POLLOUT) {
              $io_ready = 1;
            }
          }
          else {
            if ($revent & POLL->POLLIN) {
              $io_ready = 1;
            }
          }
        }
        
        my $is_over_deadline = 0;
        unless ($io_ready) {
          my $deadline = $poll_goroutine->{deadline};
          
          if ($deadline) {
            $is_over_deadline = Go::Time->now->after($deadline);
            $poll_goroutine->{io_wait_over_deadline} = (byte)$is_over_deadline;
          }
        }
        
        if ($io_ready || $is_over_deadline) {
          my $ready_goroutine = (Go::Goroutine)$io_wait_goroutines_h->delete($address);
          $ready_goroutine->{disabled} = 0;
          $ready_goroutine->{schedule_type} = Go::Schedule->TYPE_NONE;
          $ready_goroutine->{fd} = -1;
          $ready_goroutine->{deadline} = undef;
          $self->{goroutines}->push($ready_goroutine);
        }
      }
    }
  }
  
  private method add_task : void ($task : Callback) {
    
    my $goroutine = Go::Goroutine->new($task);
    
    $self->{goroutines}->push($goroutine);
    
    if (Go->ENV_DEBUG) {
      Fn->say_stderr(Format->sprintf("[Go Debug]Push new goroutine with the callback %p.", [(object)$task]));
    }
    
  }
  
  private method get_all_goroutines_length : int () {
    my $goroutines = $self->{goroutines};
    
    my $all_goroutines_length
      = $goroutines->length
      + $self->{timer_wait_goroutines_h}->keys_length
      + $self->{io_wait_goroutines_h}->keys_length;
      + $self->{channel_read_waits_length}
      + $self->{channel_write_waits_length};
      
    return $all_goroutines_length;
  }
}
