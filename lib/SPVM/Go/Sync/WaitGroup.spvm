class Go::Sync::WaitGroup {
  version_from Go;
  use Go;
  use Sync::Mutex;
  use Fn;
  use Sys;
  use Sys::OS;
  
  use UV::Handle::Pipe;
  use UV::Constant as UV_C;
  use UV::Request::Write;
  
  has count : int;
  
  has mutex : Sync::Mutex;
  
  has read_fd : int;
  
  has write_fd : int;
  
  # Class Methods
  static method new : Go::Sync::WaitGroup () {
    
    my $self = new Go::Sync::WaitGroup;
    
    $self->{mutex} = Sync::Mutex->new;
    
    # Initialize pipepair only on non-Windows platforms
    unless (Sys::OS->is_windows) {
      my $read_fd = 0;
      my $write_fd = 0;
      Sys->pipepair(\$read_fd, \$write_fd, 1);
      
      $self->{read_fd} = $read_fd;
      $self->{write_fd} = $write_fd;
    }
    
    return $self;
  }
  
  # Instance Methods
  method add : void ($delta : int = 1) {
    
    my $mutex = $self->{mutex};
    
    $mutex->lock;
    
    Fn->defer([$mutex : , ] method : void () {
      $mutex->unlock;
    });
    
    my $count = $self->{count};
    
    $count += $delta;
      
    my $count_is_negative = $count < 0;
    
    if ($count_is_negative) {
      die "The count field must be greater than or equal to 0.";
    }
    
    $self->{count} = $count;
  }
  
  method done : void () {
    my $mutex = $self->{mutex};
    
    $mutex->lock;
    
    Fn->defer([$mutex : , ] method : void () {
      $mutex->unlock;
    });
    
    my $count = $self->{count} - 1;
    
    my $count_is_negative = $count < 0;
    
    if ($count_is_negative) {
      die "The count field must be greater than or equal to 0.";
    }
    
    $self->{count} = $count;
    
    # Notify waiter via pipe on non-Windows platforms
    if ($count == 0) {
      unless (Sys::OS->is_windows) {
        my $write_fd = $self->{write_fd};
        my $buf = "1";
        &syswrite_pipe($write_fd, $buf, 1);
      }
    }
  }
  
  method wait : void () {
    # Use busy-loop on Windows
    if (Sys::OS->is_windows) {
      while (1) {
        my $count = $self->{count};
        
        if ($count == 0) {
          return;
        }
        
        Go->gosched;
      }
    }
    # Use non-blocking pipe read on POSIX platforms
    else {
      if ($self->{count} == 0) {
        return;
      }
      
      my $read_fd = $self->{read_fd};
      
      Go->gosched_io_read($read_fd);
      
      my $buf = new_string_len(1);
      Sys->sysread($read_fd, $buf, 1);
    }
  }
  
  private static method syswrite_pipe : int ($fd : int, $buffer : string, $buffer_length : int = -1, $buffer_offset : int = 0) {
    if ($fd < 0) {
      die "The file descriptor \$fd must be a non-negative value.";
    }
    
    if ($buffer_length < 0) {
      $buffer_length = length $buffer;
    }
    
    # Create a new uv loop
    my $uv_loop = UV::Loop->new;
    
    my $uv_pipe = UV::Handle::Pipe->new;
    my $ipc = 0;
    $uv_loop->pipe_init($uv_pipe, $ipc);
    my $fd_dup = Sys::IO->dup($fd);
    $uv_pipe->open($fd_dup);
    
    my $uv_req_write = UV::Request::Write->new;
    
    my $status_ref = [0];
    my $write_cb = [$status_ref : , $uv_pipe : ,] method : void ($uv_req_write : UV::Request::Write, $status : int) {
      $status_ref->[0] = $status;
      $uv_req_write->set_write_cb(undef);
      $uv_pipe->close_safe;
    };
    
    $uv_req_write->write($uv_pipe, $buffer, $buffer_length, $write_cb, $buffer_offset);
    
    $uv_loop->run(UV_C->UV_RUN_DEFAULT);
    
    if ($status_ref->[0] < 0) {
      die UV->strerror($status_ref->[0]);
    }
    
    return $buffer_length;
  }
  
}
