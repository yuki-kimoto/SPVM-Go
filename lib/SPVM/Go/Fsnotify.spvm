class Go::Fsnotify {
  version_from Go;
  
  use Go;
  use Go::Channel;
  use UV;
  use UV::Loop;
  use UV::Handle::FsEvent;
  use UV::Callback::FsEvent;
  use Hash;
  use Fn;
  
  # Fields
  has fs_events_h : Hash of UV::Handle::FsEvent;
  has events_ch : Go::Channel;
  has closed : int;
  
  # Class Methods
  static method new : Go::Fsnotify () {
    my $self = new Go::Fsnotify;
    
    my $go = $Go::GO;
    unless ($go) {
      die "Go is not initialized.";
    }
    my $schedule = $go->{schedule};
    unless ($schedule) {
      die "Go schedule is not initialized.";
    }
    my $uv_loop = $schedule->{uv_loop};
    unless ($uv_loop) {
      die "UV loop is not initialized.";
    }
    
    $self->{fs_events_h} = Hash->new;
    $self->{events_ch} = Go->make(100);
    
    return $self;
  }
  
  # Instance Methods
  method add : void ($dir : string) {
    if ($self->{closed}) {
      die "Watcher is closed.";
    }
    
    # Return if already watched
    if ($self->{fs_events_h}->exists($dir)) {
      return;
    }
    
    my $go = $Go::GO;
    my $schedule = $go->{schedule};
    my $uv_loop = $schedule->{uv_loop};
    
    my $fs_event = UV::Handle::FsEvent->new;
    $uv_loop->fs_event_init($fs_event);
    
    my $events_ch = $self->{events_ch};
    
    my $cb = [$events_ch : , $dir : ,] method : void ($handle : UV::Handle::FsEvent, $filename : string, $events : int, $status : int) {
      if ($status < 0) {
        # Handle error
      }
      else {
        # Direct write to channel
        $events_ch->write("$dir/$filename");
      }
    };
    
    $fs_event->start($cb, $dir, 0);
    
    $self->{fs_events_h}->set($dir, $fs_event);
  }
  
  method events : Go::Channel () {
    return $self->{events_ch};
  }
  
  method close : void () {
    if ($self->{closed}) {
      return;
    }
    $self->{closed} = 1;
    
    # Stop and close all fs event handles
    my $fs_events_h = $self->{fs_events_h};
    for my $dir (@{$fs_events_h->keys}) {
      my $fs_event = $fs_events_h->get($dir);
      if ($fs_event) {
        $fs_event->stop;
        $fs_event->close_safe;
      }
    }
    
    $self->{events_ch}->close;
  }
}
