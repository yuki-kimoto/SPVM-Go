class Go::OS::Exec::Cmd {
  
  allow Go::OS::Exec;
  allow Go::Schedule;
  
  use Go::OS::File;
  use UV::Constant as UV_C;
  use UV::ProcessOptions;
  use UV::StdioContainer;
  use UV::Callback::Exit;
  
  has path : rw string;
  
  has args : rw string[];
  
  has env : rw string[];
  
  has dir : rw string;
  
  has stdout : rw Go::OS::File;
  
  has stderr : rw Go::OS::File;
  
  has stdin : rw Go::OS::File;
  
  has extra_files : rw Go::OS::File[];
  
  has context : rw Go::Context;
  
  static method new : Go::OS::Exec::Cmd () {
    
    my $self = new Go::OS::Exec::Cmd;
    
    return $self;
  }
  
  private method _setup_stdio_container : void ($container : UV::StdioContainer, $go_file : Go::OS::File) {
    
    if (!$go_file) {
      $container->set_flags(UV_C->UV_IGNORE);
    }
    else {
      my $type = $go_file->{type};
      
      switch ($type) {
        case Go::OS::File->TYPE_FILE : {
          $container->set_flags(UV_C->UV_INHERIT_FD);
          $container->set_fd($go_file->{fd});
        }
        case Go::OS::File->TYPE_PIPE_END : {
          my $uv_loop = Go->uv_loop;
          my $uv_pipe = UV::Handle::Pipe->new;
          $uv_loop->pipe_init($uv_pipe, 0);
          my $flags = UV_C->UV_CREATE_PIPE | UV_C->UV_WRITABLE_PIPE | UV_C->UV_READABLE_PIPE;
          $container->set_flags($flags);
          $container->set_stream($uv_pipe);
          $go_file->{uv_stream} = $uv_pipe;
        }
        default : {
          die "[Unexpected Error]Invalid Go::OS::File type:\$type=$type";
        }
      }
    }
  }
  
  method to_uv_process_options : UV::ProcessOptions () {
    
    my $options = UV::ProcessOptions->new;
    
    $options->set_file($self->{path});
    $options->set_args($self->{args});
    $options->set_env($self->{env});
    if ($self->{dir}) {
      $options->set_cwd($self->{dir});
    }
    
    my $extra_fds = $self->{extra_files};
    my $extra_fds_count = $extra_fds ? @$extra_fds : 0;
    my $stdio_count = 3 + $extra_fds_count;
    
    my $stdio_containers = new UV::StdioContainer[$stdio_count];
    
    {
      my $container = UV::StdioContainer->new;
      $self->_setup_stdio_container($container, $self->{stdin});
      $stdio_containers->[0] = $container;
    }
    
    {
      my $container = UV::StdioContainer->new;
      $self->_setup_stdio_container($container, $self->{stdout});
      $stdio_containers->[1] = $container;
    }
    
    {
      my $container = UV::StdioContainer->new;
      $self->_setup_stdio_container($container, $self->{stderr});
      $stdio_containers->[2] = $container;
    }
    
    for (my $i = 0; $i < $extra_fds_count; $i++) {
      my $stdio_index = 3 + $i;
      my $container = UV::StdioContainer->new;
      my $go_file = $extra_fds->[$i];
      $self->_setup_stdio_container($container, $go_file);
      $stdio_containers->[$stdio_index] = $container;
    }
    
    $options->set_stdios($stdio_containers);
    
    return $options;
  }
  
  has _finish_ch : Go::Channel;
  
  has _exit_status_ref : long[];
  
  has _term_signal_ref : int[];
  
  has _error_id_ref : int[];
  
  has _exception_ref : string[];

  method start : void () {
    
    my $exec_cmd = $self;
    my $context = $self->{context};
    
    my $options = $exec_cmd->to_uv_process_options;
    
    my $sigkill = 9;
    my $finished_ref = [0];
    my $finish_ch = Go->make;
    $self->{_finish_ch} = $finish_ch;
    
    my $uv_loop = Go->uv_loop;
    
    my $exit_status_ref = [(long)0];
    my $term_signal_ref = [(int)0];
    my $error_id_ref = [(int)0];
    my $exception_ref = [(string)undef];
    $self->{_exit_status_ref} = $exit_status_ref;
    $self->{_term_signal_ref} = $term_signal_ref;
    $self->{_error_id_ref} = $error_id_ref;
    $self->{_exception_ref} = $exception_ref;
    
    my $uv_process_ref = [(UV::Handle::Process)undef];
    my $uv_process = UV::Handle::Process->new;
    $uv_process_ref->[0] = $uv_process;
    
    my $exit_cb_ref = [(UV::Callback::Exit)undef];
    my $cancel_cb_ref = [(Callback)undef];
    
    # Clean up process handle and callbacks on exit
    my $exit_cb = [$exit_status_ref : , $term_signal_ref : , $finish_ch : , $uv_process_ref : , $exit_cb_ref : , $cancel_cb_ref : ] method : void ($uv_proc : UV::Handle::Process, $exit_status : long, $term_signal : int) {
      $exit_status_ref->[0] = $exit_status;
      $term_signal_ref->[0] = $term_signal;
      
      $finish_ch->close;
      
      my $uv_proc = $uv_process_ref->[0];
      if ($uv_proc) {
        $uv_proc->close_safe;
        $uv_process_ref->[0] = undef;
      }
      
      $exit_cb_ref->[0] = undef;
      $cancel_cb_ref->[0] = undef;
    };
    weaken $exit_cb->{uv_process_ref};
    $exit_cb_ref->[0] = $exit_cb;
    $options->set_exit_cb($exit_cb);
    
    # Kill process when context done fires before finish
    my $cancel_cb = [$context : , $error_id_ref : , $exception_ref : , $uv_process_ref : , $finished_ref : , $sigkill : ] method : void () {
      my $err_id = $context ? $context->err : 0;
      if ($err_id > 0) {
        $error_id_ref->[0] = $err_id;
        $exception_ref->[0] = $context->cause;
      }
      else {
        $error_id_ref->[0] = basic_type_id Go::Context::Error::Canceled;
        $exception_ref->[0] = "context canceled";
      }
      
      unless ($finished_ref->[0]) {
        $finished_ref->[0] = 1;
        my $uv_proc = $uv_process_ref->[0];
        if ($uv_proc) {
          $uv_proc->kill($sigkill);
        }
      }
    };
    $cancel_cb_ref->[0] = $cancel_cb;
    
    $uv_loop->spawn($uv_process, $options);
    
    Go->monitor_context($context, $finish_ch, $cancel_cb);
  }
  
  method wait : long () {
    
    my $finish_ch = $self->{_finish_ch};
    if ($finish_ch) {
      $finish_ch->read;
    }
    
    my $error_id_ref = $self->{_error_id_ref};
    my $exception_ref = $self->{_exception_ref};
    if ($error_id_ref && $error_id_ref->[0]) {
      die $error_id_ref->[0], $exception_ref->[0];
    }
    
    my $exit_status_ref = $self->{_exit_status_ref};
    my $term_signal_ref = $self->{_term_signal_ref};
    my $exit_status = $exit_status_ref ? $exit_status_ref->[0] : 0L;
    my $term_signal = $term_signal_ref ? $term_signal_ref->[0] : 0;
    
    my $status = ($exit_status << 8) | $term_signal;
    
    return $status;
  }
  
  method run : long () {
    
    $self->start;
    
    return $self->wait;
  }
  
}
