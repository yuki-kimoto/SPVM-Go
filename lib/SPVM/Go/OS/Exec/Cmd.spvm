class Go::OS::Exec::Cmd {
  
  allow Go::OS::Exec;
  
  use Go::OS::FD;
  
  # Fields
  has path : rw string;
  
  has args : rw string[];
  
  has env : rw string[];
  
  has dir : rw string;
  
  has stdout_fd : rw Go::OS::FD;
  
  has stderr_fd : rw Go::OS::FD;
  
  has stdin_fd : rw Go::OS::FD;
  
  has extract_fds : rw Go::OS::FD[];
  
  has context : rw Go::Context;
  
  # Class Methods
  static method new : Go::OS::Exec::Cmd () {
    
    my $self = new Go::OS::Exec::Cmd;
    
    return $self;
  }
  
  # Instance Methods
  method run : void () {
    
    die "Not implemented.";
    
  }
  
}
