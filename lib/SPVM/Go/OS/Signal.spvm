class Go::OS::Signal {
  version_from Go;
  
  use Go;
  use Go::Channel;
  use Hash;
  use UV::Handle::Signal;
  
  has notified_channels_h : Hash of Go::Channel[];
  
  has uv_signals_h : Hash of UV::Handle::Signal;
  
  static method new : Go::OS::Signal () {
    my $self = new Go::OS::Signal;
    
    $self->{notified_channels_h} = Hash->new;
    $self->{uv_signals_h} = Hash->new;
    
    return $self;
  }
  
  method ignore : void ($signal : int) {
    my $notified_channels_h = $self->{notified_channels_h};
    my $uv_signals_h = $self->{uv_signals_h};
    
    if ($notified_channels_h) {
      $notified_channels_h->delete("$signal");
    }
    
    my $go = $Go::GO;
    unless ($go) {
      die "Go is not initialized.";
    }
    my $schedule = $go->{schedule};
    unless ($schedule) {
      die "Go schedule is not initialized.";
    }
    my $uv_loop = $schedule->{uv_loop};
    unless ($uv_loop) {
      die "UV loop is not initialized.";
    }
    
    unless ($uv_signals_h->{"$signal"}) {
      my $uv_signal = UV::Handle::Signal->new;
      $uv_loop->signal_init($uv_signal);
      
      # Trap signal and do nothing
      my $signal_cb = method : void ($uv_signal_handle : UV::Handle::Signal, $signum : int) {
        
      };
      
      $uv_signal->start($signal_cb, $signal);
      
      $uv_signals_h->{"$signal"} = $uv_signal;
    }
  }
  
  method notify : void ($channel : Go::Channel, $signal : int) {
    unless ($channel) {
      die "\$channel must be defined.";
    }
    
    my $notified_channels_h = $self->{notified_channels_h};
    my $uv_signals_h = $self->{uv_signals_h};
    
    unless ($notified_channels_h->{"$signal"}) {
      $notified_channels_h->{"$signal"} = new Go::Channel[0];
    }
    
    # Prevent duplicate channel registration
    my $channels = $notified_channels_h->{"$signal"};
    my $exists = 0;
    for my $ch (@$channels) {
      if ($ch == $channel) {
        $exists = 1;
        last;
      }
    }
    
    unless ($exists) {
      List->new_ref($notified_channels_h->{"$signal"})->push($channel);
    }
    
    my $go = $Go::GO;
    unless ($go) {
      die "Go is not initialized.";
    }
    my $schedule = $go->{schedule};
    unless ($schedule) {
      die "Go schedule is not initialized.";
    }
    my $uv_loop = $schedule->{uv_loop};
    unless ($uv_loop) {
      die "UV loop is not initialized.";
    }
    
    unless ($uv_signals_h->{"$signal"}) {
      my $uv_signal = UV::Handle::Signal->new;
      $uv_loop->signal_init($uv_signal);
      
      # Capture only notified_channels_h to avoid circular reference with $sig
      my $notified_channels_h = $self->{notified_channels_h};
      my $signal_cb = [$signal : int, $notified_channels_h : Hash of Go::Channel[]] method : void ($uv_signal_handle : UV::Handle::Signal, $signum : int) {
        if ($notified_channels_h && (my $target_channels = $notified_channels_h->{"$signal"})) {
          for my $ch (@$target_channels) {
            my $select = Go->new_select;
            $select->set_non_blocking(1);
            $select->add_write($ch, $signal);
            $select->select;
          }
        }
      };
      
      $uv_signal->start($signal_cb, $signal);
      
      $uv_signals_h->{"$signal"} = $uv_signal;
    }
  }
  
  method stop : void ($channel : Go::Channel, $signal : int) {
    my $notified_channels_h = $self->{notified_channels_h};
    my $uv_signals_h = $self->{uv_signals_h};
    
    my $channels = $notified_channels_h ? $notified_channels_h->{"$signal"} : undef;
    if ($channels) {
      my $new_channels = (List of Go::Channel)List->new(new Go::Channel[0]);
      for my $_ (@$channels) {
        unless ($_ == $channel) {
          $new_channels->push($_);
        }
      }
      $notified_channels_h->{"$signal"} = $new_channels->to_array;
      
      if (@{$notified_channels_h->{"$signal"}} == 0) {
        $notified_channels_h->delete("$signal");
      }
    }
    
    my $has_notified = $notified_channels_h && $notified_channels_h->{"$signal"} && @{$notified_channels_h->{"$signal"}} > 0;
    
    unless ($has_notified) {
      if ($uv_signals_h && (my $uv_signal = $uv_signals_h->{"$signal"})) {
        $uv_signal->stop;
        $uv_signal->close_safe;
        $uv_signals_h->delete("$signal");
      }
    }
  }
  
  method reset : void () {
    my $uv_signals_h = $self->{uv_signals_h};
    
    unless ($uv_signals_h) {
      return;
    }
    
    for my $signal (@{$uv_signals_h->keys}) {
      if (my $uv_signal = $uv_signals_h->{"$signal"}) {
        $uv_signal->stop;
        $uv_signal->close_safe;
      }
    }
    
    $self->{notified_channels_h} = Hash->new;
    $self->{uv_signals_h} = Hash->new;
  }
  
  method DESTROY : void () {
    $self->reset;
  }
}
