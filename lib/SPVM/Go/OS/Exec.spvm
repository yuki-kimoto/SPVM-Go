class Go::OS::Exec {
  
  use Go::OS::Exec::Cmd;
  use Go::Context;
  
  static method command : Go::OS::Exec::Cmd ($command : string[]) {
    
    my $self = new Go::OS::Exec::Cmd;
    $self->{path} = $command->[0];
    $self->{args} = $command;
    
    return $self;
  }
  
  static method command_context : Go::OS::Exec::Cmd ($ctx : Go::Context, $command : string[]) {
    
    my $self = new Go::OS::Exec::Cmd;
    $self->{context} = $ctx;
    $self->{path} = $command->[0];
    $self->{args} = $command;
    
    return $self;
  }
  
}
