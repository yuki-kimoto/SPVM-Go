class Go::OS::FD {
  
  allow Go::OS::Exec::Cmd;
  
  private enum {
    TYPE_UNKNOWN,
    TYPE_FILE,
    TYPE_PIPE,
  }
  
  # Fields
  has type : ro int;
  
  has fd : ro int;
  
  has is_write : byte;
  
  # Class Methods
  static method new_inherit : Go::OS::FD ($fd : int) {
    
    my $self = new Go::OS::FD;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_FILE;
    
    return $self;
  }
  
  static method new_pipe_read : Go::OS::FD ($fd : int) {
    
    my $self = new Go::OS::FD;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_PIPE;
    
    return $self;
  }
  
  static method new_pipe_write : Go::OS::FD ($fd : int) {
    
    my $self = new Go::OS::FD;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_PIPE;
    $self->{is_write} = 1;
    
    return $self;
  }

}
