class Go::OS::File {
  
  allow Go::OS::Exec::Cmd;
  allow Go::Schedule;
  
  use Fn;
  use Go;
  use Go::Context;
  use Go::Select;
  use Go::Select::Result;
  use UV;
  use UV::Constant as UV_C;
  use UV::Handle::Stream;
  use UV::Request::Write;
  
  private enum {
    TYPE_UNKNOWN,
    TYPE_FILE,
    TYPE_PIPE_END,
  }
  
  # Class Variables
  our $STDIN : ro Go::OS::File;
  INIT {
    $STDIN = &new_file(0);
  }
  
  our $STDOUT : ro Go::OS::File;
  INIT {
    $STDOUT = &new_file(1);
  }
  
  our $STDERR : ro Go::OS::File;
  INIT {
    $STDERR = &new_file(2);
  }
  
  # Fields
  has type : ro int;
  
  has fd : ro int;
  
  has uv_stream : UV::Handle::Stream;
  
  has no_close : byte;
  
  # Class Methods
  static method new_file : Go::OS::File ($fd : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd must be a non-negative number.";
    }
    
    my $self = new Go::OS::File;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_FILE;
    $self->{no_close} = 1;
    
    return $self;
  }
  
  static method prepare_pipe_end : Go::OS::File () {
    
    my $self = new Go::OS::File;
    
    $self->{fd} = -1;
    $self->{type} = &TYPE_PIPE_END;
    
    return $self;
  }
  
  method close : void () {
    
    if ($self->{no_close}) {
      die "'no_close' field is specified.";
    }
    else {
      if (my $uv_stream = $self->{uv_stream}) {
        $uv_stream->close_safe;
        $self->{uv_stream} = undef;
      }
    }
  }
  
  method read : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    my $type = $self->{type};
    
    if ($type == &TYPE_PIPE_END) {
      my $uv_stream = $self->{uv_stream};
      return Go->sysread_uv_stream($context, $uv_stream, $string, $length, $offset);
    }
    else {
      die "[Unexpected Error]Not supported type. \$type=$type.";
    }
  }
  
  method write : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $type = $self->{type};
    
    if ($type == &TYPE_PIPE_END) {
      my $uv_stream = $self->{uv_stream};
      return Go->syswrite_uv_stream($context, $uv_stream, $string, $length, $offset);
    }
    else {
      die "[Unexpected Error]Not supported type. \$type=$type.";
    }
  }
  
  method DESTROY : void () {
    
    my $type = $self->{type};
    
    unless ($self->{no_close}) {
      $self->close;
    }
  }
  
}
