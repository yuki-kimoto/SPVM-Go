class Go::OS::File {
  
  allow Go::OS::Exec::Cmd;
  allow Go::Schedule;
  
  use Callback;
  use Fn;
  use Go;
  use Go::Context;
  use Go::Select;
  use Go::Select::Result;
  use UV;
  use UV::Constant as UV_C;
  use UV::Handle::Stream;
  # use UV::Handle::TCP;
  use UV::Handle::Pipe;
  use UV::Request::Write;
  use Sys;
  
  private enum {
    TYPE_UNKNOWN,
    TYPE_FILE,
    TYPE_TCP,
    TYPE_PIPE,
  }
  
  # Class Variables
  our $STDIN : ro Go::OS::File;
  INIT {
    $STDIN = &new_file(Sys->fileno(Sys->STDIN));
  }
  
  our $STDOUT : ro Go::OS::File;
  INIT {
    $STDOUT = &new_file(Sys->fileno(Sys->STDOUT));
  }
  
  our $STDERR : ro Go::OS::File;
  INIT {
    $STDERR = &new_file(Sys->fileno(Sys->STDERR));
  }
  
  # Fields
  has type : ro int;
  
  has fd : ro int;
  
  has uv_stream : UV::Handle::Stream;
  
  has finish_cb : Callback;
  
  has no_close : byte;
  
  has closed : ro byte;
  
  # Class Methods
  static method new_file : Go::OS::File ($fd : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd must be a non-negative number.";
    }
    
    my $self = new Go::OS::File;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_FILE;
    $self->{no_close} = 1;
    
    return $self;
  }
  
  static method new_tcp : Go::OS::File ($fd : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd must be a non-negative number.";
    }
    
    die "Not implemented.";
  }
  
  static method new_pipe_end : Go::OS::File ($fd : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd must be a non-negative number.";
    }
    
    # Duplicate fd for libuv pipe ownership
    my $dup_fd = Sys::IO->dup($fd);
    
    my $uv_loop = Go->uv_loop;
    my $uv_pipe = UV::Handle::Pipe->new;
    $uv_loop->pipe_init($uv_pipe, 0);
    $uv_pipe->open($dup_fd);
    
    my $self = new Go::OS::File;
    
    $self->{fd} = $dup_fd;
    $self->{type} = &TYPE_PIPE;
    $self->{uv_stream} = $uv_pipe;
    
    return $self;
  }
  
  static method prepare_pipe_end : Go::OS::File () {
    
    my $self = new Go::OS::File;
    
    $self->{fd} = -1;
    $self->{type} = &TYPE_PIPE;
    
    return $self;
  }
  
  method read : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    if ($self->{closed}) {
      die "The file is already closed.";
    }
    
    my $type = $self->{type};
    
    unless ($type == &TYPE_PIPE || $type == &TYPE_TCP) {
      die "Not supported type. \$type=$type. You perhaps specify FILE type.";
    }
    
    my $uv_stream = $self->{uv_stream};
    
    unless ($uv_stream) {
      die "The uv_stream must be defined.";
    }
    
    my $string_len = length $string;
    if ($offset < 0 || $offset > $string_len) {
      die "The offset is out of range.";
    }
    
    if ($length < 0) {
      $length = $string_len - $offset;
    }
    if ($offset + $length > $string_len) {
      die "The length is out of range.";
    }
    if ($length == 0) {
      return 0;
    }
    
    my $result_ch = Go->make(1);
    my $done_ref = [0];
    my $read_buf = new_string_len $length;
    
    # Finish read once with optional result or cancel
    my $finish_cb = [$uv_stream : , $result_ch : , $done_ref : ] method : void ($nread : int = 0, $buf : string = undef, $err : int = 0, $has_result : int = 0) {
      if ($done_ref->[0]) {
        return;
      }
      $done_ref->[0] = 1;
      if ($uv_stream) {
        $uv_stream->read_stop;
      }
      if ($has_result) {
        $result_ch->write([(object)$nread, $buf, $err]);
      }
      $result_ch->close;
    };
    weaken $finish_cb->{uv_stream};
    
    $self->{finish_cb} = $finish_cb;
    
    my $read_cb = [$finish_cb : , $done_ref : ] method : void ($stream : UV::Handle::Stream, $nread : int, $buf : mutable string) {
      $stream->read_stop;
      
      if ($done_ref->[0]) {
        return;
      }
      
      if ($nread > 0) {
        my $copy_buf = new_string_len $nread;
        Fn->memcpy($copy_buf, 0, $buf, 0, $nread);
        $finish_cb->($nread, $copy_buf, 0, 1);
      }
      elsif ($nread == 0) {
        # Retry read on empty callback
        $stream->read_start($buf, length $buf, $self);
      }
      elsif ($nread == UV_C->UV_EOF) {
        $finish_cb->(0, undef, 0, 1);
      }
      else {
        $finish_cb->(-1, undef, $nread, 1);
      }
    };
    
    $uv_stream->read_start($read_buf, $length, $read_cb);
    
    Go::Context->monitor_context($context, $finish_cb, $result_ch);
    
    my $res = (object[])$result_ch->read;
    
    $self->{finish_cb} = undef;
    
    if ($context->err > 0) {
      die $context->err, $context->cause;
    }
    
    unless ($res) {
      return 0;
    }
    
    my $nread = (int)$res->[0];
    my $err = (int)$res->[2];
    if ($err < 0) {
      die "libuv read error:" . UV->strerror($err);
    }
    if ($nread > 0) {
      my $data = (string)$res->[1];
      Fn->memcpy($string, $offset, $data, 0, $nread);
    }
    
    Go->gosched;
    
    return $nread;
  }
  
  method write : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    if ($self->{closed}) {
      die "The file is already closed.";
    }
    
    my $type = $self->{type};
    
    unless ($type == &TYPE_PIPE || $type == &TYPE_TCP) {
      die "Not supported type. \$type=$type. You perhaps specify FILE type.";
    }
    
    my $uv_stream = $self->{uv_stream};
    
    unless ($uv_stream) {
      die "The uv_stream must be defined.";
    }
    
    unless ($string) {
      die "The string must be defined.";
    }
    
    my $string_len = length $string;
    if ($offset < 0 || $offset > $string_len) {
      die "The offset is out of range.";
    }
    
    if ($length < 0) {
      $length = $string_len - $offset;
    }
    if ($offset + $length > $string_len) {
      die "The length is out of range.";
    }
    if ($length == 0) {
      return 0;
    }
    
    my $result_ch = Go->make(1);
    my $done_ref = [0];
    
    my $write_buf = new_string_len $length;
    Fn->memcpy($write_buf, 0, $string, $offset, $length);
    
    # Finish write once with optional result or cancel
    my $finish_cb = [$result_ch : , $done_ref : ] method : void ($written : int = 0, $status : int = 0, $has_result : int = 0) {
      if ($done_ref->[0]) {
        return;
      }
      $done_ref->[0] = 1;
      if ($has_result) {
        $result_ch->write([$written, $status]);
      }
      $result_ch->close;
    };
    
    $self->{finish_cb} = $finish_cb;
    
    my $write_req = UV::Request::Write->new;
    my $write_cb = [$finish_cb : , $done_ref : , $write_req : , $length : ] method : void ($req : UV::Request::Write, $status : int) {
      $req->set_write_cb(undef);
      if ($done_ref->[0]) {
        return;
      }
      if ($status < 0) {
        $finish_cb->(-1, $status, 1);
      }
      else {
        $finish_cb->($length, 0, 1);
      }
    };
    
    $write_req->write($uv_stream, $write_buf, $length, $write_cb);
    
    Go::Context->monitor_context($context, $finish_cb, $result_ch);
    
    my $res = (int[])$result_ch->read;
    
    $self->{finish_cb} = undef;
    
    if ($context->err > 0) {
      die $context->err, $context->cause;
    }
    
    unless ($res) {
      return 0;
    }
    
    my $written = $res->[0];
    my $status = $res->[1];
    if ($status < 0) {
      die "libuv write error:" . UV->strerror($status);
    }
    
    Go->gosched;
    
    return $written;
  }
  
  method close : void () {
    
    if ($self->{no_close}) {
      die "'no_close' field is specified.";
    }
    
    if ($self->{closed}) {
      return;
    }
    
    if (my $finish_cb = $self->{finish_cb}) {
      $self->{finish_cb} = undef;
      $finish_cb->();
    }
    
    if (my $uv_stream = $self->{uv_stream}) {
      $uv_stream->close_safe;
      $self->{uv_stream} = undef;
    }
    
    $self->{fd} = -1;
    $self->{closed} = 1;
    
    Go->gosched;
  }
  
  method DESTROY : void () {
    
    unless ($self->{no_close}) {
      $self->close;
    }
  }
  
}
