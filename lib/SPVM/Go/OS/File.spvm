class Go::OS::File {
  
  allow Go::OS::Exec::Cmd;
  allow Go::Schedule;
  
  use UV::Handle::Stream;
  
  private enum {
    TYPE_UNKNOWN,
    TYPE_FILE,
    TYPE_PIPE_END,
  }
  
  # Class Variables
  our $STDIN : ro Go::OS::File;
  INIT {
    $STDIN = &new_file(0);
  }
  
  our $STDOUT : ro Go::OS::File;
  INIT {
    $STDOUT = &new_file(1);
  }
  
  our $STDERR : ro Go::OS::File;
  INIT {
    $STDERR = &new_file(2);
  }
  
  # Fields
  has type : ro int;
  
  has fd : ro int;
  
  has uv_stream : UV::Handle::Stream;
  
  has no_close : byte;
  
  has opened : byte;
  
  has other_uv_pipe : UV::Handle::Pipe;
  
  # Class Methods
  static method new_file : Go::OS::File ($fd : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd must be a non-negative number.";
    }
    
    my $self = new Go::OS::File;
    
    $self->{fd} = $fd;
    $self->{type} = &TYPE_FILE;
    $self->{no_close} = 1;
    
    return $self;
  }
  
  static method prepare_pipe_end : Go::OS::File () {
    
    my $self = new Go::OS::File;
    
    my $fd = -1;
    my $other_fd = -1;
    Sys->pipepair(\$fd, \$other_fd, 1);
    
    my $uv_loop = Go->uv_loop;
    my $other_uv_pipe = UV::Handle::Pipe->new;
    $uv_loop->pipe_init($other_uv_pipe, 0);
    $other_uv_pipe->open($other_fd);
    
    $self->{fd} = $fd;
    $self->{other_uv_pipe} = $other_uv_pipe;
    $self->{type} = &TYPE_PIPE_END;
    $self->{opened} = 1;
    
    return $self;
  }
  
  method close : void () {
    
    if ($self->{no_close}) {
      die "'no_close' field is specified.";
    }
    else {
      if ($self->{opened}) {
        Sys::IO->close($self->{fd});
        $self->{opened} = 0;
      }
    }
  }
  
  method sysread : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    my $type = $self->{type};
    
    if ($type == &TYPE_PIPE_END) {
      my $fd = $self->{fd};
      
      my $read_length = Go->gosched_pipe_read($context, $fd, $string, $length, $offset);
      
      return $read_length;
    }
    else {
      die "[Unexpected Error]Not supported type. \$type=$type.";
    }
  }
  
  method syswrite : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $type = $self->{type};
    
    if ($type == &TYPE_PIPE_END) {
      my $fd = $self->{fd};
      
      my $read_length = Go->gosched_pipe_write($context, $fd, $string, $length, $offset);
      
      return $read_length;
    }
    else {
      die "[Unexpected Error]Not supported type. \$type=$type.";
    }
  }
  
  method DESTROY : void () {
    
    my $type = $self->{type};
    
    if (my $other_uv_pipe = $self->{other_uv_pipe}) {
      $other_uv_pipe->close_safe;
      $self->{other_uv_pipe} = undef;
    }
    
    if (my $uv_stream = $self->{uv_stream}) {
      $uv_stream->close_safe;
      $self->{uv_stream} = undef;
    }
    
    unless ($self->{no_close}) {
      $self->close;
    }
  }
  
}
