class Go::Channel::Wait {
  version_from Go;
  
  allow Go::Schedule;
  allow Go::Channel;
  
  use Go::Goroutine;
  
  has goroutine : Go::Goroutine;
  
  has value : object;
  
  has finish : byte;
  
  has in_buffer : byte;
  
  has ok : byte;
  
  # Class Methods
  static method new : Go::Channel::Wait () {
    
    my $self = new Go::Channel::Wait;
    
    return $self;
  }
}
