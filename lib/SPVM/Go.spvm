class Go {
  version "0.054";
  
  allow Go::OS::Exec::Cmd;
  allow Go::OS::Signal;
  allow Go::Fsnotify;
  
  use Go::Channel;
  use Go::Schedule;
  use Callback;
  use Go::Select;
  use Go::Duration_1l;
  use Go::Context;
  use Go::Sync::WaitGroup;
  use Go::OS::Exec::Cmd;
  use UV::Constant as UV_C;
  
  our $GO : Go;
  
  has schedule : Go::Schedule;
  
  INIT {
    my $go = new Go;
    
    my $schedule = Go::Schedule->new;
    
    $go->{schedule} = $schedule;
    
    $GO = $go;
  }
  
  static method go : void ($task : Callback) {
    
    my $schedule = $GO->{schedule};
    
    my $caller_info = caller;
    
    $schedule->add_task($task, $caller_info);
  }
  
  static method make : Go::Channel ($capacity : int = 0) {
    
    my $schedule = $GO->{schedule};
    
    my $channel = Go::Channel->new({schedule => $schedule, capacity => $capacity});
    
    return $channel;
  }
  
  static method new_select : Go::Select () {
    
    my $schedule = $GO->{schedule};
    
    my $select = Go::Select->new($schedule);
    
    return $select;
  }
  
  static method gosched : void () {
    
    my $schedule = $GO->{schedule};
    
    my $caller_info = caller;
    $schedule->schedule(undef, $caller_info);
  }
  
  static method sleep : void ($duration : Go::Duration_1l) {
    
    my $nsec = $duration->{nsec};
    if ($nsec <= 0L) {
      return;
    }
    
    my $timeout_msec = (long)($nsec / 1_000_000L);
    
    my $uv_loop = Go->uv_loop;
    my $timer = UV::Handle::Timer->new;
    $uv_loop->timer_init($timer);
    
    my $sleep_ch = Go->make(1);
    
    my $timer_cb = [$timer : , $sleep_ch : ] method : void ($uv_timer : UV::Handle::Timer) {
      $uv_timer->set_timer_cb(undef);
      $uv_timer->close_safe;
      $sleep_ch->write(1);
    };
    
    $timer->start($timer_cb, $timeout_msec);
    
    $sleep_ch->read;
  }
  
  static method sleep_sec : void ($sec : double = 0) {
    
    my $duration = Go::Duration_1l->new_from_sec($sec);
    
    &sleep($duration);
  }
  
  static method after : Go::Channel ($duration : Go::Duration_1l = undef) {
    
    my $duration_nsec = $duration->{nsec};
    
    my $ch = Go->make;
    
    Go->go([$ch : , $duration_nsec : ] method : void () {
      my $duration = Go::Duration_1l->new($duration_nsec);
      Go->sleep($duration);
      
      $ch->write(1);
    });
    
    return $ch;
  }
  
  static method after_sec : Go::Channel ($sec : double = 0) {
    
    my $duration = Go::Duration_1l->new_from_sec($sec);
    
    return &after($duration);
  }
  
  private static method gosched_poll_read_with_caller_info : void ($context : Go::Context, $fd : int, $caller_info : CallerInfo = undef) {
    
    &gosched_poll_io($context, $fd, 1);
  }
  
  static method gosched_poll_write_with_caller_info : void ($context : Go::Context, $fd : int, $caller_info : CallerInfo = undef) {
    
    &gosched_poll_io($context, $fd, 0);
  }
  
  private static method gosched_poll_io : void ($context : Go::Context, $fd : int, $is_read : int) {
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd in schedule type TYPE_POLL_READ or TYPE_POLL_WRITE must be a non-negative value.";
    }
    
    my $schedule = $GO->{schedule};
    my $uv_loop = $schedule->{uv_loop};
    my $finish_ch = Go->make;
    my $deadline_uv_timer_ref = [(UV::Handle::Timer)undef];
    my $error_id_ref = [(int)0];
    my $exception_ref = [(string)undef];
    
    my $uv_poll_ref = [(UV::Handle::Poll)undef];
    my $uv_poll = UV::Handle::Poll->new;
    $uv_poll_ref->[0] = $uv_poll;
    $uv_loop->poll_init($uv_poll, $fd);
    
    # Clean up handles and break callback cycles
    my $finish_cb = [$schedule : , $finish_ch : , $fd : , $uv_poll_ref : , $deadline_uv_timer_ref : ] method : void ($args : object...) {
      $finish_ch->close;
      $schedule->{uv_poll_finish_cbs_h}->delete("$fd");
      
      my $deadline_uv_timer = $deadline_uv_timer_ref->[0];
      if ($deadline_uv_timer) {
        $deadline_uv_timer->set_timer_cb(undef);
        $deadline_uv_timer->close_safe;
        $deadline_uv_timer_ref->[0] = undef;
      }
      
      my $uv_poll = $uv_poll_ref->[0];
      if ($uv_poll) {
        $uv_poll->set_poll_cb(undef);
        $uv_poll->close_safe;
        $uv_poll_ref->[0] = undef;
      }
    };
    
    $schedule->{uv_poll_finish_cbs_h}{"$fd"} = $finish_cb;
    
    my $events = $is_read ? UV_C->UV_READABLE : UV_C->UV_WRITABLE;
    my $poll_cb = [$error_id_ref : , $exception_ref : , $finish_cb : , $uv_poll_ref : ] method : void ($uv_poll : UV::Handle::Poll, $status : int, $events : int) {
      if ($status < 0) {
        $error_id_ref->[0] = basic_type_id Error;
        $exception_ref->[0] = UV->strerror($status);
      }
      
      my $p = $uv_poll_ref->[0];
      if ($p) {
        $p->set_poll_cb(undef);
      }
      $finish_cb->();
    };
    
    $uv_poll->start($poll_cb, $events);
    
    if ($context) {
      my $deadline = $context->deadline;
      if ($deadline) {
        my $deadline_cb = [$error_id_ref : , $exception_ref : , $finish_cb : ] method : void ($deadline_uv_timer : UV::Handle::Timer) {
          $error_id_ref->[0] = basic_type_id Go::Context::Error::DeadlineExceeded;
          $exception_ref->[0] = "Context deadline exceeded";
          
          $finish_cb->();
        };
        
        my $now = Go::Time->now;
        my $duration = $deadline->sub($now);
        my $duration_nsec = $duration->{nsec};
        if ($duration_nsec < 0) {
          $duration_nsec = 0L;
        }
        my $deadline_msec = $duration_nsec / 1_000_000;
        
        my $deadline_uv_timer = UV::Handle::Timer->new;
        $deadline_uv_timer_ref->[0] = $deadline_uv_timer;
        $uv_loop->timer_init($deadline_uv_timer);
        
        my $deadline_timer_cb = [$deadline_cb : ] method : void ($deadline_uv_timer : UV::Handle::Timer) {
          $deadline_cb->($deadline_uv_timer);
        };
        
        $deadline_uv_timer->start($deadline_timer_cb, (long)$deadline_msec);
      }
      
      my $cancel_ch = $context->done;
      if ($cancel_ch) {
        my $cancel_cb = [$error_id_ref : , $exception_ref : , $finish_cb : ] method : void () {
          $error_id_ref->[0] = basic_type_id Go::Context::Error::Canceled;
          $exception_ref->[0] = "Context canceled";
          
          $finish_cb->();
        };
        
        my $finish_or_cancel_select = Go->new_select;
        $finish_or_cancel_select->add_read($finish_ch);
        $finish_or_cancel_select->add_read($cancel_ch);
        Go->go([$finish_or_cancel_select : , $finish_ch : , $cancel_ch : , $cancel_cb : ] method : void () {
          my $result = $finish_or_cancel_select->select;
          if ($result->channel == $cancel_ch) {
            $cancel_cb->();
          }
        });
      }
    }
    
    $finish_ch->read;
    
    if ($error_id_ref->[0]) {
      die $error_id_ref->[0], $exception_ref->[0];
    }
  }
  
  static method gosched_poll_cancel : void ($fd : int) {
    
    my $caller_info = caller;
    &gosched_poll_cancel_with_caller_info($fd, $caller_info);
  }
  
  static method gosched_poll_cancel_with_caller_info : void ($fd : int, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    my $uv_poll_finish_cb = $schedule->{uv_poll_finish_cbs_h}{"$fd"};
    
    if ($uv_poll_finish_cb) {
      $uv_poll_finish_cb->();
    }
  }
  
  static method gosched_pipe_read : int ($context : Go::Context, $fd : int, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    my $caller_info = caller;
    return &gosched_pipe_read_with_caller_info($context, $fd, $string, $length, $offset, $caller_info);
  }
  
  private static method gosched_pipe_read_with_caller_info : int ($context : Go::Context, $fd : int, $string : mutable string, $length : int = -1, $offset : int = 0, $caller_info : CallerInfo = undef) {
    
    return &gosched_pipe_io($context, $fd, $string, $length, $offset, 1);
  }
  
  static method gosched_pipe_write : int ($context : Go::Context, $fd : int, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $caller_info = caller;
    return &gosched_pipe_write_with_caller_info($context, $fd, $string, $length, $offset, $caller_info);
  }
  
  private static method gosched_pipe_write_with_caller_info : int ($context : Go::Context, $fd : int, $string : string, $length : int = -1, $offset : int = 0, $caller_info : CallerInfo = undef) {
    
    return &gosched_pipe_io($context, $fd, $string, $length, $offset, 0);
  }
  
  private static method gosched_pipe_io : int ($context : Go::Context, $fd : int, $buffer : string, $buffer_length : int, $buffer_offset : int, $is_read : int) {
    
    if ($buffer_length < 0) {
      $buffer_length = length $buffer;
    }
    
    unless ($fd >= 0) {
      die "The file descriptor \$fd in schedule type TYPE_PIPE_READ or TYPE_PIPE_WRITE must be a non-negative value.";
    }
    
    my $schedule = $GO->{schedule};
    my $uv_loop = $schedule->{uv_loop};
    my $finish_ch = Go->make;
    my $deadline_uv_timer_ref = [(UV::Handle::Timer)undef];
    my $ret_length_ref = [0];
    my $error_id_ref = [(int)0];
    my $exception_ref = [(string)undef];
    
    my $uv_pipe_ref = [(UV::Handle::Pipe)undef];
    my $uv_pipe = UV::Handle::Pipe->new;
    my $ipc = 0;
    $uv_loop->pipe_init($uv_pipe, $ipc);
    my $fd_dup = Sys::IO->dup($fd);
    $uv_pipe->open($fd_dup);
    $uv_pipe_ref->[0] = $uv_pipe;
    
    # Clean up handles and close finish channel
    my $finish_cb = [$schedule : , $finish_ch : , $fd : , $uv_pipe_ref : , $deadline_uv_timer_ref : ] method : void ($args : object...) {
      $finish_ch->close;
      $schedule->{uv_pipe_finish_cbs_h}->delete("$fd");
      
      my $deadline_uv_timer = $deadline_uv_timer_ref->[0];
      if ($deadline_uv_timer) {
        $deadline_uv_timer->set_timer_cb(undef);
        $deadline_uv_timer->close_safe;
        $deadline_uv_timer_ref->[0] = undef;
      }
      
      my $uv_pipe = $uv_pipe_ref->[0];
      if ($uv_pipe) {
        $uv_pipe->close_safe;
        $uv_pipe_ref->[0] = undef;
      }
    };
    
    $schedule->{uv_pipe_finish_cbs_h}{"$fd"} = $finish_cb;
    
    my $deadline_cb = (UV::Callback::Timer)undef;
    my $cancel_cb = (Callback)undef;
    
    if ($is_read) {
      my $read_cb = [$ret_length_ref : , $error_id_ref : , $exception_ref : , $finish_cb : ] method : void ($uv_stream : UV::Handle::Stream, $nread : int, $buf : string) {
        if ($nread < 0) {
          if ($nread == UV_C->UV_EOF) {
            $ret_length_ref->[0] = 0;
          }
          else {
            $error_id_ref->[0] = basic_type_id Error;
            $exception_ref->[0] = UV->strerror($nread);
            $ret_length_ref->[0] = $nread;
          }
        }
        else {
          $ret_length_ref->[0] = $nread;
        }
        
        $uv_stream->read_stop;
        
        $finish_cb->();
      };
      
      $uv_pipe->read_start((mutable string)$buffer, $buffer_length, $read_cb, $buffer_offset);
    }
    else {
      my $uv_req_write = UV::Request::Write->new;
      
      my $write_cb = [$ret_length_ref : , $error_id_ref : , $exception_ref : , $buffer_length : , $finish_cb : , $uv_req_write : ] method : void ($req : UV::Request::Write, $status : int) {
        if ($status < 0) {
          $error_id_ref->[0] = basic_type_id Error;
          $exception_ref->[0] = UV->strerror($status);
        }
        $ret_length_ref->[0] = $buffer_length;
        
        $finish_cb->();
        $uv_req_write->set_write_cb(undef);
      };
      
      $uv_req_write->write($uv_pipe, $buffer, $buffer_length, $write_cb, $buffer_offset);
    }
    
    $deadline_cb = [$error_id_ref : , $exception_ref : , $finish_cb : ] method : void ($deadline_uv_timer : UV::Handle::Timer) {
      $error_id_ref->[0] = basic_type_id Go::Context::Error::DeadlineExceeded;
      $exception_ref->[0] = "Context deadline exceeded";
      
      $finish_cb->();
    };
    
    $cancel_cb = [$error_id_ref : , $exception_ref : , $finish_cb : ] method : void () {
      $error_id_ref->[0] = basic_type_id Go::Context::Error::Canceled;
      $exception_ref->[0] = "Context canceled";
      
      $finish_cb->();
    };
    
    my $cancel_ch = (Go::Channel)undef;
    if ($context) {
      my $deadline = $context->deadline;
      if ($deadline) {
        my $now = Go::Time->now;
        my $duration = $deadline->sub($now);
        my $duration_nsec = $duration->{nsec};
        if ($duration_nsec < 0) {
          $duration_nsec = 0L;
        }
        my $deadline_msec = $duration_nsec / 1_000_000;
        
        my $deadline_uv_timer = UV::Handle::Timer->new;
        $deadline_uv_timer_ref->[0] = $deadline_uv_timer;
        $uv_loop->timer_init($deadline_uv_timer);
        
        my $deadline_timer_cb = [$deadline_cb : ] method : void ($deadline_uv_timer : UV::Handle::Timer) {
          $deadline_cb->($deadline_uv_timer);
        };
        
        $deadline_uv_timer->start($deadline_timer_cb, (long)$deadline_msec);
      }
      
      $cancel_ch = $context->done;
    }
    
    if ($cancel_ch) {
      my $finish_or_cancel_select = Go->new_select;
      $finish_or_cancel_select->add_read($finish_ch);
      $finish_or_cancel_select->add_read($cancel_ch);
      Go->go([$finish_or_cancel_select : , $finish_ch : , $cancel_ch : , $cancel_cb : ] method : void () {
        my $result = $finish_or_cancel_select->select;
        if ($result->channel == $cancel_ch) {
          $cancel_cb->();
        }
      });
    }
    
    $finish_ch->read;
    
    if ($error_id_ref->[0]) {
      die $error_id_ref->[0], $exception_ref->[0];
    }
    
    return $ret_length_ref->[0];
  }
  
  static method gosched_pipe_cancel : void ($fd : int) {
    
    my $caller_info = caller;
    &gosched_pipe_cancel_with_caller_info($fd, $caller_info);
  }
  
  static method gosched_pipe_cancel_with_caller_info : void ($fd : int, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    my $uv_pipe_finish_cb = $schedule->{uv_pipe_finish_cbs_h}{"$fd"};
    
    if ($uv_pipe_finish_cb) {
      $uv_pipe_finish_cb->();
    }
  }
  
  private method DESTROY : void () {
    
    my $schedule = $self->{schedule};
    
  }
  
  static method ENV_DEBUG : int () {
    
    my $debug = (int)Sys->env("SPVM_GO_DEBUG");
    
    return $debug;
  }
  
  static method bg : Go::Context () {
    return Go::Context->background;
  }
  
  static method todo : Go::Context () {
    return Go::Context->todo;
  }
  
  static method gosched_poll_read : void ($context : Go::Context, $fd : int) {
    
    my $caller_info = caller;
    &gosched_poll_read_with_caller_info($context, $fd, $caller_info);
  }
  
  static method gosched_poll_write : void ($context : Go::Context, $fd : int) {
    
    my $caller_info = caller;
    &gosched_poll_write_with_caller_info($context, $fd, $caller_info);
  }
  
  static method new_wait_group : Go::Sync::WaitGroup ($add : int = 0) {
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add($add);
    
    return $wg;
  }
  
  static method new_command : Go::OS::Exec::Cmd ($context : Go::Context, $command : string[]) {
    
    my $cmd = Go::OS::Exec->command($context, $command);
    
    return $cmd;
  }
  
  static method uv_loop : UV::Loop () {
    return $Go::GO->{schedule}{uv_loop};
  }

  static method sysread_uv_stream : int ($context : Go::Context, $uv_stream : UV::Handle::Stream, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    unless ($uv_stream) {
      die "The uv_stream must be defined.";
    }
    
    my $string_len = length $string;
    if ($offset < 0 || $offset > $string_len) {
      die "The offset is out of range.";
    }
    
    if ($length < 0) {
      $length = $string_len - $offset;
    }
    if ($offset + $length > $string_len) {
      die "The length is out of range.";
    }
    if ($length == 0) {
      return 0;
    }
    
    my $done_ch = $context ? $context->done : undef;
    my $result_ch = Go->make(1);
    my $done_ref = [0];
    my $read_buf = new_string_len $length;
    
    # Send read result once
    my $send_result = [$result_ch : , $done_ref : ] method : void ($nread : int, $buf : string, $err : int) {
      if ($done_ref->[0]) {
        return;
      }
      $done_ref->[0] = 1;
      $result_ch->write([(object)$nread, $buf, $err]);
    };
    
    my $read_cb = [$uv_stream : , $send_result : , $done_ref : ] method : void ($stream : UV::Handle::Stream, $nread : int, $buf : mutable string) {
      $stream->read_stop;
      
      if ($done_ref->[0]) {
        return;
      }
      
      if ($nread > 0) {
        my $copy_buf = new_string_len $nread;
        Fn->memcpy($copy_buf, 0, $buf, 0, $nread);
        $send_result->($nread, $copy_buf, 0);
      }
      elsif ($nread == 0) {
        # Retry read on empty callback
        $stream->read_start($buf, length $buf, $self);
      }
      elsif ($nread == UV_C->UV_EOF) {
        $send_result->(0, undef, 0);
      }
      else {
        $send_result->(-1, undef, $nread);
      }
    };
    weaken $read_cb->{uv_stream};
    
    $uv_stream->read_start($read_buf, $length, $read_cb);
    
    my $res = (object[])undef;
    if ($done_ch) {
      my $select = Go->new_select;
      $select->add_read($result_ch);
      $select->add_read($done_ch);
      
      my $selected = $select->select;
      if ($selected->channel == $result_ch && !$selected->is_write) {
        $res = (object[])$selected->value;
      }
      elsif ($selected->channel == $done_ch && !$selected->is_write) {
        # Stop read on context done
        $done_ref->[0] = 1;
        $uv_stream->read_stop;
        die $context->err;
      }
    }
    else {
      $res = (object[])$result_ch->read;
    }
    
    my $nread = (int)$res->[0];
    my $err = (int)$res->[2];
    if ($err < 0) {
      die "libuv read error:" . UV->strerror($err);
    }
    if ($nread > 0) {
      my $data = (string)$res->[1];
      Fn->memcpy($string, $offset, $data, 0, $nread);
    }
    
    return $nread;
  }
  
  static method syswrite_uv_stream : int ($context : Go::Context, $uv_stream : UV::Handle::Stream, $string : string, $length : int = -1, $offset : int = 0) {
    
    unless ($uv_stream) {
      die "The uv_stream must be defined.";
    }
    
    unless ($string) {
      die "The string must be defined.";
    }
    
    my $string_len = length $string;
    if ($offset < 0 || $offset > $string_len) {
      die "The offset is out of range.";
    }
    
    if ($length < 0) {
      $length = $string_len - $offset;
    }
    if ($offset + $length > $string_len) {
      die "The length is out of range.";
    }
    if ($length == 0) {
      return 0;
    }
    
    my $done_ch = $context ? $context->done : undef;
    my $result_ch = Go->make(1);
    my $done_ref = [0];
    
    my $write_buf = new_string_len $length;
    Fn->memcpy($write_buf, 0, $string, $offset, $length);
    
    my $write_req = UV::Request::Write->new;
    my $write_cb = [$result_ch : , $done_ref : , $write_req : , $length : ] method : void ($req : UV::Request::Write, $status : int) {
      $req->set_write_cb(undef);
      if ($done_ref->[0]) {
        return;
      }
      $done_ref->[0] = 1;
      if ($status < 0) {
        $result_ch->write([-1, $status]);
      }
      else {
        $result_ch->write([$length, 0]);
      }
    };
    
    $write_req->write($uv_stream, $write_buf, $length, $write_cb);
    
    my $res = (int[])undef;
    if ($done_ch) {
      my $select = Go->new_select;
      $select->add_write($result_ch, 1);
      $select->add_read($done_ch);
      
      my $selected = $select->select;
      if ($selected->channel == $result_ch && $selected->is_write) {
        $res = (int[])$selected->value;
      }
      elsif ($selected->channel == $done_ch && !$selected->is_write) {
        # Ignore late callback after done
        $done_ref->[0] = 1;
        die $context->err;
      }
    }
    else {
      $res = (int[])$result_ch->read;
    }
    
    my $written = $res->[0];
    my $status = $res->[1];
    if ($status < 0) {
      die "libuv write error:" . UV->strerror($status);
    }
    
    return $written;
  }
  
}

