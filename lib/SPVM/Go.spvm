class Go {
  version "0.047";
  
  allow Go::OS::Exec::Cmd;
  
  use Go::Channel;
  use Go::Schedule;
  use Callback;
  use Go::Select;
  use Go::Duration_1l;
  use Go::Context;
  
  our $GO : Go;
  
  has schedule : Go::Schedule;
  
  INIT {
    my $go = new Go;
    
    my $schedule = Go::Schedule->new;
    
    $go->{schedule} = $schedule;
    
    $GO = $go;
  }
  
  static method go : void ($task : Callback) {
    
    my $schedule = $GO->{schedule};
    
    my $caller_info = caller;
    
    $schedule->add_task($task, $caller_info);
  }
  
  static method make : Go::Channel ($capacity : int = 0) {
    
    my $schedule = $GO->{schedule};
    
    my $channel = Go::Channel->new({schedule => $schedule, capacity => $capacity});
    
    return $channel;
  }
  
  static method new_select : Go::Select () {
    
    my $schedule = $GO->{schedule};
    
    my $select = Go::Select->new($schedule);
    
    return $select;
  }
  
  static method gosched : void () {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    
    my $caller_info = caller;
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  static method sleep : void ($duration : Go::Duration_1l = undef) {
    
    my $_ = Go::Context->with_timeout(Go->bg, $duration);
    my $context = $_->context;
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_SLEEP;
    $schedule_info->{context} = $context;
    
    my $caller_info = caller;
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  static method sleep_sec : void ($sec : double = 0) {
    
    my $duration = Go::Duration_1l->new_from_sec($sec);
    
    &sleep($duration);
  }
  
  static method after : Go::Channel ($duration : Go::Duration_1l = undef) {
    
    my $duration_nsec = $duration->{nsec};
    
    my $ch = Go->make;
    
    Go->go([$ch : , $duration_nsec : ] method : void () {
      my $duration = Go::Duration_1l->new($duration_nsec);
      Go->sleep($duration);
      
      $ch->write(1);
    });
    
    return $ch;
  }
  
  static method after_sec : Go::Channel ($sec : double = 0) {
    
    my $duration = Go::Duration_1l->new_from_sec($sec);
    
    return &after($duration);
  }
  
  static method gosched_io_read : void ($fd : int, $timeout_duration : Go::Duration_1l = undef) {
    
    my $context = (Go::Context)undef;
    if ($timeout_duration->{nsec} > 0) {
      my $_ = Go::Context->with_timeout(Go->bg, $timeout_duration);
      $context = $_->context;
    }
    else {
      $context = Go->bg;
    }
    
    my $caller_info = caller;
    &gosched_io_read_with_caller_info($context, $fd, Go::Duration_1l->new(0), $caller_info);
  }
  
  static method gosched_io_read_sec : void ($fd : int, $timeout_sec : double = 0) {
    
    my $timeout_duration = Go::Duration_1l->new_from_sec($timeout_sec);
    
    my $context = (Go::Context)undef;
    if ($timeout_duration->{nsec} > 0) {
      my $_ = Go::Context->with_timeout(Go->bg, $timeout_duration);
      $context = $_->context;
    }
    else {
      $context = Go->bg;
    }
    
    my $caller_info = caller;
    &gosched_io_read_with_caller_info($context, $fd, Go::Duration_1l->new(0), $caller_info);
  }
  
  private static method gosched_io_read_with_caller_info : void ($context : Go::Context, $fd : int, $timeout_duration : Go::Duration_1l = undef, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_POLL_READ;
    $schedule_info->{fd} = $fd;
    $schedule_info->{context} = $context;
    
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  static method gosched_io_write : void ($fd : int, $timeout_duration : Go::Duration_1l = undef) {
    
    my $caller_info = caller;
    &gosched_io_write_with_caller_info(Go->bg, $fd, $timeout_duration, $caller_info);
  }
  
  static method gosched_io_write_sec : void ($fd : int, $timeout_sec : double = 0) {
    
    my $timeout_duration = Go::Duration_1l->new_from_sec($timeout_sec);
    
    my $caller_info = caller;
    &gosched_io_write_with_caller_info(Go->bg, $fd, $timeout_duration, $caller_info);
  }
  
  static method gosched_io_write_with_caller_info : void ($context : Go::Context, $fd : int, $timeout_duration : Go::Duration_1l = undef, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_POLL_WRITE;
    $schedule_info->{fd} = $fd;
    $schedule_info->{timeout_duration_nsec} = $timeout_duration->{nsec};
    $schedule_info->{context} = $context;
    
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  static method gosched_io_cancel : void ($fd : int) {
    
    my $caller_info = caller;
    &gosched_io_cancel_with_caller_info($fd, $caller_info);
  }
  
  static method gosched_io_cancel_with_caller_info : void ($fd : int, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_POLL_CANCEL;
    $schedule_info->{fd} = $fd;
    
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  static method gosched_pipe_read : int ($fd : int, $string : mutable string, $length : int = -1, $offset : int = 0, $timeout_duration : Go::Duration_1l = undef) {
    
    my $caller_info = caller;
    return &gosched_pipe_read_with_caller_info(Go->bg, $fd, $string, $length, $offset, $timeout_duration, $caller_info);
  }
  
  static method gosched_pipe_read_sec : int ($fd : int, $string : mutable string, $length : int = -1, $offset : int = 0, $timeout_sec : double = 0) {
    
    my $timeout_duration = Go::Duration_1l->new_from_sec($timeout_sec);
    
    my $caller_info = caller;
    return &gosched_pipe_read_with_caller_info(Go->bg, $fd, $string, $length, $offset, $timeout_duration, $caller_info);
  }
  
  private static method gosched_pipe_read_with_caller_info : int ($context : Go::Context, $fd : int, $string : mutable string, $length : int = -1, $offset : int = 0, $timeout_duration : Go::Duration_1l = undef, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_PIPE_READ;
    $schedule_info->{fd} = $fd;
    $schedule_info->{timeout_duration_nsec} = $timeout_duration->{nsec};
    $schedule_info->{buffer} = $string;
    $schedule_info->{buffer_length} = $length;
    $schedule_info->{buffer_offset} = $offset;
    $schedule_info->{context} = $context;
    
    $schedule->schedule($schedule_info, $caller_info);
    
    my $read_length = $schedule_info->{ret_length};
    
    return $read_length;
  }
  
  static method gosched_pipe_write : int ($fd : int, $string : string, $length : int = -1, $offset : int = 0, $timeout_duration : Go::Duration_1l = undef) {
    
    my $caller_info = caller;
    return &gosched_pipe_write_with_caller_info(Go->bg, $fd, $string, $length, $offset, $timeout_duration, $caller_info);
  }
  
  static method gosched_pipe_write_sec : int ($fd : int, $string : string, $length : int = -1, $offset : int = 0, $timeout_sec : double = 0) {
    
    my $timeout_duration = Go::Duration_1l->new_from_sec($timeout_sec);
    
    my $caller_info = caller;
    return &gosched_pipe_write_with_caller_info(Go->bg, $fd, $string, $length, $offset, $timeout_duration, $caller_info);
  }
  
  private static method gosched_pipe_write_with_caller_info : int ($context : Go::Context, $fd : int, $string : string, $length : int = -1, $offset : int = 0, $timeout_duration : Go::Duration_1l = undef, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_PIPE_WRITE;
    $schedule_info->{fd} = $fd;
    $schedule_info->{timeout_duration_nsec} = $timeout_duration->{nsec};
    $schedule_info->{buffer} = $string;
    $schedule_info->{buffer_length} = $length;
    $schedule_info->{buffer_offset} = $offset;
    $schedule_info->{context} = $context;
    
    $schedule->schedule($schedule_info, $caller_info);
    
    my $write_length = $schedule_info->{ret_length};
    
    return $write_length;
  }
  
  static method gosched_pipe_cancel : void ($fd : int) {
    
    my $caller_info = caller;
    &gosched_pipe_cancel_with_caller_info($fd, $caller_info);
  }
  
  static method gosched_pipe_cancel_with_caller_info : void ($fd : int, $caller_info : CallerInfo = undef) {
    
    my $schedule = $GO->{schedule};
    
    my $schedule_info = new Go::Schedule::Info;
    $schedule_info->{type} = Go::Schedule::Info->TYPE_PIPE_CANCEL;
    $schedule_info->{fd} = $fd;
    
    $schedule->schedule($schedule_info, $caller_info);
  }
  
  private method DESTROY : void () {
    
    my $schedule = $self->{schedule};
    
  }
  
  static method ENV_DEBUG : int () {
    
    my $debug = (int)Sys->env("SPVM_GO_DEBUG");
    
    return $debug;
  }
  
  static method bg : Go::Context () {
    return Go::Context->background;
  }
  
  static method todo : Go::Context () {
    return Go::Context->todo;
  }
  
  static method gosched_io_read_v2 : void ($context : Go::Context, $fd : int) {
    
    my $caller_info = caller;
    &gosched_io_read_with_caller_info($context, $fd, undef, $caller_info);
  }
  
  static method gosched_io_write_v2 : void ($context : Go::Context, $fd : int) {
    
    my $caller_info = caller;
    &gosched_io_write_with_caller_info($context, $fd, undef, $caller_info);
  }
  
  static method gosched_pipe_read_v2 : int ($context : Go::Context, $fd : int, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    my $caller_info = caller;
    return &gosched_pipe_read_with_caller_info($context, $fd, $string, $length, $offset, undef, $caller_info);
  }
  
  static method gosched_pipe_write_v2 : int ($context : Go::Context, $fd : int, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $caller_info = caller;
    return &gosched_pipe_write_with_caller_info($context, $fd, $string, $length, $offset, undef, $caller_info);
  }
}

