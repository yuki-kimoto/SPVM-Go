class TestCase::Go::Poll {
  use Go;
  use Sys::Socket;
  use Sys::Socket::Constant as SOCKET;
  use Sys::OS;
  use Sys::IO::Constant as IO;
  use Sys::Ioctl::Constant as IOCTL;
  use Sys::Socket::Util;
  use Errno;
  use StringList;
  use Sys::Socket::Errno;
  use Go::Error::IOTimeout;
  use Fn;
  use Array;
  use StringBuffer;

  our $RESULTS : StringList[];

  static method basic : int () {
    
    $RESULTS = new StringList[2];
    $RESULTS->[0] = StringList->new;
    
    my $fd1 = -1;
    my $fd2 = -1;
    Sys::Socket::Util->inet_socketpair(\$fd1, \$fd2, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);
    Sys::Socket::Util->set_blocking($fd1, 0);
    Sys::Socket::Util->set_blocking($fd2, 0);
    
    # Run echo goroutine
    &spawn_echo($fd2, 0);
    
    Go->go([$fd1 : int] method : void () {
      my $id = 0;
      &go_send_and_recv_fd($fd1, $id, 0);
      Sys::Socket->close($fd1);
    });
    
    Go->gosched;
    
    unless (Array->equals_string($RESULTS->[0]->to_array, ["4", "2", "0", "3", "abc", "3", "def", "0"])) {
      return 0;
    }
    
    $RESULTS = undef;
    return 1;
  }

  static method parallel : int () {
    
    $RESULTS = new StringList[2];
    $RESULTS->[0] = StringList->new;
    $RESULTS->[1] = StringList->new;
    
    my $fd1_a = -1;
    my $fd2_a = -1;
    Sys::Socket::Util->inet_socketpair(\$fd1_a, \$fd2_a, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);
    Sys::Socket::Util->set_blocking($fd1_a, 0);
    Sys::Socket::Util->set_blocking($fd2_a, 0);
    &spawn_echo($fd2_a, 0);
    
    my $fd1_b = -1;
    my $fd2_b = -1;
    Sys::Socket::Util->inet_socketpair(\$fd1_b, \$fd2_b, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);
    Sys::Socket::Util->set_blocking($fd1_b, 0);
    Sys::Socket::Util->set_blocking($fd2_b, 0);
    &spawn_echo($fd2_b, 0);
    
    Go->go([$fd1_a : int, $fd1_b : int] method : void () {
      Go->go([$fd1_a : int] method : void () {
        my $id = 0;
        &go_send_and_recv_fd($fd1_a, $id, 0);
        Sys::Socket->close($fd1_a);
      });
      
      Go->go([$fd1_b : int] method : void () {
        my $id = 1;
        &go_send_and_recv_fd($fd1_b, $id, 0);
        Sys::Socket->close($fd1_b);
      });
    });
    
    Go->gosched;
    
    unless (Array->equals_string($RESULTS->[0]->to_array, ["4", "2", "0", "3", "abc", "3", "def", "0"])) {
      return 0;
    }
    
    unless (Array->equals_string($RESULTS->[1]->to_array, ["4", "2", "0", "3", "abc", "3", "def", "0"])) {
      return 0;
    }
    
    $RESULTS = undef;
    return 1;
  }

  static method timeout : int () {
    
    my $results = new int[2];
    
    Go->go([$results : int[]] method : void () {
      my $fd1 = -1;
      my $fd2 = -1;
      Sys::Socket::Util->inet_socketpair(\$fd1, \$fd2, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);
      
      # Close sockets on exit
      Fn->defer([$fd1 : int, $fd2 : int] method : void () {
        Sys::Socket->close($fd1);
        Sys::Socket->close($fd2);
      });
      
      # Test read timeout
      eval { Go->gosched_io_read_sec($fd1, 0.25); };
      
      if ($@) {
        if (eval_error_id is_error Go::Error::IOTimeout) {
          $results->[0] = 1;
        }
        $@ = undef;
      }
    });
    
    Go->gosched;
    
    unless ($results->[0]) {
      diag;
      return 0;
    }
    
    return 1;
  }
  
  static method spawn_echo : void ($fd : int, $delay_sec : double = 0) {
    Go->go([$fd : int, $delay_sec : double] method : void () {
      if ($delay_sec > 0) {
        Go->sleep_sec($delay_sec);
      }
      
      my $total_buf = StringBuffer->new;
      while (1) {
        my $buf = (mutable string)new_string_len 256;
        my $read_len = &go_recv($fd, $buf, length $buf, 0, 0);
        
        if ($read_len <= 0) {
          last;
        }
        
        my $slice = Fn->substr($buf, 0, $read_len);
        $total_buf->push($slice);
      }
      
      # Echo back all buffered data after EOF
      my $response = $total_buf->to_string;
      if (length $response > 0) {
        &go_send($fd, $response, 0, undef, 0);
      }
      
      Sys::Socket->close($fd);
    });
  }

  static method go_send_and_recv_fd : int ($fd : int, $id : int, $timeout : double = 0) {
    
    my $status = 0;
    
    {
      my $send_buffer = "abcd";
      my $send_length = &go_send($fd, $send_buffer, 0, undef, $timeout);
      $RESULTS->[$id]->push((string)$send_length);
    }
    
    {
      my $send_buffer = "ef";
      my $send_length = &go_send($fd, $send_buffer, 0, undef, $timeout);
      $RESULTS->[$id]->push((string)$send_length);
    }
    
    my $status_shutdown = Sys::Socket->shutdown($fd, SOCKET->SHUT_WR);
    $RESULTS->[$id]->push((string)$status_shutdown);
    
    {
      my $recv_buffer = (mutable string)new_string_len 3;
      my $recv_length = &go_recv($fd, $recv_buffer, length $recv_buffer, 0, $timeout);
      if ($recv_length < 0) { return 1; }
      $RESULTS->[$id]->push((string)$recv_length);
      $RESULTS->[$id]->push($recv_buffer);
    }
    
    {
      my $recv_buffer = (mutable string)new_string_len 3;
      my $recv_length = &go_recv($fd, $recv_buffer, length $recv_buffer, 0, $timeout);
      if ($recv_length < 0) { return 1; }
      $RESULTS->[$id]->push((string)$recv_length);
      $RESULTS->[$id]->push($recv_buffer);
    }
    
    {
      my $recv_buffer = (mutable string)new_string_len 3;
      my $recv_length = &go_recv($fd, $recv_buffer, length $recv_buffer, 0, $timeout);
      if ($recv_length < 0) { return 1; }
      $RESULTS->[$id]->push((string)$recv_length);
    }
    
    return $status;
  }

  static method go_recv : int ($socket : int, $buf : mutable string, $count : int, $buf_offset : int = 0, $timeout : double = 0) {
    
    my $recv_length = -1;
    while (1) {
      eval { $recv_length = Sys->recv($socket, $buf, length $buf, 0); }
      
      if ($@) {
        if (Sys::Socket::Errno->errno == Sys::Socket::Errno->EWOULDBLOCK || Sys::Socket::Errno->errno == Errno->EINTR) {
          Go->gosched_io_read_sec($socket, $timeout);
        }
        else {
          die $@;
        }
      }
      else {
        last;
      }
    }
    
    return $recv_length;
  }

  static method go_send : int ($socket : int, $buf : string, $flags : int, $addr : Sys::Socket::Sockaddr = undef, $timeout : double = 0) {
    
    my $send_length = -1;
    while (1) {
      eval { $send_length = Sys->send($socket, $buf, 0); }
      
      if ($@) {
        if (Sys::Socket::Errno->errno == Sys::Socket::Errno->EWOULDBLOCK || Sys::Socket::Errno->errno == Errno->EINTR) {
          Go->gosched_io_write_sec($socket, $timeout);
        }
        else {
          die $@;
        }
      }
      else {
        last;
      }
    }
    
    return $send_length;
  }

  static method gosched_io_cancel : int () {
    
    my $socket_fd1 = -1;
    my $socket_fd2 = -1;
    
    my $domain = Sys::Socket::Constant->AF_INET;
    my $type = Sys::Socket::Constant->SOCK_STREAM;
    my $protocol = 0;
    
    Sys::Socket::Util->inet_socketpair(\$socket_fd1, \$socket_fd2, $domain, $type, $protocol);
    
    Fn->defer([$socket_fd1 : int, $socket_fd2 : int] method : void () {
      Sys::Socket->close($socket_fd1);
      Sys::Socket->close($socket_fd2);
    });
    
    Sys::Socket::Util->set_blocking($socket_fd1, 0);
    Sys::Socket::Util->set_blocking($socket_fd2, 0);
    
    Go->go([$socket_fd1 : int] method : void () {
      Go->sleep_sec(0.5);
      Go->gosched_io_cancel($socket_fd1);
    });
    
    Go->gosched_io_read_sec($socket_fd1, 100);
    
    # Check doing nothing
    Go->gosched_io_cancel($socket_fd1);
    
    return 1;
  }
}
