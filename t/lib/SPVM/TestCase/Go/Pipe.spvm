class TestCase::Go::Pipe {
  use Go;
  use Sys;
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::IO::Constant as IO_C;
  use Sys::OS;
  
  use Go::Goroutine;
  
  static method basic : int () {
    
    {
      my $read_fh = -1;
      my $write_fh = -1;
      my $non_blocking = 1;
      
      Go::Goroutine->_pipepair(\$read_fh, \$write_fh, $non_blocking);
      
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          my $write_buffer_length = length $write_buffer;
          $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer, $write_buffer_length);
        });
        Go->gosched;
        
        my $read_buffer = new_string_len 3;
        my $read_buffer_length = length $read_buffer;
        my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length);
        
        unless ($write_length_ref->[0] == 3) {
          return 0;
        }
        
        unless ($read_buffer eq "abc") {
          return 0;
        }
        
        unless ($read_length == 3) {
          return 0;
        }
      }
      
      # Optional argument default
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer);
        });
        Go->gosched;
        
        my $read_buffer = new_string_len 3;
        my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer);
        
        unless ($write_length_ref->[0] == 3) {
          return 0;
        }
        
        unless ($read_buffer eq "abc") {
          return 0;
        }
        
        unless ($read_length == 3) {
          return 0;
        }
      }
      
      # legnth
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          my $write_buffer_length = 2;
          $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer, $write_buffer_length);
        });
        Go->gosched;
        
        my $read_buffer = new_string_len 3;
        my $read_buffer_length = 2;
        my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length);
        
        unless ($write_length_ref->[0] == 2) {
          return 0;
        }
        
        unless ($read_buffer eq "ab\0") {
          return 0;
        }
        
        unless ($read_length == 2) {
          return 0;
        }
      }
      
      # offset
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          my $write_buffer_length = 2;
          my $write_buffer_offset = 1;
          $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer, $write_buffer_length, $write_buffer_offset);
        });
        Go->gosched;
        
        my $read_buffer = new_string_len 3;
        my $read_buffer_length = 2;
        my $read_buffer_offset = 1;
        my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length, $read_buffer_offset);
        
        unless ($write_length_ref->[0] == 2) {
          diag $write_length_ref->[0];
          return 0;
        }
        
        unless ($read_buffer eq "\0bc") {
          diag $read_buffer;
          return 0;
        }
        
        unless ($read_length == 2) {
          diag $read_length;
          return 0;
        }
      }
      
      # 0 bytes write
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          
          {
            my $write_buffer_length = 0;
            Go->gosched_pipe_write($write_fh, $write_buffer, 0);
          }
          
          {
            my $write_buffer_length = length $write_buffer;
            $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer, $write_buffer_length);
          }
        });
        Go->gosched;
        
        my $read_buffer = new_string_len 3;
        my $read_buffer_length = length $read_buffer;
        my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length);
        
        unless ($write_length_ref->[0] == 3) {
          return 0;
        }
        
        unless ($read_buffer eq "abc") {
          return 0;
        }
        
        unless ($read_length == 3) {
          return 0;
        }
      }
      
      # read multi-times
      {
        my $write_length_ref = [-1];
        Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
          my $write_buffer = "abc";
          $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer);
        });
        Go->gosched;
        
        {
          my $read_buffer = new_string_len 3;
          my $read_buffer_length = 2;
          my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length);
          
          unless ($read_buffer eq "ab\0") {
            return 0;
          }
          
          unless ($read_length == 2) {
            return 0;
          }
        }
        
        {
          my $read_buffer = new_string_len 3;
          my $read_buffer_length = 1;
          my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, $read_buffer_length);
          
          unless ($read_buffer eq "c\0\0") {
            return 0;
          }
          
          unless ($read_length == 1) {
            return 0;
          }
        }
        
      }
      
    }
    
    return 1;
  }
  
  static method timeout : int () {
    
    {
      my $read_fh = -1;
      my $write_fh = -1;
      my $non_blocking = 1;
      
      Go::Goroutine->_pipepair(\$read_fh, \$write_fh, $non_blocking);
      
      {
        my $read_buffer = new_string_len 3;
        my $read_buffer_length = length $read_buffer;
        my $read_buffer_offset = 0;
        my $timeout_sec = 0.5;
        
        Go->gosched_pipe_read_sec($read_fh, $read_buffer, $read_buffer_length, $read_buffer_offset, $timeout_sec);
        
      }
      
    }
    
    return 1;
  }
  
}
