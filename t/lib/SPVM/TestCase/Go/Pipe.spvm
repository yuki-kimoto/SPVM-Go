class TestCase::Go::Pipe {
  use Go;
  use Sys;
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::IO::Constant as IO_C;
  use Sys::OS;
  
  static method basic : int () {
    
    {
      my $read_fh = -1;
      my $write_fh = -1;
      
      Sys->socketpair(\$read_fh, \$write_fh, SOCKET_C->AF_UNIX, SOCKET_C->SOCK_STREAM, 0);
      
      Sys->fcntl($read_fh, IO_C->F_SETFL, IO_C->O_NONBLOCK);
      Sys->fcntl($write_fh, IO_C->F_SETFL, IO_C->O_NONBLOCK);
      
      my $write_length_ref = [-1];
      Go->go([$write_fh : int, $write_length_ref : int[]] method : void () {
        my $write_buffer = "abc";
        $write_length_ref->[0] = Go->gosched_pipe_write($write_fh, $write_buffer, length $write_buffer);
      });
      Go->gosched;
      
      my $read_buffer = new_string_len 3;
      my $read_length = Go->gosched_pipe_read($read_fh, $read_buffer, length $read_buffer);
      
      unless ($write_length_ref->[0] == 3) {
        return 0;
      }
      
      unless ($read_buffer eq "abc") {
        return 0;
      }
      
      unless ($read_length == 3) {
        return 0;
      }
    }
    
    return 1;
  }
  
}
