class TestCase::Go::Context {
  use Go::Context;
  use Go::Context::Derived;
  use Go::Time;
  use Go::Duration_1l;
  use Go::Context::Error::Canceled;
  use Go::Context::Error::DeadlineExceeded;
  use Go;

  # Test for background method
  static method background : int () {
    my $success_ref = [0];
    
    # Run background test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx = Go::Context->background;
        
        # Should be defined
        unless ($ctx) {
          return;
        }
        
        # Should not have a deadline
        if ($ctx->deadline) {
          return;
        }
        
        # Error should be 0 (no error)
        if ($ctx->err > 0) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }

  # Test for without_cancel (child should not be canceled by parent)
  static method without_cancel : int () {
    my $success_ref = [0];
    
    # Run without_cancel test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $parent_derived = Go::Context->background->with_cancel;
        my $ctx_child = $parent_derived->context->without_cancel;
        
        # Cancel the parent
        $parent_derived->cancel_cb->("parent is canceled");
        
        # Parent must be canceled
        unless ($parent_derived->context->err > 0) {
          return;
        }
        
        # Child must NOT be canceled
        if ($ctx_child->err > 0) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }

  # Test for with_cancel method and manual cancellation
  static method with_cancel : int () {
    my $success_ref = [0];
    
    # Run with_cancel test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        my $derived = $ctx_parent->with_cancel;
        my $ctx = $derived->context;
        my $cancel = $derived->cancel_cb;

        # Check initial state
        if ($ctx->err > 0) {
          return;
        }
        
        # Execution of cancellation
        $cancel->();
        
        # Error must be Go::Context::Error::Canceled type ID
        unless ($ctx->err == basic_type_id Go::Context::Error::Canceled) {
          return;
        }
        
        # Cause must match the message
        unless ($ctx->cause eq "context canceled") {
          return;
        }
      }
      
      {
        my $ctx_p_derived = Go::Context->background->with_cancel;
        my $key = "ID";
        my $value = "foo";
        my $ctx_v = $ctx_p_derived->context->with_value($key, $value);
        my $ctx_c_derived = $ctx_v->with_cancel;
        my $ctx_gc_derived = $ctx_c_derived->context->with_cancel;

        # Cancel the top-level parent
        $ctx_p_derived->cancel_cb->();

        # Grandchild must also be canceled
        unless ($ctx_gc_derived->context->err == basic_type_id Go::Context::Error::Canceled) {
          return;
        }
        
        unless ($ctx_gc_derived->context->value($key)->(string) eq "foo") {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for with_cancel_cause
  static method with_cancel_cause : int () {
    my $success_ref = [0];
    
    # Run with_cancel_cause test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        my $cause_msg = "critical error occurred";
        my $derived = $ctx_parent->with_cancel_cause($cause_msg);
        my $ctx = $derived->context;
        my $cancel = $derived->cancel_cb;

        # Execute cancellation with the specific cause
        $cancel->($cause_msg);
        
        # Check error type
        unless ($ctx->err == basic_type_id Go::Context::Error::Canceled) {
          return;
        }
        
        # Check if the custom cause is correctly stored
        unless ($ctx->cause eq $cause_msg) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for with_deadline (using absolute Go::Time)
  static method with_deadline : int () {
    my $success_ref = [0];
    
    # Run deadline test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        
        # Set deadline to 3 seconds from now
        my $timeout_sec = 3;
        my $deadline = Go::Time->now->add_sec($timeout_sec);
        
        my $derived = $ctx_parent->with_deadline($deadline);
        my $ctx = $derived->context;
        
        # Check if the deadline is correctly set
        unless ($ctx->deadline->equal($deadline)) {
          diag;
          return;
        }
        
        # Should not be expired yet
        if ($ctx->err > 0) {
          diag $ctx->err;
          diag $ctx->cause;
          return;
        }
      }
      
      {
        my $ctx_parent = Go::Context->background;
        
        # Set deadline to 0.2 seconds from now
        my $timeout_sec = 0.2;
        my $deadline = Go::Time->now->add_sec($timeout_sec);
        
        my $derived_c1 = $ctx_parent->with_deadline($deadline);
        my $ctx_c1 = $derived_c1->context;
        
        my $deadline_c2 = $deadline->add_sec(-0.1);
        my $derived_c2 = $ctx_c1->with_deadline($deadline_c2);
        my $ctx_c2 = $derived_c2->context;
        
        # Check if the deadline is correctly set
        unless ($ctx_c2->deadline->unix == $deadline_c2->unix) {
          diag;
          return;
        }
        
        unless ($ctx_c2->deadline->nanosecond == $deadline_c2->nanosecond) {
          diag;
          return;
        }
        
        unless ($ctx_c2->deadline->_mono_duration_nsec == $deadline_c2->_mono_duration_nsec) {
          diag;
          return;
        }
      }
      
      {
        my $ctx_parent = Go::Context->background;
        
        # Set deadline to 0.2 seconds from now
        my $timeout_sec = 0.2;
        my $deadline = Go::Time->now->add_sec($timeout_sec);
        
        my $derived_c1 = $ctx_parent->with_deadline($deadline);
        my $ctx_c1 = $derived_c1->context;
        
        my $deadline_c2 = $deadline->add_sec(0.1);
        my $derived_c2 = $ctx_c1->with_deadline($deadline_c2);
        my $ctx_c2 = $derived_c2->context;
        
        # Check if the deadline is correctly set
        unless ($ctx_c2->deadline->unix == $deadline->unix) {
          diag;
          return;
        }
        
        unless ($ctx_c2->deadline->nanosecond == $deadline->nanosecond) {
          diag;
          return;
        }
        
        unless ($ctx_c2->deadline->_mono_duration_nsec == $deadline->_mono_duration_nsec) {
          diag;
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for with_deadline being canceled halfway through by the parent context
  static method with_deadline_canceled_halfway : int () {
    my $success_ref = [0];
    
    # Run cancellation test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent_derived = Go::Context->background->with_cancel;
        my $ctx_parent = $ctx_parent_derived->context;
        my $cancel_parent = $ctx_parent_derived->cancel_cb;
        
        # Set deadline to 1.0 second from now (plenty of time)
        my $timeout_sec = 1.0;
        my $deadline = Go::Time->now->add_sec($timeout_sec);
        
        my $derived = $ctx_parent->with_deadline($deadline);
        my $ctx = $derived->context;
        
        # Initially, no error should exist
        if ($ctx->err > 0) {
          return;
        }
        
        # Cancel parent halfway through before deadline expires
        $cancel_parent->();
        
        # Child context should be canceled with Canceled error
        unless ($ctx->err == basic_type_id Go::Context::Error::Canceled) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for with_deadline_cause
  static method with_deadline_cause : int () {
    my $success_ref = [0];
    
    # Run deadline cause test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        my $timeout_sec = 0.1;
        my $deadline = Go::Time->now->add_sec($timeout_sec);
        my $cause_msg = "database connection timeout";
        
        my $derived = $ctx_parent->with_deadline_cause($deadline, $cause_msg);
        my $ctx = $derived->context;
        
        # Should not be expired yet
        if ($ctx->err > 0) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for with_timeout (using Go::Duration_1l)
  static method with_timeout : int () {
    my $success_ref = [0];
    
    # Run timeout test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        
        # 0.1 seconds in nanoseconds (100,000,000ns)
        my $timeout_nanos = 100_000_000L;
        my $duration = Go::Duration_1l->new($timeout_nanos);
        
        my $derived = $ctx_parent->with_timeout($duration);
        my $ctx = $derived->context;

        # Should not be expired yet
        if ($ctx->err > 0) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }

  # Test for with_timeout_sec (using double)
  static method with_timeout_sec : int () {
    my $success_ref = [0];
    
    # Run timeout_sec test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $ctx_parent = Go::Context->background;
        
        # Set timeout to 0.1 seconds directly as a double
        my $timeout_sec = 0.1;
        my $derived = $ctx_parent->with_timeout_sec($timeout_sec);
        my $ctx = $derived->context;

        # Should not be expired yet
        if ($ctx->err > 0) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }

  # Test for value inheritance
  static method with_value : int () {
    my $success_ref = [0];
    
    # Run value inheritance test inside a goroutine
    Go->go([$success_ref : int[]] method : void () {
      {
        my $key = "USER_ID";
        my $val = "kimocchan";
        my $ctx_bg = Go::Context->background;
        my $ctx_val = $ctx_bg->with_value($key, $val);

        # Value must be retrievable by key and cast to (string) for eq operator
        unless ($ctx_val->value($key)->(string) eq $val) {
          return;
        }

        # Non-existent key should return undef
        if ($ctx_val->value("NON_EXISTENT")) {
          return;
        }
      }

      {
        my $key_p = "PARENT_KEY";
        my $val_p = "parent_val";
        my $key_c = "CHILD_KEY";
        my $val_c = "child_val";

        # Create parent context with a value
        my $ctx_p = Go::Context->background->with_value($key_p, $val_p);
        
        # Create child context with another value
        my $ctx_c = $ctx_p->with_value($key_c, $val_c);
        
        # Create grandchild context
        my $ctx_gc = $ctx_c->with_value("GC_KEY", "gc_val");

        # Grandchild should see parent value
        unless ((string)$ctx_gc->value($key_p) eq $val_p) {
          return;
        }

        # Grandchild should see child value
        unless ((string)$ctx_gc->value($key_c) eq $val_c) {
          return;
        }

        # Parent should not see child value
        if ($ctx_p->value($key_c)) {
          return;
        }

        # Non-existent key should return undef
        if ($ctx_gc->value("UNKNOWN")) {
          return;
        }
      }
      
      $success_ref->[0] = 1;
    });
    
    Go->gosched;
    
    return $success_ref->[0];
  }
  
}
