class TestCase::Go::Select {
  use Go;
  use Sort;
  
  our $RESULT : IntList;
  
  static method minimal : int () {
    
    $RESULT = IntList->new;
    
    Go->go(method : void () {
      
      my $ch = Go->make;
      
      Go->go([$ch : ] method : void () {
        
        $ch->write(1);
      });
      
      my $select = Go->new_select;
      
      $select->add_read($ch);
      
      my $result = $select->select;
      
      my $value = (int)$result->value;
      
      my $ok = $result->ok;
      
      $RESULT->push($value);
      
    });
    
    Go->gosched;
    
    unless (Array->equals_int($RESULT->to_array, [1])) {
      return 0;
    }
    
    $RESULT = undef;
    
    return 1;
  }
  
  static method blocking : int () {
    
    $RESULT = IntList->new;
    
    Go->go(method : void () {
      
      my $ch0 = Go->make;
      
      my $ch1 = Go->make;
      
      my $ch2 = Go->make;
      
      my $ch3 = Go->make;
      
      Go->go([$ch0 : , $ch1 : , $ch2 : , $ch3 : ] method : void () {
        
        $ch0->write(4);
        
        $ch1->write(3);
        
        $ch2->write(2);
        
        my $ok = 0;
        
        my $value = (int)$ch3->read(\$ok);
        
        $RESULT->push($value);
        
      });
      
      my $select = Go->new_select;
      
      $select->add_read($ch2);
      
      $select->add_read($ch1);
      
      $select->add_read($ch0);
      
      $select->add_write($ch3 => 1);
      
      while (1) {
        my $result = $select->select;
        
        my $ok = $result->ok;
        
        if ($ok) {
          my $ch = $result->channel;
          
          my $is_write = $result->is_write;
          
          if ($is_write) {
            $select->remove_write($ch);
          }
          else {
            my $value = (int)$result->value;
            
            $RESULT->push($value);
            
            $select->remove_read($ch);
          }
        }
        
        if ($select->is_empty) {
          last;
        }
      }
      
    });
    
    Go->gosched;
    
    my $got = $RESULT->to_array;
    
    Sort->sort_int_asc($got);
    
    unless (Array->equals_int($got, [1, 2, 3, 4])) {
      return 0;
    }
    
    $RESULT = undef;
    
    return 1;
  }
  
  static method non_blocking : int () {
    
    $RESULT = IntList->new;
    
    Go->go(method : void () {
      
      my $ch0 = Go->make;
      
      my $ch1 = Go->make;
      
      my $ch2 = Go->make;
      
      my $ch3 = Go->make;
      
      Go->go([$ch0 : , $ch1 : , $ch2 : , $ch3 : ] method : void () {
        
        $ch0->write(1);
        
        $ch1->write(2);
        
        $ch2->write(3);
        
        my $ok = 0;
        
        my $value = (int)$ch3->read(\$ok);
        
        $RESULT->push($value);
        
      });
      
      my $select = Go->new_select;
      
      $select->set_non_blocking(1);
      
      $select->add_read($ch2);
      
      $select->add_read($ch1);
      
      $select->add_read($ch0);
      
      $select->add_write($ch3 => 4);
      
      while (1) {
        my $result = $select->select;
        
        if ($result) {
          my $ok = $result->ok;
          
          if ($ok) {
            my $ch = $result->channel;
            
            my $is_write = $result->is_write;
            
            if ($is_write) {
              $select->remove_write($ch);
            }
            else {
              my $value = (int)$result->value;
              
              $RESULT->push($value);
              
              $select->remove_read($ch);
            }
          }
          
          if ($select->is_empty) {
            last;
          }
        }
        else {
          warn "[Test Output]Non-blocking select returns undef";
          Go->gosched;
        }
      }
      
    });
    
    
    Go->gosched;
    
    my $got = $RESULT->to_array;
    
    Sort->sort_int_asc($got);
    
    unless (Array->equals_int($got, [1, 2, 3, 4])) {
      return 0;
    }
    
    $RESULT = undef;
    
    return 1;
  }
  
  static method select_closed_channel : int () {
    
    $RESULT = IntList->new;
    
    Go->go(method : void () {
      
      my $ch0 = Go->make;
      
      my $select = Go->new_select;
      
      $select->add_read($ch0);
      
      $ch0->close;
      
      my $result = $select->select;
      
      if ($result && $result->value == undef) {
        $RESULT->push(1);
      }
      else {
        $RESULT->push(0);
      }
    });
    
    Go->gosched;
    
    my $got = $RESULT->to_array;
    
    unless (Array->equals_int($got, [1])) {
      return 0;
    }
    
    $RESULT = undef;
    
    return 1;
  }
  
}
