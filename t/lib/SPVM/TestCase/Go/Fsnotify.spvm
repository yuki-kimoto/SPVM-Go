class TestCase::Go::Fsnotify {
  
  use Go;
  use Go::Fsnotify;
  use Go::Sync::WaitGroup;
  use Fn;
  use Sys;
  use Sys::IO::FileStream;
  
  static method basic : int ($temp_dir : string) {
    
    my $success_ref = [1];
    
    # Basic
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : , $temp_dir : ] method : void () {
        
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $watcher = Go::Fsnotify->new;
        
        $watcher->add($temp_dir);
        
        my $target_file = "$temp_dir/test_fs_event.txt";
        
        Go::Timer->sleep_sec(0.5); # For mac FSEvents warm up
        Sys->open(my $_ = [(Sys::IO::FileStream)undef], "w", $target_file);
        my $fh = $_->[0];
        Sys->close($fh);
        
        my $events_ch = $watcher->events;
        
        my $event = (Go::Fsnotify::Event)$events_ch->read;
        
        unless ($event) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $event_name = $event->name;
        diag "[Test Output]\$event_name:$event_name.";
        unless ($event_name) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $event_op = $event->op;
        diag "[Test Output]\$event_op:$event_op.";
        if ($event_op == 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      
      $wg->wait;
    }
    
    my $dir1 = "$temp_dir/dir1";
    my $dir2 = "$temp_dir/dir2";
    Sys->mkdir($dir1, 0777);
    Sys->mkdir($dir2, 0777);
    
    # Add two dirs. Add file to dir1
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : , $temp_dir : , $dir1 : , $dir2 : ,] method : void () {
        
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $watcher = Go::Fsnotify->new;
        
        $watcher->add($dir1);
        $watcher->add($dir2);
        
        my $target_file = "$dir1/test_dir1.txt";
        
        Go::Timer->sleep_sec(0.5); # For mac FSEvents warm up
        Sys->open(my $_ = [(Sys::IO::FileStream)undef], "w", $target_file);
        my $fh = $_->[0];
        Sys->close($fh);
        
        my $events_ch = $watcher->events;
        
        my $event = (Go::Fsnotify::Event)$events_ch->read;
        
        unless ($event) {
          diag;
          $success_ref->[0] = 0;
        }
        
        unless ($event->name) {
          diag;
          $success_ref->[0] = 0;
        }
        
        if ($event->op == 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      
      $wg->wait;
    }
    
    # Add two dirs. Add file to dir2
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : , $temp_dir :,  $dir1 : , $dir2 : ,] method : void () {
        
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $watcher = Go::Fsnotify->new;
        
        $watcher->add($dir1);
        $watcher->add($dir2);
        
        my $target_file = "$dir2/test_dir2.txt";
        
        Go::Timer->sleep_sec(0.5); # For mac FSEvents warm up
        Sys->open(my $_ = [(Sys::IO::FileStream)undef], "w", $target_file);
        my $fh = $_->[0];
        Sys->close($fh);
        
        my $events_ch = $watcher->events;
        
        my $event = (Go::Fsnotify::Event)$events_ch->read;
        
        unless ($event) {
          diag;
          $success_ref->[0] = 0;
        }
        
        unless ($event->name) {
          diag;
          $success_ref->[0] = 0;
        }
        
        if ($event->op == 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      
      $wg->wait;
    }
    
    return $success_ref->[0];
  }

}
