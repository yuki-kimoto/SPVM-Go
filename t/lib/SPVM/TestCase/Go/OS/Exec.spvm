class TestCase::Go::OS::Exec {
  use Go::OS::Exec;
  
  use Go;
  use Go::OS::Exec;
  use Go::OS::Exec::Cmd;
  use Go::Sync::WaitGroup;
  
  static method basic : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $cmd = Go::OS::Exec->command(["perl", "-e", "print 'Hello';"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($exit_code == 0) {
        diag "\$exit_code=$exit_code";
        $success_ref->[0] = 0;
      }
      
      unless ($term_signal == 0) {
        diag "\$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method context_deadline : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $_ = Go::Context->with_timeout_sec(Go::Context->background, 0.5);
      my $ctx = $_->ctx;
      
      my $cmd = Go::OS::Exec->command_context($ctx, ["perl", "-e", "while(1){}"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method context_done : int () {
  
    my $success_ref = [1];
  
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    Go->go([$wg : , $success_ref : ] method : void () {
    
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
    
      my $_ = Go::Context->with_cancel(Go::Context->background);
      my $ctx = $_->ctx;
      my $cancel = $_->cancel;
    
      Go->go([$cancel : ] method : void () {
        Go->sleep_sec(0.5);
        $cancel->();
      });
    
      my $cmd = Go::OS::Exec->command_context($ctx, ["perl", "-e", "while(1){}"]);
    
      my $status = $cmd->run;
    
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
    
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
  
    $wg->wait;
  
    return $success_ref->[0];
  }
  
}
