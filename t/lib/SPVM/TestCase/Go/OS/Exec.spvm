class TestCase::Go::OS::Exec {
  use Go::OS::Exec;
  
  use Go;
  use Go::OS::Exec;
  use Go::OS::Exec::Cmd;
  use Go::Sync::WaitGroup;
  
  static method basic : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $cmd = Go->new_command(Go->bg, ["perl", "-e", "print 'Hello';"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($exit_code == 0) {
        diag "\$exit_code=$exit_code";
        $success_ref->[0] = 0;
      }
      
      unless ($term_signal == 0) {
        diag "\$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method context_done : int () {
  
    my $success_ref = [1];
  
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
    
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
    
      my $_ = Go::Context->with_cancel(Go::Context->background);
      my $context = $_->context;
      my $cancel_cb = $_->cancel_cb;
    
      Go->go([$cancel_cb : ] method : void () {
        Go->sleep_sec(0.5);
        $cancel_cb->();
      });
    
      my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
    
      my $status = $cmd->run;
    
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
    
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
  
    $wg->wait;
  
    return $success_ref->[0];
  }
  
  static method context_deadline : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $_ = Go::Context->with_timeout_sec(Go::Context->background, 0.5);
      my $context = $_->context;
      
      my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }

  static method context_extra : int () {
    
    my $success_ref = [1];
    
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 10.0);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-v"]);
        my $status = $cmd->run;
        
        my $exit_code = $status >> 8;
        my $term_signal = $status & 0xff;
        
        unless ($exit_code == 0 && $term_signal == 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }

    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 0.2);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
        my $status = $cmd->run;
        
        my $term_signal = $status & 0xff;
        
        unless ($term_signal > 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }
    
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 10.0);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
        
        Go->go([$cancel_cb : ] method : void () {
          Go->sleep_sec(0.5);
          $cancel_cb->();
        });
        
        my $status = $cmd->run;
        
        my $term_signal = $status & 0xff;
        
        unless ($term_signal > 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }

    return $success_ref->[0];
  }

  static method stdout : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $read_fd = -1;
      my $write_fd = -1;
      Sys->pipepair(\$read_fd, \$write_fd, 1);
      
      my $stdout = Go::OS::File->new_pipe_end($write_fd);
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "print 'out:hello';"]);
      $cmd->set_stdout($stdout);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = Go->gosched_pipe_read(Go->bg, $read_fd, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 9 && Fn->substr($buf, 0, $len) eq "out:hello") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method stderr : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $read_fd = -1;
      my $write_fd = -1;
      Sys->pipepair(\$read_fd, \$write_fd, 1);
      
      Fn->defer([$read_fd : int] method : void () {
        Sys::IO->close($read_fd);
      });
      
      my $stderr = Go::OS::File->new_pipe_end($write_fd);
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "print STDERR 'err:hello';"]);
      $cmd->set_stderr($stderr);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = Go->gosched_pipe_read(Go->bg, $read_fd, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 9 && Fn->substr($buf, 0, $len) eq "err:hello") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method extra_files : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $read_fd = -1;
      my $write_fd = -1;
      Sys->pipepair(\$read_fd, \$write_fd, 1);
      
      Fn->defer([$read_fd : int] method : void () {
        Sys::IO->close($read_fd);
      });
      
      # Extra FDs start at stdio index 3 (fd 3)
      my $extra_fd = Go::OS::File->new_pipe_end($write_fd);
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "open(my \$fh, '>&=', 3) or die \$!; print \$fh 'extra:hello'; close(\$fh);"]);
      $cmd->set_extra_files([$extra_fd]);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = Go->gosched_pipe_read(Go->bg, $read_fd, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 11 && Fn->substr($buf, 0, $len) eq "extra:hello") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method env : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $read_fd = -1;
      my $write_fd = -1;
      Sys->pipepair(\$read_fd, \$write_fd, 1);
      
      Fn->defer([$read_fd : int] method : void () {
        Sys::IO->close($read_fd);
      });
      
      my $stdout = Go::OS::File->new_pipe_end($write_fd);
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "print \$ENV{'TEST_EXEC_ENV'};"]);
      $cmd->set_stdout($stdout);
      $cmd->set_env(["TEST_EXEC_ENV=hello_env"]);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = Go->gosched_pipe_read(Go->bg, $read_fd, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 9 && Fn->substr($buf, 0, $len) eq "hello_env") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
}
