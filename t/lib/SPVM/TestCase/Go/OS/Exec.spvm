class TestCase::Go::OS::Exec {
  use Go::OS::Exec;
  
  use Go;
  use Go::OS::Exec;
  use Go::OS::Exec::Cmd;
  use Go::Sync::WaitGroup;
  
  static method basic : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $cmd = Go->new_command(Go->bg, ["perl", "-e", "print 'Hello';"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($exit_code == 0) {
        diag "\$exit_code=$exit_code";
        $success_ref->[0] = 0;
      }
      
      unless ($term_signal == 0) {
        diag "\$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method context_done : int () {
  
    my $success_ref = [1];
  
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
    
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
    
      my $_ = Go::Context->with_cancel(Go::Context->background);
      my $context = $_->context;
      my $cancel_cb = $_->cancel_cb;
    
      Go->go([$cancel_cb : ] method : void () {
        Go->sleep_sec(0.5);
        $cancel_cb->();
      });
    
      my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
    
      my $status = $cmd->run;
    
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
    
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
  
    $wg->wait;
  
    return $success_ref->[0];
  }
  
  static method context_deadline : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $_ = Go::Context->with_timeout_sec(Go::Context->background, 0.5);
      my $context = $_->context;
      
      my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
      
      my $status = $cmd->run;
      
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      unless ($term_signal > 0) {
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }

  static method context_extra : int () {
    
    my $success_ref = [1];
    
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 10.0);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-v"]);
        my $status = $cmd->run;
        
        my $exit_code = $status >> 8;
        my $term_signal = $status & 0xff;
        
        unless ($exit_code == 0 && $term_signal == 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }

    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 0.2);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
        my $status = $cmd->run;
        
        my $term_signal = $status & 0xff;
        
        unless ($term_signal > 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }
    
    {
      my $wg = Go->new_wait_group(1);
      Go->go([$wg : , $success_ref : ] method : void () {
        Fn->defer([$wg : ] method : void () {
          $wg->done;
        });
        
        my $_ = Go::Context->with_timeout_sec(Go::Context->background, 10.0);
        my $context = $_->context;
        my $cancel_cb = $_->cancel_cb;
        
        my $cmd = Go::OS::Exec->command($context, ["perl", "-e", "while(1){}"]);
        
        Go->go([$cancel_cb : ] method : void () {
          Go->sleep_sec(0.5);
          $cancel_cb->();
        });
        
        my $status = $cmd->run;
        
        my $term_signal = $status & 0xff;
        
        unless ($term_signal > 0) {
          diag;
          $success_ref->[0] = 0;
        }
      });
      $wg->wait;
    }

    return $success_ref->[0];
  }

  static method stdout : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $stdout = Go::OS::File->prepare_pipe_end;
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "print 'out:hello';"]);
      $cmd->set_stdout($stdout);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = $stdout->sysread(Go->bg, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 9 && Fn->substr($buf, 0, $len) eq "out:hello") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
