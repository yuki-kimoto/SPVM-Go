  static method extra_files : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      # Extra FDs start at stdio index 3 (fd 3)
      my $extra_file = Go::OS::File->prepare_pipe_end;
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "open(my \$fh, '>&=', 3) or die \$!; print \$fh 'extra:hello'; close(\$fh);"]);
      $cmd->set_extra_files([$extra_file]);
      
      my $status = $cmd->run;
      my $exit_code = $status >> 8;
      my $term_signal = $status & 0xff;
      
      my $buf = new_string_len 4096;
      my $len = $extra_file->sysread(Go->bg, $buf);
      
      unless ($exit_code == 0 && $term_signal == 0) {
        diag "\$exit_code=$exit_code, \$term_signal=$term_signal";
        $success_ref->[0] = 0;
      }
      
      unless ($len == 11 && Fn->substr($buf, 0, $len) eq "extra:hello") {
        diag "\$len=$len, \$buf=$buf";
        $success_ref->[0] = 0;
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method env : int () {
    
    my $success_ref = [1];
    
    my $wg = Go->new_wait_group(1);
    Go->go([$wg : , $success_ref : ] method : void () {
      
      Fn->defer([$wg : ] method : void () {
        $wg->done;
      });
      
      my $stdout = Go::OS::File->prepare_pipe_end;
      
      my $cmd = Go::OS::Exec->command(Go->bg, ["perl", "-e", "print \$ENV{'TEST_EXEC_ENV'};"]);
      $cmd->set_stdout($stdout);
